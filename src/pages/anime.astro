    padding: 1rem 1.25rem 0.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    border-bottom: 1px solid var(--sl-color-gray-6);
  }

  .bangumi-search {
    position: relative;
    width: 100%;
    max-width: 28rem;
  }

  .bangumi-search-icon {
    position: absolute;
    left: 0.85rem;
    top: 50%;
    transform: translateY(-50%);
    color: var(--sl-color-gray-4);
    pointer-events: none;
  }

  .bangumi-search input {
    width: 100%;
    padding: 0.5rem 1rem 0.5rem 2.3rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 999px;
    background: transparent;
    color: var(--sl-color-white);
    font-size: 0.88rem;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .bangumi-search input:focus {
    outline: none;
    border-color: var(--sl-color-accent);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--sl-color-accent) 18%, transparent);
  }

  .bangumi-filterbar {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    flex-wrap: wrap;
  }

  .bangumi-filterbar-group {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .bangumi-filterbar-label {
    font-size: 0.78rem;
    color: var(--sl-color-gray-4);
  }

  .bangumi-filterbar-options {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    flex-wrap: wrap;
  }

  .bangumi-filterbar-divider {
    width: 1px;
    height: 1rem;
    background: var(--sl-color-gray-6);
  }

