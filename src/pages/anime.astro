---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import LilyOrnament from '../components/LilyOrnament.astro';
import Floral from '../components/Floral.astro';
import { MEDIA_SUBJECT_TYPE, MEDIA_LABEL, STATUS_LABEL } from '../utils/bangumi';
---

<StarlightPage
  frontmatter={{
    title: '鉴赏 · Review',
    description: '在 Bangumi 上记录的动画、游戏、音乐与书籍鉴赏档案，以及时间胶囊动态。',
    template: 'splash',
    tableOfContents: false,
  }}
  hasSidebar={false}
>
  <div class="bangumi-page not-content">
    <div class="bangumi-shell">
      <!-- 头部 Bangumi 专属概览与个人资料卡片 -->
      <header class="bangumi-surface bangumi-hero-card">
        <div class="bangumi-hero-decor" aria-hidden="true">
          <LilyOrnament id="anime-lily" />
        </div>
        <div class="bangumi-hero-content">
          <div class="bangumi-eyebrow">
            <span class="bangumi-eyebrow-dot" aria-hidden="true"></span>
            <span class="bangumi-eyebrow-text">REVIEW · BANGUMI ARCHIVE</span>
          </div>

          <div class="bangumi-hero-inner">
            <div class="bangumi-user-profile">
              <a
                href="https://bgm.tv/user/duskydream"
                target="_blank"
                rel="noopener noreferrer"
                class="bangumi-user-avatar"
                title="前往 Lxzm 的 Bangumi 主页"
              >
                <img
                  src="https://lain.bgm.tv/pic/user/l/000/85/16/851657_upVeN.jpg?r=1781703517&hd=1"
                  alt="Lxzm (duskydream)"
                  width="64"
                  height="64"
                  loading="eager"
                />
              </a>
              <div class="bangumi-user-info">
                <div class="bangumi-user-names">
                  <h1 class="bangumi-user-name">Lxzm</h1>
                  <span class="bangumi-user-handle">@duskydream</span>
                  <span class="bangumi-user-badge">Bangumi 番组计划</span>
                </div>
                <p class="bangumi-user-sign">“Everything that rises must converge”</p>
                <p id="bangumi-stats" class="bangumi-stats" aria-live="polite">正在同步档案统计…</p>
              </div>
            </div>

            <div class="bangumi-hero-actions">
              <a
                href="https://bgm.tv/user/duskydream"
                target="_blank"
                rel="noopener noreferrer"
                class="home-quick-pill"
              >
                <Floral variant="bloom" size="0.82em" />
                <span>Bangumi 主页</span>
              </a>
            </div>
          </div>

          <!-- 自我介绍 (Bio Panel) -->
          <div class="bangumi-user-intro-panel">
            <div class="bangumi-user-intro-header">
              <Floral variant="bud" size="0.85em" class="bangumi-user-intro-icon" />
              <span class="bangumi-user-intro-title">自我介绍</span>
            </div>
            <div class="bangumi-user-intro-content">
              <p>杉菜水姫、松本文纪、深泽秀行、MANYO</p>
              <p>永久眷恋着天国的音乐妖精</p>
              <p>Innocent Grey、貴方へ捧ぐ戀紅色の花</p>
              <p>直观&gt;印象&gt;分析、随缘百合</p>
              <p>关于如何对抗遗忘</p>
            </div>
          </div>
        </div>
      </header>

      <!-- 双栏卡片布局：左侧鉴赏收藏，右侧时间胶囊 -->
      <div class="bangumi-layout">
        <!-- 主栏：鉴赏收藏 -->
        <main class="bangumi-main-section">
          <section class="bangumi-surface bangumi-collections-card">
            <div class="bangumi-surface-head">
              <div class="bangumi-surface-head-left">
                <span class="bangumi-head-dot" aria-hidden="true"></span>
                <span class="bangumi-head-en">COLLECTIONS</span>
                <span class="bangumi-surface-title">鉴赏收藏</span>
              </div>
              <div id="bangumi-meta" class="bangumi-meta-badge" aria-live="polite"></div>
            </div>

            <div class="bangumi-toolbar-inner">
              <div class="bangumi-search">
                <svg class="bangumi-search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
                <input
                  type="text"
                  id="bangumi-search"
                  aria-label="搜索动画、游戏、音乐或书籍"
                  placeholder="搜索动画、游戏、音乐或书籍..."
                  autocomplete="off"
                />
              </div>

              <div class="bangumi-filterbar">
                <div class="bangumi-filterbar-group">
                  <span class="bangumi-filterbar-label">类型</span>
                  <div class="bangumi-filterbar-options">
                    <button type="button" data-media="anime" class="bangumi-chip is-active">动画 <span class="bangumi-chip-count"></span></button>
                    <button type="button" data-media="game" class="bangumi-chip">游戏 <span class="bangumi-chip-count"></span></button>
                    <button type="button" data-media="music" class="bangumi-chip">音乐 <span class="bangumi-chip-count"></span></button>
                    <button type="button" data-media="book" class="bangumi-chip">书籍 <span class="bangumi-chip-count"></span></button>
                  </div>
                </div>

                <span class="bangumi-filterbar-divider" aria-hidden="true"></span>

                <div class="bangumi-filterbar-group bangumi-filterbar-group-status">
                  <span class="bangumi-filterbar-label">状态</span>
                  <div class="bangumi-filterbar-options bangumi-filterbar-options-status">
                    <button type="button" data-status="watched" class="bangumi-pill is-active">已完成 <span class="bangumi-pill-count"></span></button>
                    <button type="button" data-status="watching" class="bangumi-pill">进行中 <span class="bangumi-pill-count"></span></button>
                    <button type="button" data-status="wish" class="bangumi-pill">待补完 <span class="bangumi-pill-count"></span></button>
                  </div>
                </div>

                <div class="bangumi-filterbar-group bangumi-filterbar-group-toggle">
                  <button type="button" id="bangumi-reviewed-toggle" class="bangumi-toggle-chip" aria-pressed="false">
                    <span class="bangumi-toggle-dot" aria-hidden="true"></span>
                    <span>仅看短评</span> <span class="bangumi-toggle-count"></span>
                  </button>
                </div>
              </div>
            </div>

            <div class="bangumi-surface-body">
              {/* 结果区标题：筛选状态由 URL query 决定（?media=&status=&q=&reviewed=1），所以标题是动态的。
                  视觉上筛选栏已经表达了同样的信息，这里只给读屏用户一个语义锚点，
                  同时补上 h1 -> h3 缺失的 h2 层级。 */}
              <h2 id="bangumi-results-heading" class="bangumi-results-heading" aria-live="polite">条目列表</h2>
              <div id="bangumi-grid" class="bangumi-grid" aria-busy="false">
                <div class="bangumi-message is-pulse">加载中...</div>
              </div>
            </div>
          </section>
        </main>

        <!-- 侧栏：Bangumi 时间胶囊 -->
        <aside class="bangumi-aside-section">
          <section class="bangumi-surface bangumi-timeline-card">
            <div class="bangumi-surface-head">
              <div class="bangumi-surface-head-left">
                <span class="bangumi-head-dot" aria-hidden="true"></span>
                <span class="bangumi-head-en">TIME CAPSULE</span>
                <span class="bangumi-surface-title">时间胶囊</span>
              </div>
              <a
                href="https://bgm.tv/feed/user/duskydream/timeline"
                target="_blank"
                rel="noopener noreferrer"
                class="bangumi-timeline-rss-btn"
                title="订阅时间胶囊 RSS"
              >
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 11a9 9 0 0 1 9 9"/><path d="M4 4a16 16 0 0 1 16 16"/><circle cx="5" cy="19" r="1"/></svg>
                <span>RSS</span>
              </a>
            </div>

            <div class="bangumi-surface-body bangumi-timeline-scroll">
              <div id="bangumi-timeline" class="bangumi-timeline" data-floral-vine='{"items": ".bangumi-timeline-item", "current": "", "vineX": 10, "meander": 2.5}'>
                <div class="bangumi-message is-pulse" style="padding: 1.5rem 0.5rem;">加载动态...</div>
              </div>
            </div>
          </section>
        </aside>
      </div>
    </div>
  </div>

  <script is:inline define:vars={{ MEDIA_SUBJECT_TYPE, MEDIA_LABEL, STATUS_LABEL }} data-astro-rerun>
    (function initBangumiPage() {
    const API = '/bangumi';
    const STATIC_FALLBACK = '/data/bangumi.json';
    const CACHE_KEY = 'bangumi_cache_v3';
    const CLIENT_TTL = 30 * 60 * 1000;
    // MEDIA_SUBJECT_TYPE / MEDIA_LABEL / STATUS_LABEL 由 define:vars 从
    // src/utils/bangumi.ts 注入，不再在这里重写一份。

    const state = {
      mediaType: 'anime',
      status: 'watched',
      onlyReviewed: false,
      data: { watching: [], wish: [], watched: [], timeline: [] },
      expanded: null,
      isFetching: false,
      fetchAbortController: null,
    };

    const search = document.getElementById('bangumi-search');
    const gridArea = document.getElementById('bangumi-grid');
    const timelineArea = document.getElementById('bangumi-timeline');
    const resultsMeta = document.getElementById('bangumi-meta');
    const statsEl = document.getElementById('bangumi-stats');
    const reviewedToggle = document.getElementById('bangumi-reviewed-toggle');
    const mediaButtons = [...document.querySelectorAll('.bangumi-chip')];
    const statusButtons = [...document.querySelectorAll('.bangumi-pill')];
    let searchTimer;

    if (!search || !gridArea || !resultsMeta) return;

    const HTML_ENTITIES = {
      amp: '&',
      lt: '<',
      gt: '>',
      quot: '"',
      apos: "'",
      nbsp: ' ',
    };

    function decodeHtmlEntities(value) {
      if (value == null) return '';
      return String(value).replace(/&(#x?[0-9a-fA-F]+|[a-zA-Z]+);/g, (match, entity) => {
        if (entity[0] === '#') {
          const isHex = entity[1] === 'x' || entity[1] === 'X';
          const codePoint = Number.parseInt(entity.slice(isHex ? 2 : 1), isHex ? 16 : 10);
          if (!Number.isFinite(codePoint) || codePoint <= 0 || codePoint > 0x10ffff) return match;
          return String.fromCodePoint(codePoint);
        }
        const key = entity.toLowerCase();
        return Object.prototype.hasOwnProperty.call(HTML_ENTITIES, key) ? HTML_ENTITIES[key] : match;
      });
    }

    function escapeHTML(value) {
      return String(value)
        .replaceAll('&', '&amp;')
        .replaceAll('<', '&lt;')
        .replaceAll('>', '&gt;')
        .replaceAll('"', '&quot;')
        .replaceAll("'", '&#39;');
    }

    function cleanSummaryPreview(summary) {
      return String(summary || '')
        .replace(/\r\n?/g, '\n')
        .replace(/^[￣―─—\-=_*~·•\s]{4,}$/gm, '')
        .replace(/\n+/g, ' ')
        .replace(/\s{2,}/g, ' ')
        .trim();
    }

    function safeImageURL(value) {
      try {
        const url = new URL(String(value), window.location.origin);
        return url.protocol === 'https:' ? escapeHTML(url.href) : '';
      } catch {
        return '';
      }
    }

    function readQueryState() {
      try {
        const params = new URLSearchParams(window.location.search);
        const media = params.get('media');
        const status = params.get('status');
        const q = params.get('q');
        const reviewed = params.get('reviewed');
        if (media && Object.prototype.hasOwnProperty.call(MEDIA_SUBJECT_TYPE, media)) {
          state.mediaType = media;
        }
        if (status && Object.prototype.hasOwnProperty.call(STATUS_LABEL, status)) {
          state.status = status;
        }
        if (typeof q === 'string' && q.trim()) {
          search.value = q.trim();
        }
        state.onlyReviewed = reviewed === '1';
      } catch { /* ignore */ }
    }

    function writeQueryState() {
      try {
        const url = new URL(window.location.href);
        if (state.mediaType !== 'anime') url.searchParams.set('media', state.mediaType);
        else url.searchParams.delete('media');

        if (state.status !== 'watched') url.searchParams.set('status', state.status);
        else url.searchParams.delete('status');

        const q = search.value.trim();
        if (q) url.searchParams.set('q', q);
        else url.searchParams.delete('q');

        if (state.onlyReviewed) url.searchParams.set('reviewed', '1');
        else url.searchParams.delete('reviewed');

        const nextUrl = url.pathname + url.search + url.hash;
        const currUrl = window.location.pathname + window.location.search + window.location.hash;
        if (nextUrl !== currUrl) {
          window.history.replaceState(window.history.state, '', nextUrl);
        }
      } catch { /* ignore */ }
    }

    function readCache(allowStale = false) {
      try {
        const raw = localStorage.getItem(CACHE_KEY);
        if (!raw) return null;
        const parsed = JSON.parse(raw);
        if (!parsed || typeof parsed !== 'object') return null;
        const isFresh = Boolean(parsed.__cachedAt && Date.now() - parsed.__cachedAt < CLIENT_TTL);
        if (isFresh || allowStale) {
          return {
            watching: parsed.watching || [],
            wish: parsed.wish || [],
            watched: parsed.watched || [],
            timeline: parsed.timeline || [],
          };
        }
      } catch { /* ignore */ }
      return null;
    }

    function saveCache(payload) {
      try {
        localStorage.setItem(CACHE_KEY, JSON.stringify({ ...payload, __cachedAt: Date.now() }));
      } catch { /* ignore */ }
    }

    function normalizePayload(payload) {
      return {
        watching: Array.isArray(payload?.watching) ? payload.watching : [],
        wish: Array.isArray(payload?.wish) ? payload.wish : [],
        watched: Array.isArray(payload?.watched) ? payload.watched : [],
        timeline: Array.isArray(payload?.timeline) ? payload.timeline : [],
      };
    }

    function mergeSummaries(target, reference) {
      if (!target || !reference) return target;
      const summaryMap = new Map();
      for (const key of ['watching', 'wish', 'watched']) {
        const list = reference[key];
        if (!Array.isArray(list)) continue;
        for (const item of list) {
          const id = Number(item?.subject_id || item?.subject?.id || 0);
          const summary = item?.subject?.summary;
          if (id && summary) summaryMap.set(id, summary);
        }
      }
      if (summaryMap.size === 0) return target;
      for (const key of ['watching', 'wish', 'watched']) {
        const list = target[key];
        if (!Array.isArray(list)) continue;
        for (const item of list) {
          const id = Number(item?.subject_id || item?.subject?.id || 0);
          if (id && item?.subject && !item.subject.summary && summaryMap.has(id)) {
            item.subject.summary = summaryMap.get(id);
          }
        }
      }
      return target;
    }

    function hasBangumiItems(payload) {
      return payload.watching.length > 0 || payload.wish.length > 0 || payload.watched.length > 0 || payload.timeline.length > 0;
    }

    function renderMessage(message, tone, pulse) {
      gridArea.innerHTML = '<div class="bangumi-message' + (tone === 'error' ? ' is-error' : '') + (pulse ? ' is-pulse' : '') + '">' + escapeHTML(message) + '</div>';
    }

    function setFetching(isFetching) {
      gridArea.setAttribute('aria-busy', String(isFetching));
      gridArea.dataset.fetching = String(isFetching);
    }

    async function requestJSON(url, signal, force = false) {
      const response = await fetch(url, { cache: force ? 'no-store' : 'default', signal });
      if (!response.ok) throw new Error('Request failed: ' + response.status);
      return response.json();
    }

    async function fetchData(force) {
      if (state.isFetching) return null;

      if (!force) {
        const cached = readCache(false);
        if (cached) {
          state.data = cached;
          render();
          return cached;
        }
      }

      state.isFetching = true;
      state.fetchAbortController = new AbortController();
      setFetching(true);

      try {
        const query = API + (force ? '?force=true' : '');
        let payload = normalizePayload(await requestJSON(query, state.fetchAbortController.signal, force));
        if (!hasBangumiItems(payload)) throw new Error('Empty Bangumi payload');

        mergeSummaries(payload, state.data);

        // 如果 API 返回的 timeline 为空或缺少预构建完整简介，尝试从静态 fallback 中补充
        const needsFallbackEnrich = !payload.timeline.length || !hasBangumiItems(state.data);
        if (needsFallbackEnrich) {
          try {
            const fallbackPayload = normalizePayload(await requestJSON(STATIC_FALLBACK, state.fetchAbortController.signal));
            mergeSummaries(payload, fallbackPayload);
            if (!payload.timeline.length && fallbackPayload.timeline.length) {
              payload.timeline = fallbackPayload.timeline;
            }
          } catch { /* ignore fallback error */ }
        }

        state.data = payload;
        saveCache(state.data);
        render();
        return state.data;
      } catch (primaryError) {
        if (primaryError.name === 'AbortError') return null;
        try {
          const payload = normalizePayload(await requestJSON(STATIC_FALLBACK, state.fetchAbortController.signal, force));
          if (!hasBangumiItems(payload)) throw new Error('Empty Bangumi fallback payload');
          state.data = payload;
          saveCache(state.data);
          render();
          return state.data;
        } catch (fallbackError) {
          if (fallbackError.name === 'AbortError') return null;
          if (!state.data.watching.length && !state.data.wish.length && !state.data.watched.length) {
            renderMessage('无法加载数据，请检查网络连接后刷新页面', 'error');
          }
          return null;
        }
      } finally {
        state.isFetching = false;
        state.fetchAbortController = null;
        setFetching(false);
      }
    }

    function getSupportedItems(list) {
      const supported = new Set(Object.values(MEDIA_SUBJECT_TYPE));
      return Array.isArray(list) ? list.filter(item => supported.has(item?.subject?.type)) : [];
    }

    function updateStats() {
      if (!statsEl) return;
      if (!hasBangumiItems(state.data)) {
        statsEl.textContent = '正在同步档案统计…';
        return;
      }
      const watched = getSupportedItems(state.data.watched);
      const watching = getSupportedItems(state.data.watching);
      const wish = getSupportedItems(state.data.wish);
      const total = watched.length + watching.length + wish.length;
      const reviewed = [...watched, ...watching, ...wish].filter(item => Boolean(decodeHtmlEntities(item.comment || '').trim())).length;
      statsEl.textContent =
        '共 ' + total + ' 项 · 已完成 ' + watched.length +
        ' · 进行中 ' + watching.length +
        ' · 待补完 ' + wish.length +
        ' · 短评 ' + reviewed;
    }

    function updateFilterCounts() {
      const loaded = hasBangumiItems(state.data);
      const statusKeys = ['watched', 'watching', 'wish'];

      mediaButtons.forEach((button) => {
        const countEl = button.querySelector('.bangumi-chip-count');
        if (!countEl) return;
        if (!loaded) {
          countEl.textContent = '';
          return;
        }
        const typeFilter = MEDIA_SUBJECT_TYPE[button.dataset.media];
        let count = 0;
        for (const key of statusKeys) {
          const list = state.data[key] || [];
          for (const item of list) {
            if (item?.subject?.type === typeFilter) count++;
          }
        }
        countEl.textContent = String(count);
      });

      const activeType = MEDIA_SUBJECT_TYPE[state.mediaType];
      statusButtons.forEach((button) => {
        const countEl = button.querySelector('.bangumi-pill-count');
        if (!countEl) return;
        if (!loaded) {
          countEl.textContent = '';
          return;
        }
        const list = state.data[button.dataset.status] || [];
        const count = list.filter(item => item?.subject?.type === activeType).length;
        countEl.textContent = String(count);
      });

      if (reviewedToggle) {
        const countEl = reviewedToggle.querySelector('.bangumi-toggle-count');
        const activeSlice = (state.data[state.status] || []).filter(item => item?.subject?.type === activeType);
        const reviewedCount = activeSlice.filter(item => Boolean(decodeHtmlEntities(item.comment || '').trim())).length;
        if (countEl) {
          countEl.textContent = loaded ? String(reviewedCount) : '';
        }
        if (loaded && reviewedCount === 0 && state.onlyReviewed) {
          state.onlyReviewed = false;
          writeQueryState();
        }
        const isDisabled = loaded && reviewedCount === 0;
        reviewedToggle.disabled = isDisabled;
        reviewedToggle.classList.toggle('is-disabled', isDisabled);
        reviewedToggle.classList.toggle('is-active', state.onlyReviewed);
        reviewedToggle.setAttribute('aria-pressed', String(state.onlyReviewed));
      }
    }

    function getFilteredList() {
      const source = state.data[state.status] || [];
      const typeFilter = MEDIA_SUBJECT_TYPE[state.mediaType];
      const keyword = search.value.toLowerCase().trim();

      return source
        .filter(item => item.subject?.type === typeFilter)
        .filter((item) => {
          if (state.onlyReviewed && !decodeHtmlEntities(item.comment || '').trim()) {
            return false;
          }
          if (!keyword) return true;
          const cn = decodeHtmlEntities(item.subject?.name_cn || '').toLowerCase();
          const orig = decodeHtmlEntities(item.subject?.name || '').toLowerCase();
          return cn.includes(keyword) || orig.includes(keyword);
        });
    }

    function updateResultsMeta(total) {
      const keyword = search.value.trim();
      const reviewedPart = state.onlyReviewed ? ' · 仅短评' : '';
      const base = MEDIA_LABEL[state.mediaType] + ' · ' + STATUS_LABEL[state.status] + reviewedPart + ' · ' + total + ' 项';
      resultsMeta.textContent = keyword ? base + ' · 关键词「' + keyword + '」' : base;
      // 同步给 h2 标题：卡片是 h3，需要有 h2 兜住层级，筛选变化时也跟着播报。
      const heading = document.getElementById('bangumi-results-heading');
      if (heading && heading.textContent !== resultsMeta.textContent) {
        heading.textContent = resultsMeta.textContent;
      }
    }

    function getEmptyMessage() {
      if (search.value.trim()) return '没有找到匹配的内容';
      if (state.onlyReviewed) return '当前分类下还没有撰写短评的' + MEDIA_LABEL[state.mediaType] + '条目';
      return '当前分类下还没有' + MEDIA_LABEL[state.mediaType] + '条目';
    }

    function renderStars(score) {
      const value = Number(score);
      if (!Number.isFinite(value) || value <= 0) return '';
      const filled = Math.max(0, Math.min(5, Math.round(value / 2)));
      let stars = '';
      for (let i = 0; i < 5; i++) {
        stars += '<span class="bangumi-star' + (i < filled ? ' is-filled' : '') + '" aria-hidden="true">✦</span>';
      }
      return '<span class="bangumi-score" aria-label="个人评分 ' + escapeHTML(value.toFixed(1)) + '">' +
        stars +
        '<span class="bangumi-score-value">' + escapeHTML(value.toFixed(1)) + '</span>' +
        '</span>';
    }

    function renderTags(tags) {
      const valid = Array.isArray(tags) ? tags.filter(tag => tag && tag.name && String(tag.name).trim()) : [];
      if (!valid.length) return '';
      const list = valid.slice(0, 4);
      const pills = list.map(tag => '<span class="tag-pill">' + escapeHTML(decodeHtmlEntities(tag.name).trim()) + '</span>').join('');
      const extra = valid.length > 4 ? '<span class="tag-pill tag-pill-more">+' + (valid.length - 4) + '</span>' : '';
      return '<div class="bangumi-tags">' + pills + extra + '</div>';
    }

    function renderCard(item, index) {
      const subject = item.subject || {};
      const id = Number(item.subject_id || subject.id || 0);
      const rawNameCn = decodeHtmlEntities(subject.name_cn || '').trim();
      const rawName = decodeHtmlEntities(subject.name || '').trim();
      const title = escapeHTML(rawNameCn || rawName || '未命名条目');
      const originalTitle = rawNameCn && rawName && rawName !== rawNameCn ? escapeHTML(rawName) : '';
      const image = safeImageURL(subject.images?.medium || subject.images?.common || subject.images?.large || '');

      const personalRate = Number(item.rate);
      const bgmScore = Number(subject.score);
      const hasPersonalRate = Number.isFinite(personalRate) && personalRate > 0;
      const hasBgmScore = Number.isFinite(bgmScore) && bgmScore > 0;
      const rateHtml = hasPersonalRate ? renderStars(personalRate) : '';
      const bgmHtml = hasBgmScore
        ? (hasPersonalRate
            ? '<span class="bangumi-bgm-score" title="Bangumi 社区评分">BGM ' + escapeHTML(bgmScore.toFixed(1)) + '</span>'
            : '<span class="bangumi-bgm-score is-unrated" title="尚未个人打分 · Bangumi 社区评分">BGM ' + escapeHTML(bgmScore.toFixed(1)) + '</span>')
        : '';

      const tags = renderTags(subject.tags);
      const comment = decodeHtmlEntities(item.comment || '').trim();
      const rawSummary = decodeHtmlEntities(subject.summary || subject.short_summary || '').trim();
      const summaryPreview = cleanSummaryPreview(rawSummary);
      const fullSummary = rawSummary.replace(/\r\n?/g, '\n').replace(/\n{3,}/g, '\n\n').trim();
      const updated = item.updated_at ? escapeHTML(String(item.updated_at).slice(0, 10)) : '';
      const open = state.expanded === id;
      const hasReview = Boolean(comment);

      const reviewedBadge = hasReview
        ? '<span class="bangumi-reviewed-badge" title="已撰写个人短评"><span class="bangumi-reviewed-dot" aria-hidden="true"></span>短评</span>'
        : '';

      const coverHtml = image
        ? '<img src="' + image + '" alt="' + title + '" loading="lazy" decoding="async" />'
        : '<div class="bangumi-cover-placeholder">✦</div>';

      const previewText = hasReview
        ? '<p class="bangumi-preview">“' + escapeHTML(comment) + '”</p>'
        : (summaryPreview
            ? '<p class="bangumi-preview bangumi-no-review">' + escapeHTML(summaryPreview) + '</p>'
            : '<p class="bangumi-preview bangumi-no-review">暂无简介与评价</p>');

      const detailMetaItems = [];
      if (originalTitle) {
        detailMetaItems.push('<span class="bangumi-detail-meta-item"><span class="bangumi-detail-meta-label">原名</span>' + originalTitle + '</span>');
      }
      if (hasBgmScore) {
        detailMetaItems.push('<span class="bangumi-detail-meta-item"><span class="bangumi-detail-meta-label">BGM 评分</span>' + escapeHTML(bgmScore.toFixed(1)) + '</span>');
      }
      if (updated) {
        detailMetaItems.push('<span class="bangumi-detail-meta-item"><span class="bangumi-detail-meta-label">标记于</span>' + updated + '</span>');
      }
      const detailMetaHtml = detailMetaItems.length
        ? '<div class="bangumi-detail-meta">' + detailMetaItems.join('') + '</div>'
        : '';

      const showFullReviewInDetail = hasReview && (comment.length > 42 || comment.includes('\n'));
      const reviewBlockHtml = showFullReviewInDetail
        ? '<div class="bangumi-review-box"><div class="bangumi-detail-section-label">个人短评</div><p>' + escapeHTML(comment) + '</p></div>'
        : '';
      const summaryBlockHtml = fullSummary
        ? '<div class="bangumi-summary-box"><div class="bangumi-detail-section-label">作品简介</div><p>' + escapeHTML(fullSummary) + '</p></div>'
        : '<div class="bangumi-summary-box is-empty"><div class="bangumi-detail-section-label">作品简介</div><p>暂无作品简介</p></div>';

      return '<article class="bangumi-card' + (open ? ' is-open' : '') + '" data-card-id="' + id + '" style="--enter-index:' + index + ';">' +
        '<button type="button" class="bangumi-card-trigger" data-toggle-id="' + id + '" aria-expanded="' + String(open) + '">' +
        '<div class="bangumi-cover">' + coverHtml + '</div>' +
        '<div class="bangumi-card-info">' +
        '<div class="bangumi-card-title-row">' +
        '<h3>' + title + '</h3>' +
        reviewedBadge +
        '</div>' +
        '<div class="bangumi-card-meta">' +
        rateHtml +
        bgmHtml +
        (updated ? '<span class="bangumi-date">' + updated + '</span>' : '') +
        '</div>' +
        previewText +
        tags +
        '<div class="bangumi-toggle-hint">' +
        '<span class="bangumi-toggle-text">' + (open ? '收起' : '展开详情') + '</span>' +
        '<svg class="bangumi-toggle-icon' + (open ? ' rotate-180' : '') + '" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>' +
        '</div>' +
        '</div>' +
        '</button>' +
        '<div class="bangumi-detail' + (open ? ' is-open' : '') + '"' + (open ? '' : ' inert') + '>' +
        '<div class="bangumi-detail-inner">' +
        '<div class="bangumi-detail-panel">' +
        detailMetaHtml +
        reviewBlockHtml +
        summaryBlockHtml +
        '<a href="https://bgm.tv/subject/' + id + '" target="_blank" rel="noopener noreferrer" class="bangumi-link">' +
        '<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 6H6a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>' +
        '<span>前往 Bangumi 条目</span>' +
        '</a>' +
        '</div>' +
        '</div>' +
        '</div>' +
        '</article>';
    }

    function syncControls() {
      mediaButtons.forEach((button) => {
        button.classList.toggle('is-active', button.dataset.media === state.mediaType);
      });
      statusButtons.forEach((button) => {
        button.classList.toggle('is-active', button.dataset.status === state.status);
      });
      updateFilterCounts();
    }

    function renderCollection() {
      updateFilterCounts();
      const list = getFilteredList();
      updateResultsMeta(list.length);

      if (!list.length) {
        gridArea.innerHTML = '<div class="bangumi-message">' + escapeHTML(getEmptyMessage()) + '</div>';
        return;
      }

      gridArea.innerHTML = list.map((item, index) => renderCard(item, index)).join('');
    }

    function renderTimeline() {
      if (!timelineArea) return;
      const list = Array.isArray(state.data.timeline) ? state.data.timeline : [];

      if (!list.length) {
        timelineArea.innerHTML = '<div class="bangumi-message" style="padding: 1.5rem 0.5rem; font-size: 0.85rem;">暂无时间胶囊记录</div>';
        return;
      }

      const actionColorMap = {
        '在玩': 'var(--sl-color-accent)',
        '在看': 'var(--sl-color-accent)',
        '在读': 'var(--sl-color-accent)',
        '在听': 'var(--sl-color-accent)',
        '看过': '#5f8fc2',
        '读过': '#5f8fc2',
        '玩过': '#5f8fc2',
        '听过': '#5f8fc2',
        '想看': '#8fb2da',
        '想读': '#8fb2da',
        '想玩': '#8fb2da',
        '想听': '#8fb2da',
        '搁置': '#b59e72',
        '抛弃': '#8b99ab',
        '人物': '#8b7ec8',
        '目录': '#5fa3a6',
        '好友': '#bd8398',
      };

      const itemsHtml = list.map((item, index) => {
        const rawCn = decodeHtmlEntities(item.subjectNameCn || '').trim();
        let clean = decodeHtmlEntities(item.cleanTitle || '').trim();
        const rawTitle = decodeHtmlEntities(item.title || '').trim();
        let displayAction = decodeHtmlEntities(item.action || '动态').trim();

        if (displayAction === '更新了' || displayAction === '动态') {
          const targetText = clean || rawTitle;
          const verbMatch = targetText.match(/^(在玩|玩过|想玩|在看|看过|想看|在读|读过|想读|在听|听过|想听|搁置|抛弃)\s+/);
          if (verbMatch) {
            displayAction = verbMatch[1];
            clean = targetText.slice(verbMatch[0].length).trim();
          } else if (/^收藏了人物\s+/.test(targetText)) {
            displayAction = '人物';
            clean = targetText.replace(/^收藏了人物\s+/, '').trim();
          } else if (/^收藏了目录[：:\s]+/.test(targetText)) {
            displayAction = '目录';
            clean = targetText.replace(/^收藏了目录[：:\s]+/, '').trim();
          } else if (/加为了好友/.test(targetText)) {
            displayAction = '好友';
          }
        }

        const actionColor = actionColorMap[displayAction] || 'var(--sl-color-accent)';
        const subjectId = Number(item.subjectId || 0);
        const subjectUrl = subjectId ? 'https://bgm.tv/subject/' + subjectId : 'https://bgm.tv/user/duskydream/timeline';
        const rawDisplayName = rawCn || clean || rawTitle || '未命名动态';
        const displayName = escapeHTML(rawDisplayName);
        const subName = (rawCn && clean && clean !== rawCn)
          ? '<span class="bangumi-timeline-sub">' + escapeHTML(clean) + '</span>'
          : '';
        const dateText = escapeHTML(decodeHtmlEntities(item.dateFormatted || item.pubDate || ''));

        return '<div class="bangumi-timeline-item" style="--i: ' + index + ';">' +
          '<div class="bangumi-timeline-meta">' +
          '<span class="bangumi-timeline-action" style="--action-color: ' + actionColor + ';">' + escapeHTML(displayAction) + '</span>' +
          '<time class="bangumi-timeline-date">' + dateText + '</time>' +
          '</div>' +
          '<div class="bangumi-timeline-body">' +
          '<a href="' + subjectUrl + '" target="_blank" rel="noopener noreferrer" class="bangumi-timeline-link">' +
          displayName +
          '</a>' +
          subName +
          '</div>' +
          '</div>';
      }).join('');

      timelineArea.innerHTML = itemsHtml;

      if (typeof window.bindFloralVines === 'function') {
        window.bindFloralVines();
      }
    }

    function render() {
      updateStats();
      renderCollection();
      renderTimeline();
    }

    function updateExpandedState(nextId) {
      const cards = gridArea.querySelectorAll('[data-card-id]');
      cards.forEach((card) => {
        const cardId = Number(card.getAttribute('data-card-id'));
        const open = cardId === nextId;
        card.classList.toggle('is-open', open);
        const trigger = card.querySelector('[data-toggle-id]');
        const detail = card.querySelector('.bangumi-detail');
        const icon = card.querySelector('.bangumi-toggle-icon');
        const text = card.querySelector('.bangumi-toggle-text');
        trigger?.setAttribute('aria-expanded', String(open));
        if (detail) {
          detail.classList.toggle('is-open', open);
          detail.inert = !open;
          detail.toggleAttribute('inert', !open);
        }
        icon?.classList.toggle('rotate-180', open);
        if (text) text.textContent = open ? '收起' : '展开详情';
      });
    }

    function setMediaType(type) {
      if (!Object.prototype.hasOwnProperty.call(MEDIA_SUBJECT_TYPE, type)) return;
      state.mediaType = type;
      state.expanded = null;
      state.onlyReviewed = false;
      const typeFilter = MEDIA_SUBJECT_TYPE[type];
      const currentSlice = (state.data[state.status] || []).filter(item => item?.subject?.type === typeFilter);
      if (hasBangumiItems(state.data) && currentSlice.length === 0) {
        const fallbackStatus = ['watched', 'watching', 'wish'].find(
          s => (state.data[s] || []).some(item => item?.subject?.type === typeFilter)
        );
        if (fallbackStatus) {
          state.status = fallbackStatus;
        }
      }
      syncControls();
      writeQueryState();
      renderCollection();
    }

    function setStatus(status) {
      if (!Object.prototype.hasOwnProperty.call(STATUS_LABEL, status)) return;
      state.status = status;
      state.expanded = null;
      syncControls();
      writeQueryState();
      renderCollection();
    }

    mediaButtons.forEach(button => button.addEventListener('click', () => setMediaType(button.dataset.media)));
    statusButtons.forEach(button => button.addEventListener('click', () => setStatus(button.dataset.status)));
    reviewedToggle?.addEventListener('click', () => {
      if (reviewedToggle.disabled) return;
      state.onlyReviewed = !state.onlyReviewed;
      state.expanded = null;
      syncControls();
      writeQueryState();
      renderCollection();
    });

    gridArea.addEventListener('click', (event) => {
      if (!(event.target instanceof Element)) return;
      const trigger = event.target.closest('[data-toggle-id]');
      if (!trigger) return;
      const nextId = Number(trigger.dataset.toggleId);
      state.expanded = state.expanded === nextId ? null : nextId;
      updateExpandedState(state.expanded);
    });

    search.addEventListener('input', () => {
      clearTimeout(searchTimer);
      searchTimer = setTimeout(() => {
        state.expanded = null;
        writeQueryState();
        renderCollection();
      }, 180);
    });

    (async () => {
      readQueryState();
      syncControls();
      const cached = readCache(true);
      if (cached) {
        state.data = cached;
        render();
        void fetchData(true);
      } else {
        renderMessage('加载中...', 'muted', true);
        await fetchData(true);
      }
    })();
    
    document.addEventListener('astro:before-swap', () => {
      clearTimeout(searchTimer);
      state.fetchAbortController?.abort();
    }, { once: true });
    })();
  </script>

  <script>
    import { bindFloralVines } from "../utils/floral-vine";
    (window as any).bindFloralVines = bindFloralVines;
    bindFloralVines();
  </script>
</StarlightPage>

