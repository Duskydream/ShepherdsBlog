---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
---

<StarlightPage
  frontmatter={{ title: 'Anime Reviews' }}
  hasSidebar={true}
>
  <div class="bangumi-page not-content">
    <div class="bangumi-shell">
      <div class="bangumi-toolbar">
        <div class="bangumi-search">
          <svg class="bangumi-search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
          <input
            type="text"
            id="bangumi-search"
            aria-label="搜索动画或游戏"
            placeholder="搜索动画 / 游戏..."
            autocomplete="off"
          />
        </div>

        <div class="bangumi-filterbar">
          <div class="bangumi-filterbar-group">
            <span class="bangumi-filterbar-label">类型</span>
            <div class="bangumi-filterbar-options">
              <button type="button" data-media="anime" class="bangumi-chip is-active">动画</button>
              <button type="button" data-media="game" class="bangumi-chip">游戏</button>
            </div>
          </div>

          <span class="bangumi-filterbar-divider" aria-hidden="true"></span>

          <div class="bangumi-filterbar-group bangumi-filterbar-group-status">
            <span class="bangumi-filterbar-label">状态</span>
            <div class="bangumi-filterbar-options bangumi-filterbar-options-status">
              <button type="button" data-status="watching" class="bangumi-pill is-active">进行中</button>
              <button type="button" data-status="wish" class="bangumi-pill">待补完</button>
              <button type="button" data-status="watched" class="bangumi-pill">已完成</button>
            </div>
          </div>
        </div>
      </div>

      <div id="bangumi-meta" class="bangumi-meta" aria-live="polite"></div>

      <div id="bangumi-grid" class="bangumi-grid" aria-busy="false">
        <div class="bangumi-message is-pulse">加载中...</div>
      </div>
    </div>
  </div>

  <script is:inline data-astro-rerun>
    (function initBangumiPage() {
    const API = '/bangumi';
    const STATIC_FALLBACK = '/data/bangumi.json';
    const CACHE_KEY = 'bangumi_cache_v3';
    const CLIENT_TTL = 30 * 60 * 1000;
    const MEDIA_SUBJECT_TYPE = { anime: 2, game: 4 };
    const MEDIA_LABEL = { anime: '动画', game: '游戏' };
    const STATUS_LABEL = { watching: '进行中', wish: '待补完', watched: '已完成' };

    const state = {
      mediaType: 'anime',
      status: 'watching',
      data: { watching: [], wish: [], watched: [] },
      expanded: null,
      isFetching: false,
      fetchAbortController: null,
    };

    const search = document.getElementById('bangumi-search');
    const area = document.getElementById('bangumi-grid');
    const resultsMeta = document.getElementById('bangumi-meta');
    const mediaButtons = [...document.querySelectorAll('.bangumi-chip')];
    const statusButtons = [...document.querySelectorAll('.bangumi-pill')];
    let searchTimer;

    if (!search || !area || !resultsMeta) return;

    function escapeHTML(value) {
      return String(value)
        .replaceAll('&', '&amp;')
        .replaceAll('<', '&lt;')
        .replaceAll('>', '&gt;')
        .replaceAll('"', '&quot;')
        .replaceAll("'", '&#39;');
    }

    function safeImageURL(value) {
      try {
        const url = new URL(String(value), window.location.origin);
        return url.protocol === 'https:' ? escapeHTML(url.href) : '';
      } catch {
        return '';
      }
    }

    function readCache() {
      try {
        const raw = localStorage.getItem(CACHE_KEY);
        if (!raw) return null;
        const parsed = JSON.parse(raw);
        if (parsed.__cachedAt && Date.now() - parsed.__cachedAt < CLIENT_TTL) {
          return {
            watching: parsed.watching || [],
            wish: parsed.wish || [],
            watched: parsed.watched || [],
          };
        }
      } catch { /* ignore */ }
      return null;
    }

    function saveCache(payload) {
      try {
        localStorage.setItem(CACHE_KEY, JSON.stringify({ ...payload, __cachedAt: Date.now() }));
      } catch { /* ignore */ }
    }

    function normalizePayload(payload) {
      return {
        watching: Array.isArray(payload?.watching) ? payload.watching : [],
        wish: Array.isArray(payload?.wish) ? payload.wish : [],
        watched: Array.isArray(payload?.watched) ? payload.watched : [],
      };
    }

    function hasBangumiItems(payload) {
      return payload.watching.length > 0 || payload.wish.length > 0 || payload.watched.length > 0;
    }

    function renderMessage(message, tone, pulse) {
      area.innerHTML = '<div class="bangumi-message' + (tone === 'error' ? ' is-error' : '') + (pulse ? ' is-pulse' : '') + '">' + escapeHTML(message) + '</div>';
    }

    function setFetching(isFetching) {
      area.setAttribute('aria-busy', String(isFetching));
      area.dataset.fetching = String(isFetching);
    }

    async function requestJSON(url, signal, force = false) {
      const response = await fetch(url, { cache: force ? 'no-store' : 'default', signal });
      if (!response.ok) throw new Error('Request failed: ' + response.status);
      return response.json();
    }

    async function fetchData(force) {
      if (state.isFetching) return null;

      if (!force) {
        const cached = readCache();
        if (cached) {
          state.data = cached;
          render();
          return cached;
        }
      }

      state.isFetching = true;
      state.fetchAbortController = new AbortController();
      setFetching(true);

      try {
        const query = API + (force ? '?force=true' : '');
        const payload = normalizePayload(await requestJSON(query, state.fetchAbortController.signal, force));
        if (!hasBangumiItems(payload)) throw new Error('Empty Bangumi payload');
        state.data = payload;
        saveCache(state.data);
        render();
        return state.data;
      } catch (primaryError) {
        if (primaryError.name === 'AbortError') return null;
        try {
          const payload = normalizePayload(await requestJSON(STATIC_FALLBACK, state.fetchAbortController.signal, force));
          if (!hasBangumiItems(payload)) throw new Error('Empty Bangumi fallback payload');
          state.data = payload;
          saveCache(state.data);
          render();
          return state.data;
        } catch (fallbackError) {
          if (fallbackError.name === 'AbortError') return null;
          if (!state.data.watching.length && !state.data.wish.length && !state.data.watched.length) {
            renderMessage('无法加载数据，请检查网络连接后刷新页面', 'error');
          }
          return null;
        }
      } finally {
        state.isFetching = false;
        state.fetchAbortController = null;
        setFetching(false);
      }
    }

    function getFilteredList() {
      const source = state.data[state.status] || [];
      const typeFilter = MEDIA_SUBJECT_TYPE[state.mediaType];
      const keyword = search.value.toLowerCase().trim();

      return source
        .filter(item => item.subject?.type === typeFilter)
        .filter((item) => {
          if (!keyword) return true;
          const title = item.subject?.name_cn || item.subject?.name || '';
          return title.toLowerCase().includes(keyword);
        });
    }

    function updateResultsMeta(total) {
      const keyword = search.value.trim();
      const base = MEDIA_LABEL[state.mediaType] + ' · ' + STATUS_LABEL[state.status] + ' · ' + total + ' 项';
      resultsMeta.textContent = keyword ? base + ' · 关键词「' + keyword + '」' : base;
    }

    function getEmptyMessage() {
      if (search.value.trim()) return '没有找到匹配的内容';
      return '当前分类下还没有' + MEDIA_LABEL[state.mediaType] + '条目';
    }

    function renderStars(score) {
      const value = Number(score);
      if (!Number.isFinite(value) || value <= 0) return '';
      const filled = Math.max(0, Math.min(5, Math.round(value / 2)));
      let stars = '';
      for (let i = 0; i < 5; i++) {
        stars += '<span class="bangumi-star' + (i < filled ? ' is-filled' : '') + '" aria-hidden="true">✦</span>';
      }
      return '<span class="bangumi-score" aria-label="评分 ' + escapeHTML(value.toFixed(1)) + '">' +
        stars +
        '<span class="bangumi-score-value">' + escapeHTML(value.toFixed(1)) + '</span>' +
        '</span>';
    }

    function renderTags(tags) {
      const list = Array.isArray(tags) ? tags.filter(tag => tag && tag.name).slice(0, 5) : [];
      if (!list.length) return '';
      const pills = list.map(tag => '<span class="tag-pill">' + escapeHTML(tag.name) + '</span>').join('');
      const extra = tags.length > 5 ? '<span class="tag-pill tag-pill-more">+' + (tags.length - 5) + '</span>' : '';
      return '<div class="bangumi-tags">' + pills + extra + '</div>';
    }

    function renderCard(item, index) {
      const titleText = item.subject?.name_cn || item.subject?.name || '?';
      const title = escapeHTML(titleText);
      const image = safeImageURL(item.subject?.images?.large || item.subject?.images?.common || '');
      const id = Number(item.subject?.id) || 0;
      const commentText = item.comment?.trim() || '';
      const comment = escapeHTML(commentText);
      const summaryText = String(item.subject?.short_summary || '').replace(/\s+/g, ' ').trim();
      const airDate = escapeHTML(item.subject?.date || '');
      const scoreHTML = renderStars(item.subject?.score);
      const rank = Number(item.subject?.rank);
      const rankHTML = Number.isFinite(rank) && rank > 0 ? '<span class="bangumi-rank">Rank ' + rank + '</span>' : '';
      const tagsHTML = renderTags(item.subject?.tags);
      const open = state.expanded === id;

      const metaHTML = (scoreHTML || rankHTML || airDate)
        ? '<div class="bangumi-card-meta">' + scoreHTML + rankHTML + (airDate ? '<span class="bangumi-date">' + airDate + '</span>' : '') + '</div>'
        : '';

      const previewHTML = commentText
        ? '<p class="bangumi-preview">' + escapeHTML(commentText.slice(0, 120) + (commentText.length > 120 ? '...' : '')) + '</p>'
        : summaryText
          ? '<p class="bangumi-preview">' + escapeHTML(summaryText.slice(0, 80) + (summaryText.length > 80 ? '…' : '')) + '</p>'
          : '<p class="bangumi-preview bangumi-no-review">暂无简介</p>';

      const detailBody = commentText
        ? '<div class="bangumi-review-box"><p>' + comment + '</p></div>'
        : summaryText
          ? '<div class="bangumi-review-box bangumi-summary-box"><p>' + escapeHTML(summaryText) + '</p></div>'
          : '';

      return '<article class="bangumi-card' + (open ? ' is-open' : '') + '" data-card-id="' + id + '" style="--enter-index:' + index + ';">' +
        '<button type="button" class="bangumi-card-trigger" data-toggle-id="' + id + '" aria-expanded="' + open + '">' +
        '<div class="bangumi-cover">' +
        (image
          ? '<img src="' + image + '" alt="' + title + '" loading="lazy" decoding="async" />'
          : '<div class="bangumi-cover-placeholder" aria-hidden="true">❀</div>') +
        '</div>' +
        '<div class="bangumi-card-info">' +
        '<h3>' + title + '</h3>' +
        metaHTML +
        previewHTML +
        tagsHTML +
        '<span class="bangumi-toggle-hint">' +
        '<svg class="bangumi-toggle-icon' + (open ? ' rotate-180' : '') + '" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 9l-7 7-7-7"/></svg>' +
        '<span class="bangumi-toggle-text">' + (open ? '收起' : '展开详情') + '</span>' +
        '</span>' +
        '</div>' +
        '</button>' +
        '<div class="bangumi-detail' + (open ? ' is-open' : '') + '" data-detail-id="' + id + '">' +
        '<div class="bangumi-detail-inner">' +
        '<div class="bangumi-detail-panel">' +
        detailBody +
        '<a href="https://bgm.tv/subject/' + id + '" target="_blank" rel="noopener noreferrer" class="bangumi-link">' +
        '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 6H6a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>' +
        '<span>前往 Bangumi</span>' +
        '</a>' +
        '</div>' +
        '</div>' +
        '</div>' +
        '</article>';
    }

    function syncControls() {
      mediaButtons.forEach((button) => {
        button.classList.toggle('is-active', button.dataset.media === state.mediaType);
      });
      statusButtons.forEach((button) => {
        button.classList.toggle('is-active', button.dataset.status === state.status);
      });
    }

    function render() {
      const list = getFilteredList();
      updateResultsMeta(list.length);

      if (!list.length) {
        renderMessage(getEmptyMessage());
        return;
      }

      area.innerHTML = list.map((item, index) => renderCard(item, index)).join('');
    }

    function updateExpandedState(nextId) {
      const cards = area.querySelectorAll('[data-card-id]');
      cards.forEach((card) => {
        const cardId = Number(card.getAttribute('data-card-id'));
        const open = cardId === nextId;
        card.classList.toggle('is-open', open);
        const trigger = card.querySelector('[data-toggle-id]');
        const detail = card.querySelector('.bangumi-detail');
        const icon = card.querySelector('.bangumi-toggle-icon');
        const text = card.querySelector('.bangumi-toggle-text');
        trigger?.setAttribute('aria-expanded', String(open));
        detail?.classList.toggle('is-open', open);
        icon?.classList.toggle('rotate-180', open);
        if (text) text.textContent = open ? '收起' : '展开详情';
      });
    }

    function setMediaType(type) {
      state.mediaType = type;
      state.expanded = null;
      syncControls();
      render();
    }

    function setStatus(status) {
      state.status = status;
      state.expanded = null;
      syncControls();
      render();
    }

    mediaButtons.forEach(button => button.addEventListener('click', () => setMediaType(button.dataset.media)));
    statusButtons.forEach(button => button.addEventListener('click', () => setStatus(button.dataset.status)));

    area.addEventListener('click', (event) => {
      if (!(event.target instanceof Element)) return;
      const trigger = event.target.closest('[data-toggle-id]');
      if (!trigger) return;
      const nextId = Number(trigger.dataset.toggleId);
      state.expanded = state.expanded === nextId ? null : nextId;
      updateExpandedState(state.expanded);
    });

    search.addEventListener('input', () => {
      clearTimeout(searchTimer);
      searchTimer = setTimeout(() => {
        state.expanded = null;
        render();
      }, 180);
    });

    (async () => {
      syncControls();
      const cached = readCache();
      if (cached) {
        state.data = cached;
        render();
        // Do not make navigation wait on a network request when the last
        // successful response is still usable.
        void fetchData(true);
      } else {
        renderMessage('加载中...', 'muted', true);
        await fetchData(false);
      }
    })();
    
    document.addEventListener('astro:before-swap', () => {
      clearTimeout(searchTimer);
      state.fetchAbortController?.abort();
    }, { once: true });
    })();
  </script>
</StarlightPage>

<style is:global>
  .bangumi-page {
    max-width: 72rem;
    margin: 0 auto;
  }

  .bangumi-shell {
    position: relative;
    padding: 1rem 0;
  }

  .bangumi-toolbar {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    margin-bottom: 1.75rem;
  }

  .bangumi-search {
    position: relative;
    width: 100%;
    max-width: 30rem;
  }

  .bangumi-search-icon {
    position: absolute;
    left: 0.95rem;
    top: 50%;
    transform: translateY(-50%);
    color: var(--sl-color-gray-4);
    pointer-events: none;
  }

  .bangumi-search input {
    width: 100%;
    padding: 0.6rem 1rem 0.6rem 2.45rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 999px;
    background: transparent;
    color: var(--sl-color-white);
    font-size: 0.95rem;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .bangumi-search input:focus {
    outline: none;
    border-color: var(--sl-color-accent);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--sl-color-accent) 18%, transparent);
  }

  .bangumi-filterbar {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .bangumi-page :where(
    .bangumi-filterbar-group,
    .bangumi-filterbar-options,
    .bangumi-filterbar-options > *,
    .bangumi-card-trigger > *,
    .bangumi-card-info > *
  ) {
    margin-top: 0;
  }

  .bangumi-filterbar-group {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .bangumi-filterbar-label {
    font-size: 0.8rem;
    color: var(--sl-color-gray-4);
  }

  .bangumi-filterbar-options {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .bangumi-filterbar-divider {
    display: none;
  }

  .bangumi-chip,
  .bangumi-pill {
    appearance: none;
    background: transparent;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 999px;
    color: var(--sl-color-gray-3);
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
    padding: 0.3rem 0.9rem;
    transition: color 0.2s ease, background-color 0.2s ease, border-color 0.2s ease;
  }

  .bangumi-chip:hover,
  .bangumi-pill:hover {
    border-color: var(--sl-color-accent);
    color: var(--sl-color-accent);
  }

  .bangumi-chip.is-active,
  .bangumi-pill.is-active {
    background: var(--sl-color-accent);
    border-color: var(--sl-color-accent);
    color: var(--sl-color-bg);
  }

  .bangumi-meta {
    color: var(--sl-color-gray-4);
    font-size: 0.85rem;
    margin-bottom: 1.5rem;
  }

  .bangumi-meta::before {
    content: "✦";
    color: var(--sl-color-accent-high);
    font-size: 0.7rem;
    margin-right: 0.5rem;
  }

  .bangumi-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1.5rem;
  }

  .bangumi-card {
    border-radius: 0.75rem;
    border: 1px solid var(--sl-color-gray-6);
    background: transparent;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    animation: floral-grow-in 0.4s cubic-bezier(0.16, 1, 0.3, 1) both;
    animation-delay: calc(var(--enter-index, 0) * 30ms);
    content-visibility: auto;
    contain-intrinsic-size: 9rem;
    transition: border-color 0.22s ease, box-shadow 0.22s ease;
  }

  .bangumi-card:hover {
    border-color: var(--sl-color-accent);
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.07);
  }

  .bangumi-card.is-open {
    border-color: var(--sl-color-accent);
    box-shadow:
      0 0 0 1px var(--sl-color-accent),
      0 8px 24px color-mix(in srgb, var(--sl-color-accent) 16%, transparent);
  }

  .bangumi-card-trigger {
    width: 100%;
    display: flex;
    gap: 1rem;
    padding: 1rem;
    align-items: stretch;
    cursor: pointer;
    background: none;
    border: none;
    text-align: left;
  }

  .bangumi-cover {
    width: 5rem;
    min-width: 5rem;
    height: 7rem;
    background: var(--sl-color-gray-7, var(--sl-color-gray-6));
    border-radius: 0.5rem;
    overflow: hidden;
  }

  .bangumi-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .bangumi-cover-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
    font-size: 1.75rem;
    color: var(--sl-color-accent);
    opacity: 0.5;
  }

  .bangumi-card-info {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
  }

  .bangumi-card-info h3 {
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--sl-color-white);
    margin: 0 0 0.4rem;
    line-height: 1.3;
  }

  .bangumi-card-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.4rem 0.7rem;
    margin: 0 0 0.5rem;
    font-size: 0.78rem;
    color: var(--sl-color-gray-4);
  }

  .bangumi-score {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
  }

  .bangumi-star {
    color: var(--sl-color-gray-5);
    font-size: 0.7rem;
  }

  .bangumi-star.is-filled {
    color: var(--sl-color-accent);
  }

  .bangumi-score-value {
    color: var(--sl-color-gray-3);
    font-weight: 600;
  }

  .bangumi-date {
    font-size: 0.75rem;
    color: var(--sl-color-gray-4);
  }

  .bangumi-preview {
    font-size: 0.85rem;
    color: var(--sl-color-gray-3);
    line-height: 1.55;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .bangumi-no-review {
    color: var(--sl-color-gray-5);
  }

  .bangumi-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.6rem;
  }

  .tag-pill {
    border-radius: 1rem;
    padding: 0.12rem 0.6rem;
    font-size: 0.72rem;
    color: var(--sl-color-accent);
    background: color-mix(in srgb, var(--sl-color-accent) 10%, transparent);
  }

  .tag-pill-more {
    opacity: 0.7;
  }

  .bangumi-toggle-hint {
    margin-top: auto;
    padding-top: 0.65rem;
    display: flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.78rem;
    color: var(--sl-color-accent);
  }

  .bangumi-toggle-icon {
    transition: transform 0.2s ease;
  }
  .bangumi-toggle-icon.rotate-180 {
    transform: rotate(180deg);
  }

  .bangumi-detail {
    display: grid;
    grid-template-rows: 0fr;
    opacity: 0;
    transition: grid-template-rows 0.3s ease, opacity 0.3s ease;
    background: color-mix(in srgb, var(--sl-color-accent) 5%, transparent);
  }

  .bangumi-detail.is-open {
    grid-template-rows: 1fr;
    opacity: 1;
    border-top: 1px solid var(--sl-color-gray-6);
  }

  .bangumi-detail-inner {
    overflow: hidden;
  }

  .bangumi-detail-panel {
    padding: 1.25rem;
  }

  .bangumi-review-box {
    position: relative;
    margin-bottom: 1.25rem;
