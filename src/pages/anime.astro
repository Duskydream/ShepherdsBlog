    display: flex;
    align-items: center;
    font-size: 0.98rem;
    font-weight: 600;
    color: var(--sl-color-white);
    margin: 0 0 0.35rem;
    line-height: 1.35;
  }

  .bangumi-card-info h3::before {
    content: none !important;
    display: none !important;
  }

