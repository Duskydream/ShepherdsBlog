  }

  .bangumi-detail.is-open {
    grid-template-rows: 1fr;
    opacity: 1;
    border-top: 1px solid var(--sl-color-gray-6);
  }

  .bangumi-detail-inner {
    overflow: hidden;
  }

  .bangumi-detail-panel {
    padding: 1rem 1.15rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .bangumi-orig-title {
    font-size: 0.76rem;
    color: var(--sl-color-gray-4);
  }

  .bangumi-review-box {
