  .bangumi-user-intro-panel {
    margin-top: 0.85rem;
    padding: 0.65rem 0.95rem;
    background: color-mix(in srgb, var(--sl-color-accent) 4%, transparent);
    border-radius: 0.55rem;
    border: 1px solid var(--sl-color-gray-6);
    border-inline-start: 3px solid var(--sl-color-accent);
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .bangumi-user-intro-header {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.74rem;
    font-weight: 600;
    color: var(--sl-color-accent);
    letter-spacing: 0.04em;
    margin: 0 !important;
  }

  .bangumi-user-intro-icon {
    font-size: 0.85em;
  }

  .bangumi-user-intro-content {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

