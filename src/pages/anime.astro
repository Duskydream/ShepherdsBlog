    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .bangumi-no-review {
    color: var(--sl-color-gray-5);
  }

  .bangumi-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
    margin-top: 0.5rem;
  }

  .tag-pill {
    border-radius: 999px;
    padding: 0.08rem 0.5rem;
    font-size: 0.68rem;
    color: var(--sl-color-accent);
    background: color-mix(in srgb, var(--sl-color-accent) 10%, transparent);
  }

  .tag-pill-more {
    opacity: 0.7;
  }

  .bangumi-toggle-hint {
    margin-top: auto;
    padding-top: 0.5rem;
