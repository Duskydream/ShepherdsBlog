    padding: 0 !important;
    font-family: "Songti SC", "Source Han Serif SC", "STSong", serif;
    font-size: 0.84rem;
    line-height: 1.35;
    color: var(--sl-color-gray-2);
    letter-spacing: 0.02em;
  }

