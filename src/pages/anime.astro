    gap: 0.35rem;
    font-size: 0.74rem;
    font-weight: 600;
    color: var(--bangumi-accent-ink);
    letter-spacing: 0.06em;
    margin: 0 !important;
  }

  .bangumi-user-intro-icon {
    color: var(--sl-color-accent);
  }

  .bangumi-user-intro-content {
    display: flex;
    flex-direction: column;
    gap: 0.22rem;
  }

  .bangumi-page :where(.bangumi-user-intro-content p),
  .bangumi-user-intro-content p {
    margin: 0 !important;
    padding: 0 !important;
    font-family: "Songti SC", "Source Han Serif SC", "Noto Serif CJK SC", "STSong", serif;
    font-size: 0.85rem;
    line-height: 1.5;
    color: var(--sl-color-gray-2);
    letter-spacing: 0.02em;
  }

  @media (min-width: 700px) {
    .bangumi-user-intro-content {
      flex-direction: row;
      flex-wrap: wrap;
      align-items: baseline;
      gap: 0.25rem 0;
    }

    .bangumi-user-intro-content p:not(:last-child)::after {
      content: "✦";
      margin-inline: 0.55rem;
      color: color-mix(in srgb, var(--sl-color-accent) 68%, transparent);
      font-size: 0.72em;
      vertical-align: 0.05em;
    }
  }

  /* 双栏布局 */
  .bangumi-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 21.5rem;
    gap: 1.25rem;
    align-items: start;
    min-width: 0;
  }

  .bangumi-main-section,
  .bangumi-aside-section {
    min-width: 0;
  }

  @media (min-width: 981px) {
    .bangumi-aside-section {
      position: sticky;
      top: calc(var(--sl-nav-height) + 1.25rem);
    }
  }

  @media (max-width: 980px) {
    .bangumi-layout {
      grid-template-columns: 1fr;
    }
  }

  .bangumi-meta-badge {
    font-family: var(--sl-font-mono);
    font-size: 0.74rem;
    color: var(--sl-color-gray-3);
    overflow-wrap: anywhere;
  }

  .bangumi-toolbar-inner {
    padding: 0.95rem 0;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    border-bottom: 1px solid var(--sl-color-gray-6);
  }

  .bangumi-search {
    position: relative;
    width: 100%;
    max-width: 28rem;
    box-sizing: border-box;
  }

  .bangumi-search-icon {
    position: absolute;
    left: 0.85rem;
    top: 50%;
    transform: translateY(-50%);
    color: var(--sl-color-gray-3);
    pointer-events: none;
  }

  .bangumi-search input {
    width: 100%;
    min-width: 0;
    box-sizing: border-box;
    padding: 0.48rem 1rem 0.48rem 2.35rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 999px;
    background: var(--sl-color-bg);
    color: var(--sl-color-white);
    font-family: inherit;
    font-size: 0.86rem;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .bangumi-search input::placeholder {
    color: var(--sl-color-gray-3);
    opacity: 0.8;
  }

  .bangumi-search input:focus {
    outline: none;
    border-color: var(--sl-color-accent);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--sl-color-accent) 18%, transparent);
  }

  .bangumi-filterbar {
    display: flex;
    align-items: center;
    gap: 0.7rem 1rem;
    flex-wrap: wrap;
  }

  .bangumi-filterbar-group {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    flex-wrap: wrap;
    min-width: 0;
  }

  .bangumi-filterbar-label {
    font-size: 0.76rem;
    color: var(--sl-color-gray-3);
    white-space: nowrap;
  }

  .bangumi-filterbar-options {
    display: flex;
    align-items: center;
    gap: 0.38rem;
    flex-wrap: wrap;
  }

  .bangumi-filterbar-divider {
    width: 1px;
    height: 1rem;
    background: var(--sl-color-gray-6);
  }

  .bangumi-filterbar-group-toggle {
    margin-inline-start: auto;
  }

  @media (max-width: 1180px) {
    .bangumi-filterbar-divider {
      display: none;
    }
    .bangumi-filterbar-group-toggle {
      margin-inline-start: 0;
    }
  }

  .bangumi-chip,
  .bangumi-pill,
  .bangumi-toggle-chip {
    appearance: none;
    display: inline-flex;
    align-items: center;
    gap: 0.32rem;
    background: transparent;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 999px;
    color: var(--sl-color-gray-2);
    font-family: inherit;
    font-size: 0.78rem;
    font-weight: 500;
    line-height: 1.25;
    cursor: pointer;
    padding: 0.28rem 0.72rem;
    transition: border-color 0.2s ease, color 0.2s ease, background-color 0.2s ease;
  }

  .bangumi-chip:hover,
  .bangumi-pill:hover,
  .bangumi-toggle-chip:not(:disabled):hover {
    border-color: color-mix(in srgb, var(--sl-color-accent) 48%, transparent);
    color: var(--bangumi-accent-ink);
    background: color-mix(in srgb, var(--sl-color-accent) 10%, transparent);
  }

  .bangumi-chip.is-active,
  .bangumi-pill.is-active,
  .bangumi-toggle-chip.is-active {
    background: var(--bangumi-accent-badge-bg);
    border-color: var(--sl-color-accent);
    color: var(--bangumi-accent-ink);
    font-weight: 600;
  }

  .bangumi-toggle-chip:disabled,
  .bangumi-toggle-chip.is-disabled {
    opacity: 0.45;
    cursor: not-allowed;
  }

  .bangumi-toggle-dot {
    width: 0.56rem;
    height: 0.56rem;
    flex-shrink: 0;
    background-color: currentColor;
    -webkit-mask: var(--floral-mask-bloom) center / contain no-repeat;
    mask: var(--floral-mask-bloom) center / contain no-repeat;
    opacity: 0.8;
  }

  .bangumi-chip-count,
  .bangumi-pill-count,
  .bangumi-toggle-count {
    font-family: var(--sl-font-mono);
    font-size: 0.7rem;
    opacity: 0.78;
  }

  .bangumi-chip-count:empty,
  .bangumi-pill-count:empty,
  .bangumi-toggle-count:empty {
    display: none;
  }

  .bangumi-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 310px), 1fr));
    gap: 1rem;
    align-items: start;
    padding: 0;
  }

  .bangumi-card {
    border-radius: 0.95rem;
    border: 1px solid var(--sl-color-gray-6);
    background: var(--sl-color-bg);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    min-width: 0;
    animation: floral-bloom 0.4s cubic-bezier(0.16, 1, 0.3, 1) both;
    animation-delay: calc(min(var(--enter-index, 0), 12) * 22ms);
    transition: border-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
  }

  .bangumi-card:hover {
    border-color: color-mix(in srgb, var(--sl-color-accent) 45%, transparent);
    transform: translateY(-2px);
    box-shadow: var(--bangumi-card-shadow);
  }

  .bangumi-card.is-open {
    border-color: var(--sl-color-accent);
    box-shadow: 0 0 0 1px var(--sl-color-accent);
  }

  .bangumi-card-trigger {
    width: 100%;
    display: flex;
    gap: 0.9rem;
    padding: 0.9rem;
    align-items: stretch;
    cursor: pointer;
    background: none;
    border: none;
    font: inherit;
    color: inherit;
    text-align: left;
    min-width: 0;
  }

  .bangumi-cover {
    width: 4.5rem;
    min-width: 4.5rem;
    height: 6.3rem;
    background: var(--sl-color-gray-7, var(--sl-color-gray-6));
    border-radius: 0.5rem;
    overflow: hidden;
    flex-shrink: 0;
    color: var(--sl-color-gray-3);
    font-size: 0.72rem;
  }

  /* 提高选择器权重，覆盖 custom.css 中 body .sl-markdown-content img 的 height:auto，
     让横版海报也能填满封面框并居中裁剪，而不是按原始比例只占上半部分。 */
  .bangumi-page .bangumi-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  .bangumi-cover-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
    font-size: 0;
    color: var(--sl-color-accent);
    opacity: 0.45;
  }

  .bangumi-cover-placeholder::before {
    content: "";
    width: 1.5rem;
    height: 1.5rem;
    background-color: var(--sl-color-accent);
    -webkit-mask: var(--floral-mask-bloom) center / contain no-repeat;
    mask: var(--floral-mask-bloom) center / contain no-repeat;
  }

  .bangumi-card-info {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
  }

  .bangumi-card-title-row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.45rem;
    margin: 0 0 0.35rem;
    min-width: 0;
  }

  .bangumi-card-info h3 {
    font-family: "Songti SC", "Source Han Serif SC", "Noto Serif CJK SC", "STSong", serif;
    font-size: 1rem;
    font-weight: 600;
    color: var(--sl-color-white);
    margin: 0;
    line-height: 1.38;
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .bangumi-card-info h3::before {
    content: none !important;
    display: none !important;
  }

  .bangumi-reviewed-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    flex-shrink: 0;
    padding: 0.12rem 0.46rem;
    border-radius: 999px;
    font-size: 0.67rem;
    font-weight: 600;
    line-height: 1.25;
    color: var(--bangumi-accent-ink);
    background: var(--bangumi-accent-badge-bg);
    border: 1px solid var(--bangumi-accent-badge-border);
    white-space: nowrap;
    margin-top: 0.1rem;
  }

  .bangumi-reviewed-dot {
    width: 0.58rem;
    height: 0.58rem;
    flex-shrink: 0;
    background-color: currentColor;
    -webkit-mask: var(--floral-mask-bloom) center / contain no-repeat;
    mask: var(--floral-mask-bloom) center / contain no-repeat;
  }

  .bangumi-card-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.35rem 0.55rem;
    margin: 0 0 0.45rem;
    font-size: 0.74rem;
    color: var(--sl-color-gray-3);
  }

  .bangumi-score {
    display: inline-flex;
    align-items: center;
    gap: 0.22rem;
  }

  .bangumi-star {
    width: 0.7rem;
    height: 0.7rem;
    flex-shrink: 0;
    font-size: 0;
    background-color: var(--sl-color-gray-5);
    -webkit-mask: var(--floral-mask-bloom) center / contain no-repeat;
    mask: var(--floral-mask-bloom) center / contain no-repeat;
    transition: transform 0.2s ease;
  }

  .bangumi-star.is-filled {
    background-color: var(--sl-color-accent);
  }

  .bangumi-score-value {
    font-family: var(--sl-font-mono);
    color: var(--sl-color-gray-2);
    font-weight: 600;
    margin-inline-start: 0.1rem;
  }

  .bangumi-bgm-score {
    font-family: var(--sl-font-mono);
    font-size: 0.68rem;
    line-height: 1.25;
    padding: 0.08rem 0.44rem;
    border-radius: 999px;
    border: 1px solid var(--sl-color-gray-6);
    background: var(--sl-color-gray-7, var(--sl-color-gray-6));
    color: var(--sl-color-gray-3);
  }

  .bangumi-bgm-score.is-unrated {
    color: var(--sl-color-gray-2);
    border-color: var(--sl-color-gray-5);
  }

  .bangumi-date {
    font-family: var(--sl-font-mono);
    font-size: 0.7rem;
    color: var(--sl-color-gray-3);
  }

  .bangumi-preview {
    font-size: 0.81rem;
    color: var(--sl-color-gray-2);
    line-height: 1.52;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    overflow-wrap: anywhere;
  }

  .bangumi-no-review {
    color: var(--sl-color-gray-3);
  }

  .bangumi-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
    margin-top: 0.55rem;
  }

  .tag-pill {
    border-radius: 999px;
    padding: 0.1rem 0.5rem;
    font-size: 0.68rem;
    line-height: 1.25;
    border: 1px solid var(--sl-color-gray-6);
    background: var(--sl-color-gray-7, var(--sl-color-gray-6));
    color: var(--sl-color-gray-2);
  }

  .tag-pill-more {
    font-family: var(--sl-font-mono);
    color: var(--sl-color-gray-3);
  }

  .bangumi-toggle-hint {
    margin-top: auto;
    padding-top: 0.55rem;
    display: flex;
    align-items: center;
    gap: 0.25rem;
    font-size: 0.74rem;
    color: var(--bangumi-accent-ink);
  }

  .bangumi-toggle-icon {
    transition: transform 0.2s ease;
  }

  .bangumi-toggle-icon.rotate-180 {
    transform: rotate(180deg);
  }

  .bangumi-detail {
    display: grid;
    grid-template-rows: 0fr;
    opacity: 0;
    visibility: hidden;
    transition: grid-template-rows 0.3s ease, opacity 0.3s ease, visibility 0.3s ease;
    background: var(--bangumi-soft-wash);
  }

  .bangumi-detail.is-open {
    grid-template-rows: 1fr;
    opacity: 1;
    visibility: visible;
    border-top: 1px solid var(--sl-color-gray-6);
  }

  .bangumi-detail-inner {
    overflow: hidden;
  }

  .bangumi-detail-panel {
    padding: 0.95rem 1.05rem 1.05rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    min-width: 0;
  }

  .bangumi-detail-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.9rem;
    padding-bottom: 0.55rem;
    border-bottom: 1px solid color-mix(in srgb, var(--sl-color-gray-6) 70%, transparent);
    font-size: 0.74rem;
    color: var(--sl-color-gray-2);
  }

  .bangumi-detail-meta-item {
    display: inline-flex;
    align-items: baseline;
    gap: 0.35rem;
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .bangumi-detail-meta-label {
    font-family: var(--sl-font-mono);
    font-size: 0.68rem;
    color: var(--sl-color-gray-3);
  }

  .bangumi-detail-section-label {
    font-family: var(--sl-font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    color: var(--bangumi-accent-ink);
    margin-bottom: 0.28rem;
    font-weight: 600;
  }

  .bangumi-review-box {
    border-inline-start: 2px solid color-mix(in srgb, var(--sl-color-accent) 55%, transparent);
    padding: 0.45rem 0.75rem;
    background: color-mix(in srgb, var(--sl-color-accent) 4%, transparent);
    border-radius: 0 0.5rem 0.5rem 0;
  }

  .bangumi-review-box p {
    font-size: 0.84rem;
    color: var(--sl-color-gray-1);
    line-height: 1.65;
    margin: 0;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .bangumi-summary-box p {
    font-size: 0.81rem;
    color: var(--sl-color-gray-2);
    line-height: 1.6;
    margin: 0;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .bangumi-summary-box.is-empty .bangumi-detail-section-label {
    color: var(--sl-color-gray-3);
  }

  .bangumi-summary-box.is-empty p {
    color: var(--sl-color-gray-3);
    font-style: italic;
  }

  .bangumi-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.35rem 0.9rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 999px;
    color: var(--sl-color-white);
    font-size: 0.76rem;
    text-decoration: none;
    align-self: flex-start;
    transition: border-color 0.2s ease, background-color 0.2s ease, color 0.2s ease;
  }

  .bangumi-link:hover {
    border-color: var(--sl-color-accent);
    background: var(--bangumi-accent-badge-bg);
    color: var(--bangumi-accent-ink);
  }

  /* 时间胶囊侧栏卡片 */
  .bangumi-timeline-rss-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.22rem 0.62rem;
    border-radius: 999px;
    border: 1px solid var(--sl-color-gray-5);
    color: var(--sl-color-gray-2);
    font-family: var(--sl-font-mono);
    font-size: 0.7rem;
    text-decoration: none;
    transition: border-color 0.2s ease, color 0.2s ease, background-color 0.2s ease;
  }

  .bangumi-timeline-rss-btn:hover {
    color: var(--bangumi-accent-ink);
    border-color: var(--sl-color-accent);
    background: var(--bangumi-accent-badge-bg);
  }

  .bangumi-timeline-scroll {
    max-height: min(680px, calc(100vh - var(--sl-nav-height) - 7rem));
    overflow-y: auto;
    overflow-x: clip;
    padding: 0.75rem 0.25rem 0.25rem 0;
  }

  .bangumi-timeline-scroll::-webkit-scrollbar {
    width: 5px;
  }

  .bangumi-timeline-scroll::-webkit-scrollbar-thumb {
    background: var(--sl-color-gray-5);
    border-radius: 3px;
  }

  .bangumi-timeline {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding-inline-start: 1.65rem;
    width: 100%;
    box-sizing: border-box;
  }

  .bangumi-timeline-item {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.28rem;
    padding: 0.62rem 0.65rem;
    border-radius: 0.6rem;
    border-bottom: 1px solid color-mix(in srgb, var(--sl-color-gray-6) 60%, transparent);
    background: transparent;
    min-width: 0;
    transition: background-color 0.18s ease, transform 0.18s ease;
    animation: floral-bloom 0.4s cubic-bezier(0.16, 1, 0.3, 1) both;
    animation-delay: calc(min(var(--i, 0), 12) * 28ms);
  }

  .bangumi-timeline-item:last-child {
    border-bottom: none;
  }

  .bangumi-timeline-item:hover {
    background: color-mix(in srgb, var(--sl-color-accent) 6%, transparent);
    transform: translateX(2px);
  }

  .bangumi-timeline-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .bangumi-timeline-action {
    display: inline-flex;
    align-items: center;
    padding: 0.08rem 0.52rem;
    border-radius: 999px;
    font-size: 0.67rem;
    font-weight: 600;
    line-height: 1.25;
    color: color-mix(in srgb, var(--action-color, var(--sl-color-accent)) 72%, var(--sl-color-white));
    background: color-mix(in srgb, var(--action-color, var(--sl-color-accent)) 11%, transparent);
    border: 1px solid color-mix(in srgb, var(--action-color, var(--sl-color-accent)) 28%, transparent);
  }

  .bangumi-timeline-date {
    font-family: var(--sl-font-mono);
    font-size: 0.7rem;
    color: var(--sl-color-gray-3);
  }

  .bangumi-timeline-body {
    display: flex;
    flex-direction: column;
    gap: 0.14rem;
    min-width: 0;
  }

  .bangumi-timeline-link {
    font-family: "Songti SC", "Source Han Serif SC", "Noto Serif CJK SC", "STSong", serif;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--sl-color-white);
    text-decoration: none;
    line-height: 1.38;
    overflow-wrap: anywhere;
    transition: color 0.15s ease;
  }

  .bangumi-timeline-link:hover {
    color: var(--bangumi-accent-ink);
  }

  .bangumi-timeline-sub {
    font-size: 0.73rem;
    color: var(--sl-color-gray-3);
    overflow-wrap: anywhere;
  }

  .bangumi-message {
    padding: 2.5rem 1rem;
    text-align: center;
    color: var(--sl-color-gray-3);
    border: 1px dashed var(--sl-color-gray-5);
    border-radius: 0.75rem;
    grid-column: 1 / -1;
  }

  .bangumi-message.is-pulse::before {
    content: "";
    display: block;
    width: 1.2rem;
    height: 1.2rem;
    margin: 0 auto 0.6rem;
    background-color: var(--sl-color-accent);
    -webkit-mask: var(--floral-mask-bloom) center / contain no-repeat;
    mask: var(--floral-mask-bloom) center / contain no-repeat;
    animation: floral-spin 1.8s linear infinite;
  }

  @media (prefers-reduced-motion: reduce) {
    .bangumi-surface,
    .bangumi-card,
    .bangumi-detail,
    .bangumi-toggle-icon,
    .bangumi-timeline-item,
    .bangumi-chip,
    .bangumi-pill,
    .bangumi-toggle-chip,
    .bangumi-message.is-pulse::before {
      animation: none !important;
      transition: none !important;
    }
  }

  @media (max-width: 980px) {
    .bangumi-timeline-scroll {
      max-height: 460px;
    }
  }

  @media (max-width: 768px) {
    .bangumi-page {
      padding: 0.1rem 0 2.5rem;
    }
    .bangumi-surface {
      padding: 1rem 1.05rem;
