---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
---

<StarlightPage
  frontmatter={{ title: 'Anime Reviews', template: 'splash', tableOfContents: false }}
  hasSidebar={false}
>
  <div class="bangumi-page not-content">
    <div class="bangumi-shell">
      <!-- 头部 Bangumi 专属概览与个人资料卡片 -->
      <header class="home-card bangumi-hero-card">
        <div class="bangumi-hero-inner">
          <div class="bangumi-user-profile">
            <a
              href="https://bgm.tv/user/duskydream"
              target="_blank"
              rel="noopener noreferrer"
              class="bangumi-user-avatar"
              title="前往 Lxzm 的 Bangumi 主页"
            >
              <img
                src="https://lain.bgm.tv/pic/user/l/000/85/16/851657_upVeN.jpg?r=1781703517&hd=1"
                alt="Lxzm (duskydream)"
                width="64"
                height="64"
                loading="eager"
              />
            </a>
            <div class="bangumi-user-info">
              <div class="bangumi-user-names">
                <h1 class="bangumi-user-name">Lxzm</h1>
                <span class="bangumi-user-handle">@duskydream</span>
                <span class="bangumi-user-badge">Bangumi 番组计划</span>
              </div>
              <p class="bangumi-user-sign">“Everything that rises must converge”</p>
            </div>
          </div>

          <div class="bangumi-hero-actions">
            <a
              href="https://bgm.tv/user/duskydream"
              target="_blank"
              rel="noopener noreferrer"
              class="home-quick-pill"
            >
              <span>✦ Bangumi 主页</span>
            </a>
            <a
              href="https://bgm.tv/feed/user/duskydream/timeline"
              target="_blank"
              rel="noopener noreferrer"
              class="home-quick-pill"
              title="订阅 Bangumi 时间胶囊 RSS"
            >
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 11a9 9 0 0 1 9 9"/><path d="M4 4a16 16 0 0 1 16 16"/><circle cx="5" cy="19" r="1"/></svg>
              <span>RSS 订阅</span>
            </a>
          </div>
        </div>

        <!-- 自我介绍 (Bio Panel) -->
        <div class="bangumi-user-intro-panel">
          <div class="bangumi-user-intro-header">
            <span class="bangumi-user-intro-icon">❀</span>
            <span class="bangumi-user-intro-title">自我介绍</span>
          </div>
          <div class="bangumi-user-intro-content">
            <p>杉菜水姫、松本文纪、深泽秀行、MANYO</p>
            <p>永久眷恋着天国的音乐妖精</p>
            <p>Innocent Grey、貴方へ捧ぐ戀紅色の花</p>
            <p>直观&gt;印象&gt;分析、随缘百合</p>
            <p>关于如何对抗遗忘</p>
          </div>
        </div>
      </header>

      <!-- 双栏卡片布局：左侧鉴赏收藏，右侧时间胶囊 -->
      <div class="bangumi-layout">
        <!-- 主栏：鉴赏收藏 -->
        <main class="bangumi-main-section">
          <section class="home-card bangumi-collections-card">
            <div class="home-card-head">
              <div class="home-card-head-left">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M7 3v18"/><path d="M3 7.5h4"/><path d="M3 12h18"/><path d="M3 16.5h4"/><path d="M17 3v18"/><path d="M17 7.5h4"/><path d="M17 16.5h4"/></svg>
                <span class="home-card-title">鉴赏收藏</span>
              </div>
              <div id="bangumi-meta" class="bangumi-meta-badge" aria-live="polite"></div>
            </div>

            <div class="bangumi-toolbar-inner">
              <div class="bangumi-search">
                <svg class="bangumi-search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
                <input
                  type="text"
                  id="bangumi-search"
                  aria-label="搜索动画或游戏"
                  placeholder="搜索动画 / 游戏..."
                  autocomplete="off"
                />
              </div>

              <div class="bangumi-filterbar">
                <div class="bangumi-filterbar-group">
                  <span class="bangumi-filterbar-label">类型</span>
                  <div class="bangumi-filterbar-options">
                    <button type="button" data-media="anime" class="bangumi-chip is-active">动画</button>
                    <button type="button" data-media="game" class="bangumi-chip">游戏</button>
                  </div>
                </div>

                <span class="bangumi-filterbar-divider" aria-hidden="true"></span>

                <div class="bangumi-filterbar-group bangumi-filterbar-group-status">
                  <span class="bangumi-filterbar-label">状态</span>
                  <div class="bangumi-filterbar-options bangumi-filterbar-options-status">
                    <button type="button" data-status="watching" class="bangumi-pill is-active">进行中</button>
                    <button type="button" data-status="wish" class="bangumi-pill">待补完</button>
                    <button type="button" data-status="watched" class="bangumi-pill">已完成</button>
                  </div>
                </div>
              </div>
            </div>

            <div class="home-card-body">
              <div id="bangumi-grid" class="bangumi-grid" aria-busy="false">
                <div class="bangumi-message is-pulse">加载中...</div>
              </div>
            </div>
          </section>
        </main>

        <!-- 侧栏：Bangumi 时间胶囊 -->
        <aside class="bangumi-aside-section">
          <section class="home-card home-card--timeline bangumi-timeline-card">
            <div class="home-card-head">
              <div class="home-card-head-left">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2v20"></path><path d="M5 7h14"></path><path d="M5 17h14"></path><circle cx="12" cy="7" r="2"></circle><circle cx="12" cy="17" r="2"></circle></svg>
                <span class="home-card-title">时间胶囊</span>
              </div>
              <a
                href="https://bgm.tv/feed/user/duskydream/timeline"
                target="_blank"
                rel="noopener noreferrer"
                class="bangumi-timeline-rss-btn"
                title="订阅时间胶囊 RSS"
              >
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 11a9 9 0 0 1 9 9"/><path d="M4 4a16 16 0 0 1 16 16"/><circle cx="5" cy="19" r="1"/></svg>
                <span>Feed</span>
              </a>
            </div>

            <div class="home-card-body bangumi-timeline-scroll">
              <div id="bangumi-timeline" class="bangumi-timeline" data-floral-vine='{"items": ".bangumi-timeline-item", "current": "", "vineX": 12, "meander": 3}'>
                <div class="bangumi-message is-pulse" style="padding: 1.5rem 0.5rem;">加载动态...</div>
              </div>
            </div>
          </section>
        </aside>
      </div>
    </div>
  </div>

  <script is:inline data-astro-rerun>
    (function initBangumiPage() {
    const API = '/bangumi';
    const STATIC_FALLBACK = '/data/bangumi.json';
    const CACHE_KEY = 'bangumi_cache_v3';
    const CLIENT_TTL = 30 * 60 * 1000;
    const MEDIA_SUBJECT_TYPE = { anime: 2, game: 4 };
    const MEDIA_LABEL = { anime: '动画', game: '游戏' };
    const STATUS_LABEL = { watching: '进行中', wish: '待补完', watched: '已完成' };

    const state = {
      mediaType: 'anime',
      status: 'watching',
      data: { watching: [], wish: [], watched: [], timeline: [] },
      expanded: null,
      isFetching: false,
      fetchAbortController: null,
    };

    const search = document.getElementById('bangumi-search');
    const gridArea = document.getElementById('bangumi-grid');
    const timelineArea = document.getElementById('bangumi-timeline');
    const resultsMeta = document.getElementById('bangumi-meta');
    const mediaButtons = [...document.querySelectorAll('.bangumi-chip')];
    const statusButtons = [...document.querySelectorAll('.bangumi-pill')];
    let searchTimer;

    if (!search || !gridArea || !resultsMeta) return;

    function escapeHTML(value) {
      return String(value)
        .replaceAll('&', '&amp;')
        .replaceAll('<', '&lt;')
        .replaceAll('>', '&gt;')
        .replaceAll('"', '&quot;')
        .replaceAll("'", '&#39;');
    }

    function safeImageURL(value) {
      try {
        const url = new URL(String(value), window.location.origin);
        return url.protocol === 'https:' ? escapeHTML(url.href) : '';
      } catch {
        return '';
      }
    }

    function readCache() {
      try {
        const raw = localStorage.getItem(CACHE_KEY);
        if (!raw) return null;
        const parsed = JSON.parse(raw);
        if (parsed.__cachedAt && Date.now() - parsed.__cachedAt < CLIENT_TTL) {
          return {
            watching: parsed.watching || [],
            wish: parsed.wish || [],
            watched: parsed.watched || [],
            timeline: parsed.timeline || [],
          };
        }
      } catch { /* ignore */ }
      return null;
    }

    function saveCache(payload) {
      try {
        localStorage.setItem(CACHE_KEY, JSON.stringify({ ...payload, __cachedAt: Date.now() }));
      } catch { /* ignore */ }
    }

    function normalizePayload(payload) {
      return {
        watching: Array.isArray(payload?.watching) ? payload.watching : [],
        wish: Array.isArray(payload?.wish) ? payload.wish : [],
        watched: Array.isArray(payload?.watched) ? payload.watched : [],
        timeline: Array.isArray(payload?.timeline) ? payload.timeline : [],
      };
    }

    function hasBangumiItems(payload) {
      return payload.watching.length > 0 || payload.wish.length > 0 || payload.watched.length > 0 || payload.timeline.length > 0;
    }

    function renderMessage(message, tone, pulse) {
      gridArea.innerHTML = '<div class="bangumi-message' + (tone === 'error' ? ' is-error' : '') + (pulse ? ' is-pulse' : '') + '">' + escapeHTML(message) + '</div>';
    }

    function setFetching(isFetching) {
      gridArea.setAttribute('aria-busy', String(isFetching));
      gridArea.dataset.fetching = String(isFetching);
    }

    async function requestJSON(url, signal, force = false) {
      const response = await fetch(url, { cache: force ? 'no-store' : 'default', signal });
      if (!response.ok) throw new Error('Request failed: ' + response.status);
      return response.json();
    }

    async function fetchData(force) {
      if (state.isFetching) return null;

      if (!force) {
        const cached = readCache();
        if (cached) {
          state.data = cached;
          render();
          return cached;
        }
      }

      state.isFetching = true;
      state.fetchAbortController = new AbortController();
      setFetching(true);

      try {
        const query = API + (force ? '?force=true' : '');
        const payload = normalizePayload(await requestJSON(query, state.fetchAbortController.signal, force));
        if (!hasBangumiItems(payload)) throw new Error('Empty Bangumi payload');
        state.data = payload;
        saveCache(state.data);
        render();
        return state.data;
      } catch (primaryError) {
        if (primaryError.name === 'AbortError') return null;
        try {
          const payload = normalizePayload(await requestJSON(STATIC_FALLBACK, state.fetchAbortController.signal, force));
          if (!hasBangumiItems(payload)) throw new Error('Empty Bangumi fallback payload');
          state.data = payload;
          saveCache(state.data);
          render();
          return state.data;
        } catch (fallbackError) {
          if (fallbackError.name === 'AbortError') return null;
          if (!state.data.watching.length && !state.data.wish.length && !state.data.watched.length) {
            renderMessage('无法加载数据，请检查网络连接后刷新页面', 'error');
          }
          return null;
        }
      } finally {
        state.isFetching = false;
        state.fetchAbortController = null;
        setFetching(false);
      }
    }

    function getFilteredList() {
      const source = state.data[state.status] || [];
      const typeFilter = MEDIA_SUBJECT_TYPE[state.mediaType];
      const keyword = search.value.toLowerCase().trim();

      return source
        .filter(item => item.subject?.type === typeFilter)
        .filter((item) => {
          if (!keyword) return true;
          const title = item.subject?.name_cn || item.subject?.name || '';
          return title.toLowerCase().includes(keyword);
        });
    }

    function updateResultsMeta(total) {
      const keyword = search.value.trim();
      const base = MEDIA_LABEL[state.mediaType] + ' · ' + STATUS_LABEL[state.status] + ' · ' + total + ' 项';
      resultsMeta.textContent = keyword ? base + ' · 关键词「' + keyword + '」' : base;
    }

    function getEmptyMessage() {
      if (search.value.trim()) return '没有找到匹配的内容';
      return '当前分类下还没有' + MEDIA_LABEL[state.mediaType] + '条目';
    }

    function renderStars(score) {
      const value = Number(score);
      if (!Number.isFinite(value) || value <= 0) return '';
      const filled = Math.max(0, Math.min(5, Math.round(value / 2)));
      let stars = '';
      for (let i = 0; i < 5; i++) {
        stars += '<span class="bangumi-star' + (i < filled ? ' is-filled' : '') + '" aria-hidden="true">✦</span>';
      }
      return '<span class="bangumi-score" aria-label="评分 ' + escapeHTML(value.toFixed(1)) + '">' +
        stars +
        '<span class="bangumi-score-value">' + escapeHTML(value.toFixed(1)) + '</span>' +
        '</span>';
    }

    function renderTags(tags) {
      const list = Array.isArray(tags) ? tags.filter(tag => tag && tag.name).slice(0, 5) : [];
      if (!list.length) return '';
      const pills = list.map(tag => '<span class="tag-pill">' + escapeHTML(tag.name) + '</span>').join('');
      const extra = tags.length > 5 ? '<span class="tag-pill tag-pill-more">+' + (tags.length - 5) + '</span>' : '';
      return '<div class="bangumi-tags">' + pills + extra + '</div>';
    }

    function renderCard(item, index) {
      const subject = item.subject || {};
      const id = Number(item.subject_id || subject.id || 0);
      const title = escapeHTML(subject.name_cn || subject.name || '未命名条目');
      const originalTitle = subject.name && subject.name !== subject.name_cn ? escapeHTML(subject.name) : '';
      const image = safeImageURL(subject.images?.medium || subject.images?.common || subject.images?.large || '');
      const rate = renderStars(item.rate || subject.score);
      const tags = renderTags(subject.tags);
      const comment = (item.comment || '').trim();
      const summary = (subject.summary || subject.short_summary || '').trim();
      const updated = item.updated_at ? escapeHTML(String(item.updated_at).slice(0, 10)) : '';
      const open = state.expanded === id;
      const hasReview = Boolean(comment);

      const flowerIcon = hasReview
        ? '<span class="bangumi-title-flower is-reviewed" title="已撰写心得评价">✿</span>'
        : '<span class="bangumi-title-flower" title="暂无评价">❀</span>';

      const coverHtml = image
        ? '<img src="' + image + '" alt="' + title + '" loading="lazy" decoding="async" />'
        : '<div class="bangumi-cover-placeholder">❀</div>';

      const previewText = hasReview
        ? '<p class="bangumi-preview">“' + escapeHTML(comment) + '”</p>'
        : (summary ? '<p class="bangumi-preview bangumi-no-review">' + escapeHTML(summary) + '</p>' : '<p class="bangumi-preview bangumi-no-review">暂无简介与评价</p>');

      const detailBody = hasReview
        ? '<div class="bangumi-review-box"><p>' + escapeHTML(comment) + '</p></div>' + (summary ? '<div class="bangumi-summary-box"><p>' + escapeHTML(summary) + '</p></div>' : '')
        : (summary ? '<div class="bangumi-summary-box"><p>' + escapeHTML(summary) + '</p></div>' : '<div class="bangumi-summary-box"><p>暂无完整简介</p></div>');

      return '<article class="bangumi-card' + (open ? ' is-open' : '') + '" data-card-id="' + id + '" style="--enter-index:' + index + ';">' +
        '<button type="button" class="bangumi-card-trigger" data-toggle-id="' + id + '" aria-expanded="' + String(open) + '">' +
        '<div class="bangumi-cover">' + coverHtml + '</div>' +
        '<div class="bangumi-card-info">' +
        '<h3>' + flowerIcon + '<span class="bangumi-title-text">' + title + '</span></h3>' +
        '<div class="bangumi-card-meta">' +
        rate +
        (updated ? '<span class="bangumi-date">' + updated + '</span>' : '') +
        '</div>' +
        previewText +
        tags +
        '<div class="bangumi-toggle-hint">' +
        '<span class="bangumi-toggle-text">' + (open ? '收起' : '展开详情') + '</span>' +
        '<svg class="bangumi-toggle-icon' + (open ? ' rotate-180' : '') + '" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>' +
        '</div>' +
        '</div>' +
        '</button>' +
        '<div class="bangumi-detail' + (open ? ' is-open' : '') + '">' +
        '<div class="bangumi-detail-inner">' +
        '<div class="bangumi-detail-panel">' +
        (originalTitle ? '<div class="bangumi-orig-title">原名：' + originalTitle + '</div>' : '') +
        detailBody +
        '<a href="https://bgm.tv/subject/' + id + '" target="_blank" rel="noopener noreferrer" class="bangumi-link">' +
        '<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 6H6a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>' +
        '<span>前往 Bangumi 条目</span>' +
        '</a>' +
        '</div>' +
        '</div>' +
        '</div>' +
        '</article>';
    }

    function syncControls() {
      mediaButtons.forEach((button) => {
        button.classList.toggle('is-active', button.dataset.media === state.mediaType);
      });
      statusButtons.forEach((button) => {
        button.classList.toggle('is-active', button.dataset.status === state.status);
      });
    }

    function renderCollection() {
      const list = getFilteredList();
      updateResultsMeta(list.length);

      if (!list.length) {
        gridArea.innerHTML = '<div class="bangumi-message">' + escapeHTML(getEmptyMessage()) + '</div>';
        return;
      }

      gridArea.innerHTML = list.map((item, index) => renderCard(item, index)).join('');
    }

    function renderTimeline() {
      if (!timelineArea) return;
      const list = Array.isArray(state.data.timeline) ? state.data.timeline : [];

      if (!list.length) {
        timelineArea.innerHTML = '<div class="bangumi-message" style="padding: 1.5rem 0.5rem; font-size: 0.85rem;">暂无时间胶囊记录</div>';
        return;
      }

      const actionColorMap = {
        '在玩': 'var(--sl-color-accent)',
        '在看': 'var(--sl-color-accent)',
        '在读': 'var(--sl-color-accent)',
        '看过': '#5f8fc2',
        '读过': '#5f8fc2',
        '玩过': '#5f8fc2',
        '想看': '#8fb2da',
        '想读': '#8fb2da',
        '想玩': '#8fb2da',
      };

      const itemsHtml = list.map((item, index) => {
        const action = item.action || '动态';
        const actionColor = actionColorMap[action] || 'var(--sl-color-accent)';
        const subjectUrl = item.subjectId ? 'https://bgm.tv/subject/' + item.subjectId : 'https://bgm.tv/user/duskydream/timeline';
        const displayName = escapeHTML(item.subjectNameCn || item.cleanTitle || item.title);
        const subName = (item.cleanTitle && item.cleanTitle !== item.subjectNameCn)
          ? '<span class="bangumi-timeline-sub">' + escapeHTML(item.cleanTitle) + '</span>'
          : '';

        return '<div class="bangumi-timeline-item" style="--i: ' + index + ';">' +
          '<div class="bangumi-timeline-meta">' +
          '<span class="bangumi-timeline-action" style="--action-color: ' + actionColor + ';">' + escapeHTML(action) + '</span>' +
          '<time class="bangumi-timeline-date">' + escapeHTML(item.dateFormatted || item.pubDate || '') + '</time>' +
          '</div>' +
          '<div class="bangumi-timeline-body">' +
          '<a href="' + subjectUrl + '" target="_blank" rel="noopener noreferrer" class="bangumi-timeline-link">' +
          displayName +
          '</a>' +
          subName +
          '</div>' +
          '</div>';
      }).join('');

      timelineArea.innerHTML = itemsHtml;

      if (typeof window.bindFloralVines === 'function') {
        window.bindFloralVines();
      }
    }

    function render() {
      renderCollection();
      renderTimeline();
    }

    function updateExpandedState(nextId) {
      const cards = gridArea.querySelectorAll('[data-card-id]');
      cards.forEach((card) => {
        const cardId = Number(card.getAttribute('data-card-id'));
        const open = cardId === nextId;
        card.classList.toggle('is-open', open);
        const trigger = card.querySelector('[data-toggle-id]');
        const detail = card.querySelector('.bangumi-detail');
        const icon = card.querySelector('.bangumi-toggle-icon');
        const text = card.querySelector('.bangumi-toggle-text');
        trigger?.setAttribute('aria-expanded', String(open));
        detail?.classList.toggle('is-open', open);
        icon?.classList.toggle('rotate-180', open);
        if (text) text.textContent = open ? '收起' : '展开详情';
      });
    }

    function setMediaType(type) {
      state.mediaType = type;
      state.expanded = null;
      syncControls();
      renderCollection();
    }

    function setStatus(status) {
      state.status = status;
      state.expanded = null;
      syncControls();
      renderCollection();
    }

    mediaButtons.forEach(button => button.addEventListener('click', () => setMediaType(button.dataset.media)));
    statusButtons.forEach(button => button.addEventListener('click', () => setStatus(button.dataset.status)));

    gridArea.addEventListener('click', (event) => {
      if (!(event.target instanceof Element)) return;
      const trigger = event.target.closest('[data-toggle-id]');
      if (!trigger) return;
      const nextId = Number(trigger.dataset.toggleId);
      state.expanded = state.expanded === nextId ? null : nextId;
      updateExpandedState(state.expanded);
    });

    search.addEventListener('input', () => {
      clearTimeout(searchTimer);
      searchTimer = setTimeout(() => {
        state.expanded = null;
        renderCollection();
      }, 180);
    });

    (async () => {
      syncControls();
      const cached = readCache();
      if (cached) {
        state.data = cached;
        render();
        void fetchData(true);
      } else {
        renderMessage('加载中...', 'muted', true);
        await fetchData(false);
      }
    })();
    
    document.addEventListener('astro:before-swap', () => {
      clearTimeout(searchTimer);
      state.fetchAbortController?.abort();
    }, { once: true });
    })();
  </script>

  <script>
    import { bindFloralVines } from "../utils/floral-vine";
    (window as any).bindFloralVines = bindFloralVines;
    bindFloralVines();
    document.addEventListener("astro:page-load", () => bindFloralVines());
  </script>
</StarlightPage>

<style is:global>
  .bangumi-page {
    max-width: min(78rem, 100%);
    margin: 0 auto;
    padding: 0.25rem 0.5rem 2.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    width: 100%;
    box-sizing: border-box;
  }

  .bangumi-shell {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  /* 头部 Profile 资料卡片 */
  .bangumi-hero-card {
    padding: 1.25rem 1.5rem;
  }

  .bangumi-hero-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    flex-wrap: wrap;
  }

  .bangumi-user-profile {
    display: flex;
    align-items: center;
    gap: 1rem;
    min-width: 0;
  }

  .bangumi-user-avatar {
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 50%;
    overflow: hidden;
    flex-shrink: 0;
    border: 2px solid color-mix(in srgb, var(--sl-color-accent) 35%, transparent);
    box-shadow: 0 0 12px color-mix(in srgb, var(--sl-color-accent) 15%, transparent);
    transition: transform 0.25s ease, border-color 0.25s ease;
    display: block;
  }

  .bangumi-user-avatar:hover {
    transform: scale(1.06);
    border-color: var(--sl-color-accent);
  }

  .bangumi-user-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .bangumi-user-info {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    min-width: 0;
  }

  .bangumi-user-names {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .bangumi-user-name {
    font-family: "Songti SC", "Source Han Serif SC", "STSong", serif;
    font-size: 1.35rem;
    font-weight: 600;
    color: var(--sl-color-white);
    margin: 0;
    line-height: 1.2;
  }

  .bangumi-user-handle {
    font-size: 0.8rem;
    color: var(--sl-color-gray-4);
  }

  .bangumi-user-badge {
    font-size: 0.68rem;
    padding: 0.08rem 0.45rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--sl-color-accent) 12%, transparent);
    color: var(--sl-color-accent);
    border: 1px solid color-mix(in srgb, var(--sl-color-accent) 25%, transparent);
  }

  .bangumi-user-sign {
    font-size: 0.84rem;
    color: var(--sl-color-accent);
    margin: 0;
    font-style: italic;
    letter-spacing: 0.02em;
  }

  .bangumi-hero-actions {
    display: flex;
    gap: 0.6rem;
    flex-wrap: wrap;
    align-items: center;
  }

