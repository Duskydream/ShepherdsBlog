---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import Floral from "../components/Floral.astro";
import LilyOrnament from "../components/LilyOrnament.astro";
import {
  countPostChars,
  estimateReadingMinutes,
  formatCharCount,
  formatIsoDate,
  getPostHref,
  getSortedPosts,
  getTagHref,
} from "../utils/content";
import { excerptOf } from "../utils/excerpt";

const posts = await getSortedPosts("blog");
const description = "散文、随想与翻译习作——把想说的话慢慢写成文章。";

const folios = posts.map((post, index) => {
  const chars = countPostChars(post.body);
  const minutes = estimateReadingMinutes(chars);
  const desc = post.data.description?.trim() ?? "";
  const bodyExcerpt = excerptOf(post.body, 115);
  const showBodyExcerpt = Boolean(bodyExcerpt && bodyExcerpt !== desc);
  const volume = String(posts.length - index).padStart(2, "0");
  return {
    post,
    chars,
    minutes,
    desc,
    bodyExcerpt: showBodyExcerpt ? bodyExcerpt : "",
    volume,
  };
});

const totalChars = folios.reduce((sum, item) => sum + item.chars, 0);
---

<StarlightPage
  frontmatter={{
    title: "散文 · Essay",
    description,
    template: "splash",
    tableOfContents: false,
  }}
  hasSidebar={false}
>
  <section class="essay-index not-content">
    <header class="essay-hero hananiwa-surface">
      <div class="essay-hero-decor" aria-hidden="true">
        <LilyOrnament id="essay-hero-lily" />
      </div>
      <div class="essay-hero-inner">
        <div class="essay-eyebrow">
          <Floral variant="bloom" size="0.72rem" class="essay-eyebrow-floral" />
          <span class="essay-eyebrow-text">ESSAY · LITERARY FOLIO</span>
        </div>
        <h1>散文</h1>
        <p class="essay-hero-desc">{description}</p>
        <div class="essay-colophon">
          <span class="essay-colophon-item">藏卷 {posts.length} 篇</span>
          <span class="essay-colophon-sep" aria-hidden="true">✦</span>
          <span class="essay-colophon-item">累计约 {formatCharCount(totalChars)}</span>
          <span class="essay-colophon-sep" aria-hidden="true">✦</span>
          <span class="essay-colophon-item">花庭文集</span>
        </div>
      </div>
    </header>

    <div class="essay-shelf">
      {
        folios.map(({ post, chars, minutes, desc, bodyExcerpt, volume }) => (
          <article class="essay-folio hananiwa-surface">
            <div class="essay-spine" aria-hidden="true">
              <Floral variant="bloom" size="0.72rem" class="essay-spine-floral" />
              <span class="essay-spine-vol">VOL. {volume}</span>
              <Floral variant="bud" size="0.58rem" class="essay-spine-bud" />
            </div>

            <div class="essay-page">
              <div class="essay-ribbon" aria-hidden="true" />
              <div class="essay-running-head">
                <div class="essay-running-left">
                  <span class="essay-folio-num">FOLIO {volume}</span>
                  {post.data.date && (
                    <time datetime={formatIsoDate(post.data.date)}>{formatIsoDate(post.data.date)}</time>
                  )}
                </div>
                <span class="essay-reading-stats">
                  {formatCharCount(chars)} · 约 {minutes} 分钟阅读
                </span>
              </div>

              <h2 class="essay-title">
                <a href={getPostHref(post)}>{post.data.title}</a>
              </h2>

              {post.data.author && (
                <div class="essay-author">
                  <Floral variant="bud" size="0.76em" class="essay-author-floral" />
                  <span>著 / 译 · {post.data.author}</span>
                </div>
              )}

              {(desc || bodyExcerpt) && (
                <div class="essay-epigraph">
                  {desc && <p class="essay-epigraph-quote">“{desc}”</p>}
                  {bodyExcerpt && <p class="essay-epigraph-excerpt">{bodyExcerpt}</p>}
                </div>
              )}

              <footer class="essay-folio-foot">
                <div class="essay-tags">
                  {post.data.tags?.map((tag: string) => (
                    <a href={getTagHref(tag)} class="essay-tag">
                      #{tag}
                    </a>
                  ))}
                </div>
                <span class="essay-open-cue" aria-hidden="true">
                  翻阅此卷 →
                </span>
              </footer>
            </div>
          </article>
        ))
      }
      {folios.length === 0 && <p class="essay-empty">暂无散文收录。</p>}
    </div>
  </section>

  <style>
    .essay-index {
      max-width: var(--hananiwa-width-index, 68rem);
      margin: 0 auto;
      padding: 2.25rem 0 4rem;
      box-sizing: border-box;
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
    }

    .essay-index p {
      margin: 0;
      text-align: start;
    }

    /* 扉页藏书票 Hero */
    .essay-hero {
      overflow: hidden;
      padding: 2rem 2.2rem 1.85rem;
    }

    .essay-hero-decor {
      position: absolute;
      right: -1.5rem;
      bottom: -2.25rem;
      width: min(36%, 16rem);
      opacity: 0.16;
      pointer-events: none;
      z-index: 0;
      transform: rotate(-8deg);
    }

    .essay-hero-inner {
      position: relative;
      z-index: 1;
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 0.7rem;
      max-width: 44rem;
    }

    .essay-eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 0.45rem;
    }

    .essay-eyebrow-floral {
      color: var(--sl-color-accent);
    }

    .essay-eyebrow-text {
      font-family: var(--sl-font-mono);
      font-size: 0.76rem;
      font-weight: 600;
      letter-spacing: 0.18em;
      color: var(--sl-color-accent-high);
      text-transform: uppercase;
    }

    .essay-hero h1 {
      margin: 0;
      font-family: var(--hananiwa-font-serif);
      color: var(--sl-color-white);
      font-size: clamp(2.35rem, 6vw, 3.35rem);
      font-weight: 600;
      line-height: 1.15;
      letter-spacing: 0.08em;
    }

    .essay-hero-desc {
      color: var(--sl-color-gray-3);
      font-size: 0.95rem;
      line-height: 1.65;
      letter-spacing: 0.03em;
    }

    .essay-colophon {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 0.4rem 0.65rem;
      margin-top: 0.35rem;
      padding-top: 0.8rem;
      width: 100%;
      border-top: 1px solid color-mix(in srgb, var(--sl-color-gray-6) 80%, transparent);
      font-family: var(--sl-font-mono);
      font-size: 0.74rem;
      color: var(--sl-color-gray-3);
    }

    .essay-colophon-sep {
      color: var(--sl-color-accent);
      opacity: 0.75;
    }

    /* 书卷装帧陈列 */
    .essay-shelf {
      display: flex;
      flex-direction: column;
      gap: 1.15rem;
    }

    .essay-folio {
      display: grid;
      grid-template-columns: 3.1rem minmax(0, 1fr);
      overflow: hidden;
      transition: border-color 0.22s ease, transform 0.22s ease, box-shadow 0.22s ease;
    }

    .essay-folio:hover {
      border-color: color-mix(in srgb, var(--sl-color-accent) 45%, var(--sl-color-gray-5));
      transform: translateY(-2px);
      box-shadow: 0 10px 28px color-mix(in srgb, var(--sl-color-accent) 10%, transparent);
    }

    /* 左侧线装书脊 */
    .essay-spine {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: space-between;
      padding: 1.15rem 0.4rem;
      background: linear-gradient(
        180deg,
        color-mix(in srgb, var(--sl-color-accent) 9%, var(--sl-color-bg)),
        color-mix(in srgb, var(--sl-color-accent) 4%, var(--sl-color-bg))
      );
      border-inline-end: 1px dashed color-mix(in srgb, var(--sl-color-accent) 36%, var(--sl-color-gray-5));
      box-shadow: inset -1px 0 0 color-mix(in srgb, var(--sl-color-gray-6) 55%, transparent);
      color: var(--sl-color-accent);
      user-select: none;
    }

    .essay-spine-vol {
      font-family: var(--sl-font-mono);
      font-size: 0.68rem;
      font-weight: 600;
      letter-spacing: 0.18em;
      color: var(--sl-color-gray-3);
      writing-mode: vertical-rl;
      text-orientation: mixed;
    }

    .essay-spine-bud {
      opacity: 0.7;
    }

    /* 主内页区域 */
    .essay-page {
      position: relative;
      display: flex;
      flex-direction: column;
      gap: 0.8rem;
      padding: 1.45rem 1.85rem 1.4rem;
      min-width: 0;
    }

    /* 右上角丝带书签 */
    .essay-ribbon {
      position: absolute;
      top: 0;
      right: 1.65rem;
      width: 1.15rem;
      height: 1.8rem;
      background: color-mix(in srgb, var(--sl-color-accent) 32%, transparent);
      border-inline: 1px solid color-mix(in srgb, var(--sl-color-accent) 45%, transparent);
      clip-path: polygon(0 0, 100% 0, 100% 100%, 50% 78%, 0 100%);
      pointer-events: none;
      transition: height 0.24s ease, background-color 0.24s ease;
    }

    .essay-folio:hover .essay-ribbon {
      height: 2.2rem;
      background: color-mix(in srgb, var(--sl-color-accent) 48%, transparent);
    }

    .essay-running-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 0.35rem 1rem;
      padding-inline-end: 2.1rem;
      font-family: var(--sl-font-mono);
      font-size: 0.72rem;
      color: var(--sl-color-gray-3);
    }

    .essay-running-left {
      display: inline-flex;
      align-items: center;
      gap: 0.65rem;
      flex-wrap: wrap;
    }

    .essay-folio-num {
      color: var(--sl-color-accent-high);
      font-weight: 600;
      letter-spacing: 0.1em;
    }

    .essay-title {
      margin: 0;
      font-family: var(--hananiwa-font-serif);
      font-size: clamp(1.22rem, 2.3vw, 1.48rem);
      font-weight: 600;
      line-height: 1.38;
      letter-spacing: 0.03em;
      color: var(--sl-color-white);
      overflow-wrap: anywhere;
    }

    .essay-title a {
      color: inherit;
      text-decoration: none;
      transition: color 0.18s ease;
    }

    .essay-title a::before {
      content: "";
      position: absolute;
      inset: 0;
      z-index: 1;
    }

    .essay-folio:hover .essay-title a,
    .essay-title a:hover {
      color: var(--sl-color-accent-high);
    }

    .essay-author {
      display: inline-flex;
      align-items: center;
      gap: 0.42rem;
      font-size: 0.82rem;
      color: var(--sl-color-gray-3);
    }

    .essay-author-floral {
      color: var(--sl-color-accent);
    }

    .essay-epigraph {
      border-inline-start: 2px solid color-mix(in srgb, var(--sl-color-accent) 55%, transparent);
      padding: 0.55rem 0.9rem;
      background: color-mix(in srgb, var(--sl-color-accent) 4.5%, transparent);
      border-radius: 0 var(--hananiwa-radius-sm, 0.6rem) var(--hananiwa-radius-sm, 0.6rem) 0;
      display: flex;
      flex-direction: column;
      gap: 0.35rem;
    }

    .essay-epigraph-quote {
      font-family: var(--hananiwa-font-serif);
      font-size: 0.94rem;
      font-style: italic;
      color: var(--sl-color-gray-1);
      line-height: 1.65;
    }

    .essay-epigraph-excerpt {
      font-size: 0.84rem;
      color: var(--sl-color-gray-3);
      line-height: 1.65;
      display: -webkit-box;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 2;
      overflow: hidden;
    }

    .essay-folio-foot {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.65rem 1rem;
      flex-wrap: wrap;
      margin-top: 0.25rem;
      padding-top: 0.75rem;
      border-top: 1px solid color-mix(in srgb, var(--sl-color-gray-6) 65%, transparent);
    }

    .essay-tags {
      display: flex;
      flex-wrap: wrap;
      gap: 0.4rem;
    }

    .essay-tag {
      position: relative;
      z-index: 2;
      padding: 0.14rem 0.56rem;
      border-radius: 999px;
      border: 1px solid var(--sl-color-gray-6);
      background: color-mix(in srgb, var(--sl-color-bg) 94%, var(--sl-color-accent) 6%);
      color: var(--sl-color-gray-2);
      font-family: var(--sl-font-mono);
      font-size: 0.7rem;
      text-decoration: none;
      transition: border-color 0.18s ease, color 0.18s ease, background-color 0.18s ease;
    }

    .essay-tag:hover {
      border-color: var(--sl-color-accent);
      color: var(--sl-color-accent-high);
      background: color-mix(in srgb, var(--sl-color-accent) 12%, transparent);
    }

    .essay-open-cue {
      font-size: 0.78rem;
      color: var(--sl-color-gray-3);
      font-family: var(--hananiwa-font-serif);
      transition: color 0.18s ease, transform 0.18s ease;
    }

    .essay-folio:hover .essay-open-cue {
      color: var(--sl-color-accent-high);
      transform: translateX(3px);
    }

    .essay-empty {
      color: var(--sl-color-gray-3);
      padding: 1.5rem 0;
    }

    @media (prefers-reduced-motion: reduce) {
      .essay-folio,
      .essay-ribbon,
      .essay-open-cue {
        transition: none !important;
      }
      .essay-folio:hover {
        transform: none;
      }
    }

    @media (max-width: 49.999rem) {
      .essay-index {
        padding: 1.35rem 0 3rem;
        gap: 1.15rem;
      }

      .essay-hero {
        padding: 1.4rem 1.25rem;
        border-radius: 1.1rem;
      }

      .essay-hero-decor {
        width: min(44%, 11rem);
        opacity: 0.12;
      }

      .essay-folio {
        grid-template-columns: 1fr;
        border-radius: 1.1rem;
      }

      .essay-spine {
        flex-direction: row;
        padding: 0.52rem 1.15rem;
        border-inline-end: none;
        border-bottom: 1px dashed color-mix(in srgb, var(--sl-color-accent) 36%, var(--sl-color-gray-5));
        box-shadow: inset 0 -1px 0 color-mix(in srgb, var(--sl-color-gray-6) 55%, transparent);
      }

      .essay-spine-vol {
        writing-mode: horizontal-tb;
        letter-spacing: 0.14em;
      }

      .essay-page {
        padding: 1.15rem 1.15rem 1.1rem;
      }

      .essay-ribbon {
        right: 1.1rem;
        height: 1.45rem;
      }
    }
  </style>
</StarlightPage>
