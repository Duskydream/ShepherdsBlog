---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import ContentTimeline from "../../components/ContentTimeline.astro";
import { getSortedPosts } from "../../utils/content";

export async function getStaticPaths() {
  const posts = await getSortedPosts();
  const tags = new Set<string>();
  posts.forEach((post) => post.data.tags?.forEach((tag: string) => tags.add(tag)));

  return Array.from(tags).map((tag) => ({
    params: { tag },
    props: { posts: posts.filter((post) => post.data.tags?.includes(tag)) },
  }));
}

const tag = Astro.params.tag ? decodeURIComponent(Astro.params.tag) : "";
const { posts } = Astro.props;
---

<StarlightPage
  frontmatter={{
    title: `Tag: #${tag}`,
    description: `Posts tagged with #${tag}（共 ${posts.length} 篇）。`,
    template: "splash",
    tableOfContents: false,
  }}
  hasSidebar={false}
>
  <section class="tag-timeline not-content">
    <header>
      <h1>Posts tagged with #{tag}</h1>
      <span class="tag-count">{posts.length} posts</span>
    </header>
    <div class="timeline-body"><ContentTimeline posts={posts} /></div>
  </section>

  <style>
    .tag-timeline {
      width: min(64rem, 100%);
      margin: 1.5rem auto 3rem;
      overflow: hidden;
      border: 1px solid var(--sl-color-gray-6);
      border-radius: 1rem;
      background: var(--sl-color-bg);
    }

    header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.75rem;
      padding: 0.75rem 1rem;
      border-bottom: 1px solid var(--sl-color-gray-6);
      color: var(--sl-color-white);
      font-size: 0.85rem;
      font-weight: 600;
    }

    header h1 {
      margin: 0;
      font-size: inherit;
      font-weight: inherit;
      line-height: inherit;
      color: inherit;
    }

    .tag-count {
      color: var(--sl-color-gray-4);
      font-size: 0.72rem;
      font-weight: 400;
      white-space: nowrap;
    }

    .timeline-body { padding: 0.75rem 1rem; }
  </style>
</StarlightPage>
