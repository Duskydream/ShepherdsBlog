---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import { getCollection } from "astro:content";
import ContentTimeline from "../../components/ContentTimeline.astro";

export async function getStaticPaths() {
  const allDocs = await getCollection("docs");
  const posts = allDocs.filter(
    (entry) =>
      (entry.id.startsWith("blog/") || entry.id.startsWith("log/") || entry.id.startsWith("coding-notes/")) &&
      !entry.id.endsWith("index.md")
  );
  const tags = new Set<string>();
  posts.forEach((post) => post.data.tags?.forEach((tag: string) => tags.add(tag)));

  return Array.from(tags).map((tag) => ({
    params: { tag },
    props: { posts: posts.filter((post) => post.data.tags?.includes(tag)) },
  }));
}

const tag = Astro.params.tag ? decodeURIComponent(Astro.params.tag) : "";
const { posts } = Astro.props;
---

<StarlightPage frontmatter={{ title: `Tag: #${tag}`, template: "splash", tableOfContents: false }} hasSidebar={false}>
  <section class="tag-timeline not-content">
    <header>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z" /><line x1="7" y1="7" x2="7.01" y2="7" />
      </svg>
      <span>Posts tagged with #{tag}</span>
    </header>
    <div class="timeline-body"><ContentTimeline posts={posts} /></div>
  </section>

  <style>
    .tag-timeline {
      width: min(70rem, 100%);
      margin: 1.5rem auto 3rem;
      overflow: hidden;
      border: 1px solid var(--sl-color-gray-6);
      border-radius: 1rem;
      background: var(--sl-color-bg);
    }

    header {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.75rem 1rem;
      border-bottom: 1px solid var(--sl-color-gray-6);
      color: var(--sl-color-white);
      font-size: 0.85rem;
      font-weight: 600;
    }

    header svg { color: var(--sl-color-gray-3); }
    .timeline-body { padding: 0.75rem 1rem; }
  </style>
</StarlightPage>
