      position: absolute;
      inset: 0;
      z-index: 1;
      pointer-events: none;
    }

    .home-hero-decor > :first-child {
      position: absolute;
      right: -12px;
      bottom: -14px;
      width: min(42%, 345px);
      opacity: 0.95;
    }

    .home-hero-decor > :last-child {
      position: absolute;
      left: -16px;
      top: 345px;
      width: min(40%, 320px);
      transform: scaleX(-1);
      opacity: 0.42;
    }

    .home-hero-content {
      position: relative;
      z-index: 2;
      padding: 2.5rem 2.5rem 2.5rem;
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: 1.6rem;
    }

    /* 岁星庭院风核心天体排版 */
    .home-hero-centerpiece {
      position: relative;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      width: 100%;
      max-width: 58rem;
      padding: 0.5rem 1rem 0.25rem;
    }

    /* 副标题标语 */
    .home-hero-motto-text {
      position: relative;
      z-index: 1;
      font-family: "Songti SC", "Source Han Serif SC", "STSong", serif;
      font-size: 1.15rem;
