---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import LilyOrnament from "../components/LilyOrnament.astro";
import HeroTitleBanner from "../components/HeroTitleBanner.astro";
import { getCollection } from "astro:content";
import { execSync } from "node:child_process";

import historicalCommits from "../data/git-commits.json";

const USER_AVATAR = "https://pic1.imgdb.cn/item/65c1c9269f345e8d03080e8d.jpg";

const blogPosts = await getCollection("docs", (entry) => entry.id.startsWith("blog/") && entry.id !== "blog/index.md");
const logPosts = await getCollection("docs", (entry) => entry.id.startsWith("log/") && entry.id !== "log/index.md");
const codingNotePosts = await getCollection(
  "docs",
  (entry) => entry.id.startsWith("coding-notes/") && entry.id !== "coding-notes/index.md",
);

const timelineSectionOrder = ["blog", "log", "coding-notes"];
const timelineSectionLabels = new Map([
  ["blog", "Essay"],
  ["log", "Log"],
  ["coding-notes", "Notes"],
]);

function timelineEntry(post: (typeof blogPosts)[number]) {
  const sectionSlug = post.id.split("/")[0];
  const section = timelineSectionLabels.get(sectionSlug) || sectionSlug;
  const sectionLevel = timelineSectionOrder.indexOf(sectionSlug) + 1;
  return { post, section, sectionSlug, sectionLevel };
}

const allPosts = [...blogPosts, ...logPosts, ...codingNotePosts];
const tagCounts = new Map<string, number>();

for (const post of allPosts) {
  const tags = post.data.tags || [];
  for (const tag of tags) {
    tagCounts.set(tag, (tagCounts.get(tag) || 0) + 1);
  }
}

const tagMaxCount = Math.max(...tagCounts.values(), 1);
const allTags = [...tagCounts.entries()]
  .map(([tag, count]) => {
    const ratio = count / tagMaxCount;
    const level = count === 1 ? 1 : Math.min(5, Math.ceil(ratio * 5));
    const size = 0.72 + ratio * 0.38;
    const fontWeight = 400 + Math.round(ratio * 3) * 100;
    return { tag, count, level, size, fontWeight };
  })
  .sort((a, b) => b.count - a.count || a.tag.localeCompare(b.tag));

function tagHref(value: string) {
  return `/tags/${encodeURIComponent(value)}`;
}

const contentTimeline = allPosts.map(timelineEntry)
  .sort((a, b) => {
    const dateA = a.post.data.date ? new Date(a.post.data.date).getTime() : 0;
    const dateB = b.post.data.date ? new Date(b.post.data.date).getTime() : 0;
    return dateB - dateA;
  });

const recentFragments = contentTimeline.slice(0, 8);

type CommitDay = {
  date: string;
  count: number;
  level: number;
};

let commitDays: CommitDay[] = [];
let commitTotal = 0;
let commitRangeLabel = "";

function parseLocalDate(date: string) {
  const [year, month, day] = date.split("-").map(Number);
  return new Date(year, month - 1, day);
}

function formatDate(date: Date) {
  const year = date.getFullYear();
  const month = String(date.getMonth() + 1).padStart(2, "0");
  const day = String(date.getDate()).padStart(2, "0");
  return `${year}-${month}-${day}`;
}

const commitCounts = new Map<string, number>();

// 1. 载入完整的历史 commit 数据集（包含 2024 年至今重构前的所有历史）
for (const [date, count] of Object.entries(historicalCommits as Record<string, number>)) {
  commitCounts.set(date, count);
}

// 2. 尝试从本地 git log --all 合并最新增量提交，确保本地与部署永远展示最完整历史
try {
  const output = execSync("git log --all --format=%ad --date=short", {
    cwd: process.cwd(),
    encoding: "utf-8",
    stdio: ["ignore", "pipe", "ignore"],
    timeout: 3000,
    maxBuffer: 4 * 1024 * 1024,
  });
  const runtimeCounts = new Map<string, number>();
  for (const date of output.split(/\r?\n/).filter(Boolean)) {
    runtimeCounts.set(date, (runtimeCounts.get(date) || 0) + 1);
  }
  for (const [date, count] of runtimeCounts.entries()) {
    commitCounts.set(date, Math.max(commitCounts.get(date) || 0, count));
  }
} catch {
  // 部署环境即使是浅克隆（shallow clone），也会直接使用完整的历史数据集
}

const START_FILTER_DATE = "2025-09-01";
const sortedDates = [...commitCounts.keys()].filter((d) => d >= START_FILTER_DATE).sort();

if (sortedDates.length > 0) {
  const firstDate = parseLocalDate(START_FILTER_DATE);
  const lastDate = parseLocalDate(sortedDates[sortedDates.length - 1]);
  const startDate = new Date(firstDate);
  startDate.setDate(startDate.getDate() - startDate.getDay());
  const endDate = new Date(lastDate);
  endDate.setDate(endDate.getDate() + (6 - endDate.getDay()));

  const rangeCounts: number[] = [];
  for (const day = new Date(startDate); day <= endDate; day.setDate(day.getDate() + 1)) {
    const date = formatDate(day);
    if (date >= START_FILTER_DATE) {
      rangeCounts.push(commitCounts.get(date) || 0);
    }
  }
  const maxCount = Math.max(...rangeCounts, 1);

  for (const day = new Date(startDate); day <= endDate; day.setDate(day.getDate() + 1)) {
    const date = formatDate(day);
    const count = date >= START_FILTER_DATE ? (commitCounts.get(date) || 0) : 0;
    const level = count === 0 ? 0 : Math.max(1, Math.ceil((count / maxCount) * 4));
    commitDays.push({ date, count, level });
    if (date >= START_FILTER_DATE) {
      commitTotal += count;
    }
  }

  commitRangeLabel = `${START_FILTER_DATE} - ${sortedDates[sortedDates.length - 1]}`;
}
---

<StarlightPage frontmatter={{ title: "祈りの花庭", template: "splash", tableOfContents: false }} hasSidebar={false}>
  <div class="home-dashboard not-content">
    <!-- Hero / Profile -->
    <section class="home-hero">
      <div class="home-hero-decor" aria-hidden="true">
        <LilyOrnament id="lily-br" />
        <LilyOrnament id="lily-tl" />
      </div>

      <div class="home-hero-content">
        <div class="home-hero-centerpiece">
          <!-- 核心艺术标题（代码级矢量重构与动效编排） -->
          <HeroTitleBanner />

          <!-- 副标题标语 -->
          <p class="home-hero-motto-text">
            如花四散，余香绕指，心中的裂痕亦能被填补。
          </p>
        </div>

        <!-- 作者信息卡与快捷链接 -->
        <div class="home-hero-profile-bar">
          <div class="home-hero-profile-left">
            <a href="/about" class="home-hero-avatar" title="关于我 · About">
              <img src={USER_AVATAR} alt="Shepherd" width="56" height="56" loading="eager" fetchpriority="high" decoding="async" />
            </a>
            <div class="home-hero-info">
              <a href="/about" class="home-hero-author-name-link" title="关于我 · About">
                <span class="home-hero-author-name">Shepherd</span>
              </a>
              <span class="home-hero-author-bio">AI Undergraduate</span>
            </div>
          </div>

          <div class="home-hero-nav-wrapper">
            <div class="home-hero-about-subrow">
              <a href="/about" class="home-hero-about-link" title="关于Shepherd和祈りの花庭">
                <span class="about-sub-text">关于Shepherd和祈りの花庭</span>
                <span class="about-sub-en">ABOUT</span>
                <svg class="about-arrow" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </a>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- SELECTED FRAGMENTS 精选与近作列表流 -->
    <section class="home-fragments-section">
      <div class="home-fragments-header">
        <div class="home-fragments-title-group">
          <span class="home-fragments-tag">SELECTED FRAGMENTS</span>
          <span class="home-fragments-dot" aria-hidden="true"></span>
        </div>
        <span class="home-fragments-subtitle">近作与沉思</span>
      </div>

      <div class="home-fragments-list">
        {
          recentFragments.map(({ post, section }) => {
            const postYear = post.data.date ? new Date(post.data.date).getFullYear() : "2026";
            const postMonth = post.data.date ? String(new Date(post.data.date).getMonth() + 1).padStart(2, "0") : "01";
            const postDay = post.data.date ? String(new Date(post.data.date).getDate()).padStart(2, "0") : "01";
            const formattedDate = `${postMonth}.${postDay}`;
            const tags = Array.isArray(post.data.tags) ? post.data.tags.slice(0, 2) : [];

            return (
              <a href={`/${post.id}`} class="home-fragment-row">
                <span class="home-fragment-year">{postYear}</span>
                <span class="home-fragment-title">{post.data.title}</span>
                <div class="home-fragment-meta">
                  {tags.map((t: string) => (
                    <span class="home-fragment-tag">{t}</span>
                  ))}
                  <span class="home-fragment-section">{section}</span>
                  <time class="home-fragment-date">{formattedDate}</time>
                </div>
              </a>
            );
          })
        }
      </div>

      <div class="home-fragments-more">
        <a href="/article" class="home-fragments-more-btn">
          <span>查看全部篇章</span>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      </div>
    </section>

    <!-- 中部双栏：Commit Wall & Tags -->
    <div class="home-grid-two">
      <!-- Commit Mosaic -->
      <section class="home-card home-card--commits">
        <div class="home-card-head">
          <div class="home-card-head-left">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"></rect><path d="M16 2v4"></path><path d="M8 2v4"></path><path d="M3 10h18"></path></svg>
            <span>Commit Mosaic</span>
          </div>
          {
            commitRangeLabel && (
              <span class="home-commit-range">
                {commitTotal} commits · {commitRangeLabel}
              </span>
            )
          }
        </div>
        <div class="home-card-body">
          {
            commitDays.length > 0 ? (
              <div class="home-commit-wall" aria-label="Git commit activity">
                {commitDays.map((day) => (
                  <span
                    class="home-commit-cell"
                    data-level={day.level}
                    title={`${day.date}: ${day.count} commit${day.count === 1 ? "" : "s"}`}
                    aria-label={`${day.date}: ${day.count} commit${day.count === 1 ? "" : "s"}`}
                  />
                ))}
              </div>
            ) : (
              <p class="home-commit-empty">No local git history available</p>
            )
          }
        </div>
      </section>

      <!-- Tags Cloud -->
      <section class="home-card home-card--tags">
        <div class="home-card-head">
          <div class="home-card-head-left">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path><line x1="7" y1="7" x2="7.01" y2="7"></line></svg>
            <span>Tags ({allTags.length})</span>
          </div>
        </div>
        <div class="home-card-body">
          <div class="home-tags-container">
            {
              allTags.map(({ tag, count, level, size, fontWeight }) => (
                <a
                  href={tagHref(tag)}
                  class="home-tag"
                  data-level={level}
                  style={`--tag-size: ${size.toFixed(2)}rem; --tag-font-weight: ${fontWeight}`}
                  title={`${count} article${count === 1 ? "" : "s"}`}
                  aria-label={`#${tag}, ${count} article${count === 1 ? "" : "s"}`}
                >
                  #{tag}
                </a>
              ))
            }
          </div>
        </div>
      </section>
    </div>
  </div>

  <style is:global>
    .home-dashboard {
      max-width: min(82rem, 100%);
      margin: 0 auto;
      padding: 0.35rem 0.75rem 3.5rem;
      display: flex;
      flex-direction: column;
      gap: 2rem;
      width: 100%;
      box-sizing: border-box;
      font-size: 1.1rem;
    }

    .home-dashboard > * {
      margin-block: 0;
    }

    /* 1. Hero 区域 */
    .home-hero {
      position: relative;
