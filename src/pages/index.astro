---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import LilyOrnament from "../components/LilyOrnament.astro";
import HeroTitleBanner from "../components/HeroTitleBanner.astro";
import {
  getSortedPosts,
  getSectionMeta,
  getPostHref,
  getTagHref,
  formatIsoDate,
  collectTagStats,
} from "../utils/content";

import historicalCommits from "../data/git-commits.json";
import imageManifest from "../data/image-manifest.json";

// 见 src/pages/about.astro：换成 scripts/build-images.mjs 生成的本地 WebP 变体。
const USER_AVATAR_URL = "https://pic1.imgdb.cn/item/65c1c9269f345e8d03080e8d.jpg";
const USER_AVATAR = imageManifest[USER_AVATAR_URL];

const allPosts = await getSortedPosts();
const allTags = collectTagStats(allPosts);

const recentFragments = allPosts.slice(0, 8).map((post) => {
  const { sectionLabel: section } = getSectionMeta(post.id);
  return { post, section };
});

const sectionQuickLinks = [
  { label: "散文随笔", href: "/article" },
  { label: "月累笔记", href: "/notes" },
  { label: "日常记录", href: "/log" },
  { label: "全部标签", href: "/tags" },
];

type CommitDay = {
  date: string;
  count: number;
  level: number;
};

type CommitYearGroup = {
  year: string;
  total: number;
  rangeLabel: string;
  days: CommitDay[];
};

function parseLocalDate(date: string) {
  const [year, month, day] = date.split("-").map(Number);
  return new Date(year, month - 1, day);
}

function formatDate(date: Date) {
  const year = date.getFullYear();
  const month = String(date.getMonth() + 1).padStart(2, "0");
  const day = String(date.getDate()).padStart(2, "0");
  return `${year}-${month}-${day}`;
}

const commitCounts = new Map<string, number>();

// 索引 commit 热力图的数据来自 src/data/git-commits.json。
for (const [date, count] of Object.entries(historicalCommits as Record<string, number>)) {
  commitCounts.set(date, count);
}

const sortedDates = [...commitCounts.keys()].sort();
const globalMaxCount = Math.max(...commitCounts.values(), 1);

function buildCommitWindow(startStr: string, endStr: string, maxCount: number) {
  const firstDate = parseLocalDate(startStr);
  const lastDate = parseLocalDate(endStr);
  const startDate = new Date(firstDate);
  startDate.setDate(startDate.getDate() - startDate.getDay());
  const endDate = new Date(lastDate);
  endDate.setDate(endDate.getDate() + (6 - endDate.getDay()));

  const days: CommitDay[] = [];
  let total = 0;

  for (const day = new Date(startDate); day <= endDate; day.setDate(day.getDate() + 1)) {
    const date = formatDate(day);
    const inRange = date >= startStr && date <= endStr;
    const count = inRange ? (commitCounts.get(date) || 0) : 0;
    const level = count === 0 ? 0 : Math.max(1, Math.ceil((count / maxCount) * 4));
    days.push({ date, count, level });
    if (inRange) {
      total += count;
    }
  }

  return {
    days,
    total,
    rangeLabel: `${startStr} - ${endStr}`,
  };
}

let recentCommitDays: CommitDay[] = [];
let recentCommitTotal = 0;
let recentRangeLabel = "";

let allCommitTotal = 0;
let allRangeLabel = "";
let commitYearGroups: CommitYearGroup[] = [];

if (sortedDates.length > 0) {
  const earliestStr = sortedDates[0];
  const latestStr = sortedDates[sortedDates.length - 1];
  const earliestDate = parseLocalDate(earliestStr);
  const latestDate = parseLocalDate(latestStr);

  // 默认折叠态：最近 12 个月（365 天窗口）
  const recentWindowStart = new Date(latestDate);
  recentWindowStart.setDate(recentWindowStart.getDate() - 364);
  const effectiveRecentStart = recentWindowStart > earliestDate ? recentWindowStart : earliestDate;
  const recentStartStr = formatDate(effectiveRecentStart);

  const recentWindow = buildCommitWindow(recentStartStr, latestStr, globalMaxCount);
  recentCommitDays = recentWindow.days;
  recentCommitTotal = recentWindow.total;
  recentRangeLabel = recentWindow.rangeLabel;

  // 展开态：全部历史提交（按年份分组展示，包含 2024-03-17 起的所有记录）
  for (const count of commitCounts.values()) {
    allCommitTotal += count;
  }
  allRangeLabel = `${earliestStr} - ${latestStr}`;

  const years = [...new Set(sortedDates.map((d) => d.slice(0, 4)))].sort().reverse();
  commitYearGroups = years.map((year) => {
    const yearDates = sortedDates.filter((d) => d.startsWith(`${year}-`));
    const yearStart = year === earliestStr.slice(0, 4) ? earliestStr : `${year}-01-01`;
    const yearEnd = year === latestStr.slice(0, 4) ? latestStr : `${year}-12-31`;
    const win = buildCommitWindow(yearStart, yearEnd, globalMaxCount);
    const activeRange = `${yearDates[0]} - ${yearDates[yearDates.length - 1]}`;
    return {
      year,
      total: win.total,
      rangeLabel: activeRange,
      days: win.days,
    };
  });
}
---

<StarlightPage frontmatter={{ title: "祈りの花庭", template: "splash", tableOfContents: false }} hasSidebar={false}>
  <div class="home-dashboard not-content">
    <!-- Hero / Profile -->
    <section class="home-hero">
      <div class="home-hero-decor" aria-hidden="true">
        <div class="home-hero-lily home-hero-lily--br">
          <LilyOrnament id="lily-br" />
        </div>
        <div class="home-hero-lily home-hero-lily--tl">
          <LilyOrnament id="lily-tl" />
        </div>
      </div>

      <div class="home-hero-content">
        <div class="home-hero-centerpiece">
          <!-- 核心艺术标题（代码级矢量重构与动效编排） -->
          <HeroTitleBanner />

          <!-- 副标题标语 -->
          <p class="home-hero-motto-text">
            如花四散，余香绕指，心中的裂痕亦能被填补。
          </p>
        </div>

        <!-- 作者信息卡与快捷链接 -->
        <div class="home-hero-profile-bar">
          <div class="home-hero-profile-left">
            <a href="/about" class="home-hero-avatar" title="关于我 · About">
              <img src={USER_AVATAR?.src ?? USER_AVATAR_URL} srcset={USER_AVATAR?.srcset} sizes={USER_AVATAR ? "56px" : undefined} alt="Shepherd" width="56" height="56" loading="eager" fetchpriority="high" decoding="async" />
            </a>
            <div class="home-hero-info">
              <a href="/about" class="home-hero-author-name-link" title="关于我 · About">
                <span class="home-hero-author-name">Shepherd</span>
              </a>
              <span class="home-hero-author-bio">AI Undergraduate</span>
            </div>
          </div>

          <div class="home-hero-nav-wrapper">
            <div class="home-hero-about-subrow">
              <a href="/about" class="home-hero-about-link" title="关于Shepherd和祈りの花庭">
                <span class="about-sub-text">关于Shepherd和祈りの花庭</span>
                <span class="about-sub-en">ABOUT</span>
                <svg class="about-arrow" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- SELECTED FRAGMENTS 精选与近作列表流 -->
    <section class="home-fragments-section hananiwa-surface">
      <div class="home-fragments-header">
        <div class="home-fragments-title-group">
          <span class="home-fragments-dot" aria-hidden="true"></span>
          <span class="home-fragments-tag">SELECTED FRAGMENTS</span>
        </div>
        <span class="home-fragments-subtitle">近作与沉思</span>
      </div>

      <div class="home-fragments-list">
        {
          recentFragments.map(({ post, section }) => {
            const isoDate = formatIsoDate(post.data.date);
            const postYear = isoDate ? isoDate.slice(0, 4) : "2026";
            const formattedDate = isoDate ? `${isoDate.slice(5, 7)}.${isoDate.slice(8, 10)}` : "01.01";
            const tags = Array.isArray(post.data.tags) ? post.data.tags.slice(0, 2) : [];

            return (
              <a href={getPostHref(post)} class="home-fragment-row">
                <span class="home-fragment-year">{postYear}</span>
                <span class="home-fragment-title">{post.data.title}</span>
                <div class="home-fragment-meta">
                  {tags.map((t: string) => (
                    <span class="home-fragment-tag">{t}</span>
                  ))}
                  <span class="home-fragment-section">{section}</span>
                  <time class="home-fragment-date" datetime={isoDate || undefined}>{formattedDate}</time>
                </div>
              </a>
            );
          })
        }
      </div>

      <nav class="home-fragments-more" aria-label="按栏目浏览全部篇章">
        {
          sectionQuickLinks.map((item) => (
            <a href={item.href} class="home-fragments-more-btn">
              <span>{item.label}</span>
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>
          ))
        }
      </nav>
    </section>

    <!-- 中部双栏：Commit Wall & Tags -->
    <div class="home-grid-two">
      <!-- Commit Mosaic -->
      <section class="home-card home-card--commits hananiwa-surface" id="home-commit-card" data-expanded="false">
        <div class="home-card-head">
          <div class="home-card-head-left">
            <span class="home-card-dot" aria-hidden="true"></span>
            <span class="home-card-head-en">COMMIT MOSAIC</span>
          </div>
          {
            recentRangeLabel && (
              <span
                class="home-commit-range"
                id="home-commit-range"
                data-recent-label={`${recentCommitTotal} commits · ${recentRangeLabel}`}
                data-all-label={`${allCommitTotal} commits · ${allRangeLabel}`}
              >
                {recentCommitTotal} commits · {recentRangeLabel}
              </span>
            )
          }
        </div>
        <div class="home-card-body home-commit-body">
          {
            recentCommitDays.length > 0 ? (
              <>
                <!-- 默认折叠视图：近 12 个月 -->
                <div class="home-commit-recent" id="home-commit-recent">
                  <div
                    class="home-commit-wall"
                    role="img"
                    aria-label={`近 12 个月 Git 提交记录: ${recentCommitTotal} commits (${recentRangeLabel})`}
                  >
                    {recentCommitDays.map((day) => (
                      <span
                        class="home-commit-cell"
                        data-level={day.level > 0 ? day.level : undefined}
                        title={`${day.date}: ${day.count} commit${day.count === 1 ? "" : "s"}`}
                      />
                    ))}
                  </div>
                </div>

                <!-- 展开视图：完整历史年份归档 -->
                <div class="home-commit-archive" id="home-commit-archive" hidden>
                  {commitYearGroups.map((group) => (
                    <div class="home-commit-year-block" data-year={group.year}>
                      <div class="home-commit-year-head">
                        <span class="home-commit-year-title">{group.year}</span>
                        <span class="home-commit-year-meta">{group.total} commits · {group.rangeLabel}</span>
                      </div>
                      <div
                        class="home-commit-wall"
                        role="img"
                        aria-label={`${group.year} 年 Git 提交记录: ${group.total} commits (${group.rangeLabel})`}
                      >
                        {group.days.map((day) => (
                          <span
                            class="home-commit-cell"
                            data-level={day.level > 0 ? day.level : undefined}
                            title={`${day.date}: ${day.count} commit${day.count === 1 ? "" : "s"}`}
                          />
                        ))}
                      </div>
                    </div>
                  ))}
                </div>

                <div class="home-commit-footer">
                  <button
                    type="button"
                    class="home-commit-toggle"
                    id="home-commit-toggle"
                    aria-expanded="false"
                    aria-controls="home-commit-archive"
                    data-expand-text={`展开全部 (${allCommitTotal} commits · 2024–2026)`}
                    data-collapse-text="收起（仅看近 12 个月）"
                  >
                    <span class="home-commit-toggle-text">展开全部 ({allCommitTotal} commits · 2024–2026)</span>
                    <svg class="home-commit-toggle-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
                  </button>
                </div>
              </>
            ) : (
              <p class="home-commit-empty">No local git history available</p>
            )
          }
        </div>
      </section>

      <!-- Tags Cloud -->
      <section class="home-card home-card--tags hananiwa-surface">
        <div class="home-card-head">
          <div class="home-card-head-left">
            <span class="home-card-dot" aria-hidden="true"></span>
            <span class="home-card-head-en">TAGS ({allTags.length})</span>
          </div>
          <a href="/tags/" class="home-card-head-link">
            <span>全部标签</span>
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
        </div>
        <div class="home-card-body">
          <div class="home-tags-container">
            {
              allTags.map(({ tag, count, level, size, fontWeight }) => (
                <a
                  href={getTagHref(tag)}
                  class="home-tag"
                  data-level={level}
                  style={`--tag-size: ${size.toFixed(2)}rem; --tag-font-weight: ${fontWeight}`}
                  title={`${count} 篇文章`}
                  aria-label={`#${tag}，共 ${count} 篇文章`}
                >
                  #{tag}
                </a>
              ))
            }
          </div>
        </div>
      </section>
    </div>
  </div>

  <script>
    function initCommitMosaicToggle() {
      const toggle = document.getElementById("home-commit-toggle") as HTMLButtonElement | null;
      const card = document.getElementById("home-commit-card");
      const recentEl = document.getElementById("home-commit-recent");
      const archiveEl = document.getElementById("home-commit-archive");
      const rangeEl = document.getElementById("home-commit-range");
      if (!toggle || !card || !recentEl || !archiveEl) return;
      if (toggle.dataset.bound === "true") return;
      toggle.dataset.bound = "true";

      toggle.addEventListener("click", () => {
        const nextExpanded = toggle.getAttribute("aria-expanded") !== "true";
        toggle.setAttribute("aria-expanded", String(nextExpanded));
        card.setAttribute("data-expanded", String(nextExpanded));
        recentEl.hidden = nextExpanded;
        archiveEl.hidden = !nextExpanded;

        const textEl = toggle.querySelector(".home-commit-toggle-text");
        if (textEl) {
          textEl.textContent = nextExpanded
            ? (toggle.dataset.collapseText || "收起（仅看近 12 个月）")
            : (toggle.dataset.expandText || "展开全部");
        }

        if (rangeEl) {
          rangeEl.textContent = nextExpanded
            ? (rangeEl.dataset.allLabel || rangeEl.textContent)
            : (rangeEl.dataset.recentLabel || rangeEl.textContent);
        }
      });
    }

    initCommitMosaicToggle();
    document.addEventListener("astro:page-load", initCommitMosaicToggle);
  </script>

  <style>
    .home-dashboard {
      max-width: min(82rem, 100%);
      margin: 0 auto;
      padding: 0.35rem 0.75rem 3.5rem;
      display: flex;
      flex-direction: column;
      gap: 2rem;
      width: 100%;
      box-sizing: border-box;
      font-size: 1.1rem;
    }

    .home-dashboard > * {
      margin-block: 0;
    }

    .home-dashboard p {
      margin: 0;
    }

    /* 1. Hero 区域 */
    .home-hero {
      position: relative;
      border-radius: var(--hananiwa-radius-lg, 1.25rem);
      overflow: hidden;
      background: var(--sl-color-bg);
      border: 1px solid var(--sl-color-gray-6);
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);
    }

    .home-hero-decor {
      position: absolute;
      inset: 0;
      z-index: 1;
      pointer-events: none;
    }

    .home-hero-lily--br {
      position: absolute;
      right: -12px;
      bottom: -14px;
      width: min(42%, 345px);
      opacity: 0.95;
    }

    .home-hero-lily--tl {
      position: absolute;
      left: -16px;
      top: 345px;
      width: min(40%, 320px);
      transform: scaleX(-1);
      opacity: 0.42;
    }

    .home-hero-content {
      position: relative;
      z-index: 2;
      padding: 2.5rem 2.5rem 2.5rem;
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: 1.6rem;
    }

    /* 岁星庭院风核心天体排版 */
    .home-hero-centerpiece {
      position: relative;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      width: 100%;
      max-width: 58rem;
      padding: 0.5rem 1rem 0.25rem;
    }

    /* 副标题标语 */
    .home-dashboard .home-hero-motto-text {
      position: relative;
      z-index: 1;
      font-family: var(--hananiwa-font-serif, "Songti SC", "Source Han Serif SC", "Noto Serif CJK SC", "STSong", Georgia, serif);
      font-size: 1.15rem;
      color: var(--sl-color-gray-2);
      letter-spacing: 0.08em;
      line-height: 1.6;
      margin: 0;
      text-align: center !important;
      animation: hero-fade-up 1.1s cubic-bezier(0.16, 1, 0.3, 1) 0.3s both;
    }

    @keyframes hero-fade-up {
      from {
        opacity: 0;
        transform: translateY(12px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .home-hero-profile-bar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1.5rem;
      width: 100%;
      max-width: 58rem;
      padding: 0.95rem 1.6rem;
      background: color-mix(in srgb, var(--sl-color-accent) 4%, transparent);
      border: 1px solid var(--sl-color-gray-6);
      border-radius: 1rem;
      backdrop-filter: blur(8px);
      flex-wrap: wrap;
    }

    .home-hero-profile-left {
      display: flex;
      align-items: center;
      gap: 0.85rem;
    }

    .home-hero-avatar {
      width: 3.2rem;
      height: 3.2rem;
      border-radius: 50%;
      overflow: hidden;
      border: 2px solid var(--sl-color-accent);
      box-shadow: 0 0 16px color-mix(in srgb, var(--sl-color-accent) 30%, transparent);
      transition: all 0.3s ease;
      flex-shrink: 0;
      display: block;
      cursor: pointer;
    }

    .home-hero-avatar:hover {
      transform: scale(1.08);
      box-shadow: 0 0 22px color-mix(in srgb, var(--sl-color-accent) 50%, transparent);
      border-color: var(--sl-color-accent-high);
    }

    .home-hero-avatar img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    .home-hero-info {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 0.15rem;
      text-align: left;
    }

    .home-hero-author-name-link {
      text-decoration: none !important;
    }

    .home-hero-author-name {
      font-family: var(--hananiwa-font-serif, "Songti SC", "Source Han Serif SC", "Noto Serif CJK SC", "STSong", Georgia, serif);
      font-size: 1.05rem;
      font-weight: 600;
      color: var(--sl-color-white);
      line-height: 1.2;
      transition: color 0.2s ease;
    }

    .home-hero-author-name-link:hover .home-hero-author-name {
      color: var(--sl-color-accent-high);
    }

    .home-hero-author-bio {
      font-size: 0.78rem;
      color: var(--sl-color-gray-3);
      line-height: 1.2;
    }

    .home-hero-nav-wrapper {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.55rem;
    }

    .home-hero-about-subrow {
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .home-hero-about-link {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.15rem 0.1rem;
      font-size: 0.75rem;
      color: var(--sl-color-gray-3);
      text-decoration: none !important;
      transition: color 0.25s ease;
      letter-spacing: 0.03em;
    }

    .home-hero-about-link:hover {
      color: var(--sl-color-accent-high);
    }

    .about-sub-text {
      font-family: var(--hananiwa-font-serif, "Songti SC", "Source Han Serif SC", "Noto Serif CJK SC", "STSong", Georgia, serif);
      font-size: 0.78rem;
      letter-spacing: 0.04em;
    }

    .about-sub-en {
      font-family: var(--sl-font-mono);
      font-size: 0.65rem;
      opacity: 0.75;
      letter-spacing: 0.08em;
    }

    /* 2. SELECTED FRAGMENTS 精选文章流 */
    .home-fragments-section {
      background: var(--sl-color-bg);
      border: 1px solid var(--sl-color-gray-6);
      border-radius: var(--hananiwa-radius-lg, 1.25rem);
      padding: 1.5rem 2rem 1.75rem;
      display: flex;
      flex-direction: column;
      gap: 1rem;
      transition: border-color 0.2s ease;
    }

    .home-fragments-section:hover {
      border-color: var(--sl-color-gray-5);
    }

    .home-fragments-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.75rem;
      padding-bottom: 0.85rem;
      border-bottom: 1px solid var(--sl-color-gray-6);
