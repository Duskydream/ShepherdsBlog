    .swoosh-arc-top {
      stroke-dasharray: 800;
      stroke-dashoffset: 800;
      animation: swoosh-draw 2.2s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    .swoosh-arc-bottom {
      stroke-dasharray: 600;
      stroke-dashoffset: 600;
      animation: swoosh-draw 2.6s cubic-bezier(0.16, 1, 0.3, 1) 0.2s forwards;
