      color: var(--sl-color-gray-4);
      font-family: var(--sl-font-mono);
    }

    .home-commit-wall {
      display: grid;
      grid-template-rows: repeat(7, 10px);
      grid-auto-flow: column;
      grid-auto-columns: 10px;
      gap: 3px;
      overflow-x: auto;
      padding-bottom: 0.4rem;
    }

    .home-commit-wall::-webkit-scrollbar {
      height: 4px;
    }

    .home-commit-wall::-webkit-scrollbar-thumb {
      background: var(--sl-color-gray-5);
      border-radius: 2px;
    }

    .home-commit-cell {
      width: 10px;
      height: 10px;
      border-radius: 2px;
      background: var(--sl-color-gray-6);
    }

    .home-commit-cell[data-level="1"] {
      background: color-mix(in srgb, var(--sl-color-accent) 30%, transparent);
    }
    .home-commit-cell[data-level="2"] {
      background: color-mix(in srgb, var(--sl-color-accent) 55%, transparent);
    }
    .home-commit-cell[data-level="3"] {
      background: color-mix(in srgb, var(--sl-color-accent) 80%, transparent);
    }
    .home-commit-cell[data-level="4"] {
      background: var(--sl-color-accent);
      box-shadow: 0 0 6px var(--sl-color-accent);
    }

    .home-tags-container {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      gap: 0.4rem 0.9rem;
    }

    .home-tag {
      display: inline-flex;
