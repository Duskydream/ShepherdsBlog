      font-size: 0.8rem;
      font-weight: 600;
      letter-spacing: 0.12em;
      color: var(--sl-color-accent-high);
      white-space: nowrap;
    }

    .home-fragments-dot,
    .home-card-dot {
      width: 0.6rem;
      height: 0.6rem;
      flex-shrink: 0;
      background-color: var(--sl-color-accent);
      -webkit-mask: var(--floral-mask-bloom) center / contain no-repeat;
      mask: var(--floral-mask-bloom) center / contain no-repeat;
    }

    .home-fragments-subtitle {
      font-size: 0.78rem;
      color: var(--sl-color-gray-3);
      letter-spacing: 0.04em;
    }

    .home-fragments-list {
      display: flex;
      flex-direction: column;
    }

    .home-fragment-row {
      display: grid;
      grid-template-columns: 3.5rem 1fr auto;
      align-items: center;
      gap: 1.25rem;
      padding: 0.9rem 0.5rem;
      border-bottom: 1px solid color-mix(in srgb, var(--sl-color-gray-6) 60%, transparent);
      text-decoration: none !important;
      transition: all 0.22s ease;
      border-radius: 0.5rem;
