        to bottom,
        rgba(0, 0, 0, 1) 0%,
        rgba(0, 0, 0, 1) 45%,
        rgba(0, 0, 0, 0.85) 65%,
        rgba(0, 0, 0, 0.5) 82%,
        rgba(0, 0, 0, 0.15) 94%,
        transparent 100%
      );
      -webkit-mask-image: linear-gradient(
        to bottom,
        rgba(0, 0, 0, 1) 0%,
        rgba(0, 0, 0, 1) 45%,
        rgba(0, 0, 0, 0.85) 65%,
        rgba(0, 0, 0, 0.5) 82%,
        rgba(0, 0, 0, 0.15) 94%,
        transparent 100%
      );
