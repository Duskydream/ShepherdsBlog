---
import config from 'virtual:starlight/user-config';

import LanguageSelect from 'virtual:starlight/components/LanguageSelect';
import Search from 'virtual:starlight/components/Search';
import SiteTitle from 'virtual:starlight/components/SiteTitle';
import SocialIcons from 'virtual:starlight/components/SocialIcons';
import ThemeSelect from 'virtual:starlight/components/ThemeSelect';

const shouldRenderSearch =
  config.pagefind || config.components.Search !== '@astrojs/starlight/components/Search.astro';

const rawPathname = Astro.url.pathname.replace(/\/+$/, '') || '/';
const navLinks = [
  { href: '/article', zh: '散文', en: 'ESSAY', match: (p: string) => p === '/article' || p.startsWith('/blog') },
  { href: '/notes', zh: '笔记', en: 'NOTES', match: (p: string) => p === '/notes' || p.startsWith('/coding-notes') },
  { href: '/anime', zh: '鉴赏', en: 'REVIEW', match: (p: string) => p.startsWith('/anime') },
  { href: '/log', zh: '日常', en: 'LOG', match: (p: string) => p === '/log' || p.startsWith('/log') },
  { href: '/about', zh: '关于', en: 'ABOUT', match: (p: string) => p.startsWith('/about') },
];
---

<div class="header">
  <div class="header-left sl-flex">
    <button
      type="button"
      id="starlight__drawer-toggle"
      class="catalog-toggle-btn"
      aria-label="打开目录"
      title="打开目录 (Catalog)"
    >
      <span class="catalog-icon">✿</span>
      <span class="catalog-label">目録</span>
    </button>
    <div class="title-wrapper sl-flex">
      <SiteTitle />
    </div>
  </div>
  <div class="header-search sl-flex print:hidden">
    {shouldRenderSearch && <Search />}
  </div>
  <div class="sl-hidden md:sl-flex print:hidden right-group">
    <nav class="header-nav-links" aria-label="全站主导航">
      {navLinks.map((item) => {
        const isActive = item.match(rawPathname);
        return (
          <a href={item.href} class:list={["header-nav-item", { active: isActive }]}>
            <span class="nav-item-zh">{item.zh}</span>
            <span class="nav-item-en">{item.en}</span>
            {isActive && <span class="nav-active-bar" aria-hidden="true"></span>}
          </a>
        );
      })}
    </nav>
    <ThemeSelect />
    <div class="sl-flex social-icons">
      <SocialIcons />
    </div>
    <LanguageSelect />
  </div>
  <div class="md:sl-hidden print:hidden mobile-right-group">
    <ThemeSelect />
  </div>
</div>

<style>
  @layer starlight.core {
    .header {
      display: flex;
      gap: var(--sl-nav-gap);
      justify-content: space-between;
      align-items: center;
      height: 100%;
    }

    .header-left {
      align-items: center;
      gap: 0.75rem;
      min-width: 0;
      flex: 1 1 auto;
    }

    .header-search {
      flex: 0 1 auto;
    }

    .mobile-right-group {
      display: flex;
      align-items: center;
      flex: 0 0 auto;
    }

    .catalog-toggle-btn {
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      padding: 0.32rem 0.65rem;
      border: 1px solid var(--sl-color-gray-5);
      border-radius: 999px;
      background: var(--sl-color-gray-6);
      color: var(--sl-color-white);
      font-size: 0.78rem;
      cursor: pointer;
      transition: all 0.2s ease;
      line-height: 1;
    }

    .catalog-toggle-btn:hover {
      border-color: color-mix(in srgb, var(--sl-color-accent) 45%, transparent);
      background: color-mix(in srgb, var(--sl-color-accent) 12%, transparent);
      color: var(--sl-color-accent);
      transform: translateY(-1px);
    }

    .catalog-icon {
      font-size: 0.85rem;
      color: var(--sl-color-accent);
    }

    .catalog-label {
      letter-spacing: 0.08em;
    }

    .title-wrapper {
      overflow: clip;
      padding: 0.25rem;
      margin: -0.25rem;
      min-width: 0;
    }

    .right-group,
    .social-icons {
      gap: 1rem;
      align-items: center;
    }

    .social-icons::after {
      content: '';
      height: 2rem;
      border-inline-end: 1px solid var(--sl-color-gray-5);
    }

    .header-nav-links {
      display: flex;
      align-items: center;
      gap: 0.95rem;
      margin-inline-end: 0.5rem;
    }

    .header-nav-item {
      position: relative;
      display: inline-flex;
      flex-direction: column;
      align-items: center;
      text-decoration: none !important;
      line-height: 1.15;
      padding: 0.35rem 0.45rem 0.5rem;
      transition: all 0.2s ease;
      color: var(--sl-color-gray-3) !important;
    }

    .nav-item-zh {
      font-family: "Songti SC", "Source Han Serif SC", "FZLanTingHei", "Noto Serif CJK SC", "STSong", "SimSun", serif;
      font-size: 0.88rem;
      letter-spacing: 0.05em;
      color: var(--sl-color-gray-2);
      transition: color 0.2s ease;
    }

    .nav-item-en {
      font-family: var(--sl-font-mono);
      font-size: 0.56rem;
      letter-spacing: 0.12em;
      opacity: 0.65;
      color: var(--sl-color-gray-4);
      margin-top: 0.15rem;
      transition: color 0.2s ease;
    }

    .header-nav-item:hover .nav-item-zh {
      color: var(--sl-color-white);
    }

    .header-nav-item:hover .nav-item-en {
      color: var(--sl-color-accent);
      opacity: 1;
    }

    .header-nav-item.active .nav-item-zh {
      color: var(--sl-color-white);
      font-weight: 600;
    }

    .header-nav-item.active .nav-item-en {
      color: var(--sl-color-accent);
      opacity: 1;
      font-weight: 600;
    }

    .nav-active-bar {
      position: absolute;
      bottom: 0;
      left: 50%;
      transform: translateX(-50%);
      width: 14px;
      height: 2px;
      border-radius: 999px;
      background-color: var(--sl-color-accent);
      box-shadow: 0 0 8px var(--sl-color-accent);
    }

    @media (min-width: 50rem) {
      :global(:root[data-has-sidebar]) {
        --__sidebar-pad: calc(2 * var(--sl-nav-pad-x));
      }

      :global(:root:not([data-has-toc])) {
        --__toc-width: 0rem;
      }

      .header {
        --__sidebar-width: max(0rem, var(--sl-content-inline-start, 0rem) - var(--sl-nav-pad-x));
        --__main-column-fr: calc(
          (
              100% + var(--__sidebar-pad, 0rem) - var(--__toc-width, var(--sl-sidebar-width)) -
                (2 * var(--__toc-width, var(--sl-nav-pad-x))) - var(--sl-content-inline-start, 0rem) -
                var(--sl-content-width)
            ) / 2
        );
        display: grid;
        grid-template-columns:
          minmax(
            calc(var(--__sidebar-width) + max(0rem, var(--__main-column-fr) - var(--sl-nav-gap))),
            auto
          )
          1fr
          auto;
        align-content: center;
      }
    }
  }
</style>
