---
---

<div class="two-column-layout">
  <div class="main-pane"><slot /></div>
  {
    Astro.locals.starlightRoute.toc && (
      <aside
        class="right-sidebar-container print:hidden"
        transition:name="site-toc"
        transition:animate="none"
      >
        <div class="right-sidebar">
          <slot name="right-sidebar" />
        </div>
      </aside>
    )
  }
</div>

<style>
  .two-column-layout {
    display: flex;
    width: 100%;
    min-height: calc(100vh - var(--sl-nav-height, 3.5rem));
    justify-content: center;
    position: relative;
    box-sizing: border-box;
  }

  .main-pane {
    flex: 1 1 0%;
    min-width: 0;
    width: 100%;
    display: flex;
    justify-content: center;
    isolation: isolate;
  }

  .right-sidebar-container {
    display: none;
  }

  @media (min-width: 72rem) {
    .right-sidebar-container {
      display: block;
      flex-shrink: 0;
      width: 15rem;
      position: relative;
    }

    .right-sidebar {
      position: sticky;
      top: var(--sl-nav-height, 3.5rem);
      max-height: calc(100vh - var(--sl-nav-height, 3.5rem));
      overflow-y: auto;
      padding-top: 1.5rem;
      padding-bottom: 2rem;
      scrollbar-width: none;
    }
  }
</style>
