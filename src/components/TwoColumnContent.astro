---
---

<div class="two-column-layout">
  <div class="main-pane"><slot /></div>
  {
    Astro.locals.starlightRoute.toc && (
      <aside
        class="right-sidebar-container print:hidden"
        transition:name="site-toc"
        transition:animate="none"
      >
        <div class="right-sidebar">
          <slot name="right-sidebar" />
        </div>
      </aside>
    )
  }
</div>

<style>
  .two-column-layout {
    display: flex;
    width: 100%;
    max-width: 76rem;
    margin-inline: auto;
    min-height: calc(100vh - var(--sl-nav-height, 3.5rem));
    justify-content: center;
    position: relative;
    box-sizing: border-box;
    padding-inline: 1rem;
    gap: 2rem;
  }

  .main-pane {
    flex: 1 1 0%;
    min-width: 0;
    max-width: 52rem;
    width: 100%;
    display: flex;
    justify-content: center;
    isolation: isolate;
  }

  /* 针对 dashboard、gallery 等宽屏页面的扩展 */
  :global(.main-frame:has(.not-content)) .two-column-layout {
    max-width: 90rem;
    padding-inline: 0.5rem;
  }

  @media (max-width: 50rem) {
    .two-column-layout {
      padding-inline: 0;
      gap: 0;
    }
    :global(.main-frame:has(.not-content)) .two-column-layout {
      padding-inline: 0;
    }
  }

  :global(.main-frame:has(.not-content)) .main-pane {
    max-width: 100%;
  }

  .right-sidebar-container {
    display: none;
  }

  @media (min-width: 72rem) {
    .two-column-layout {
      padding-inline: 1.5rem;
      gap: 2.5rem;
      justify-content: center;
    }

    .right-sidebar-container {
      display: block;
      flex-shrink: 0;
      width: 14.5rem;
      position: relative;
    }

    .right-sidebar {
      position: sticky;
      top: var(--sl-nav-height, 3.5rem);
      max-height: calc(100vh - var(--sl-nav-height, 3.5rem));
      overflow-y: auto;
      padding-top: 1.5rem;
      padding-bottom: 2rem;
      scrollbar-width: none;
    }
  }
</style>
