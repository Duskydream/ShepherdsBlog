---

const PAGE_TITLE_ID = "_top";

const { entry } = Astro.locals.starlightRoute;
const isSplash = entry.data.template === "splash";
const { date, tags, author, categories } = entry.data;

/**
 * 阅读时长估算。
 *
 * 旧实现是 `entry.body.length / 400`，直接把原始 markdown 字符数当正文：
 * 代码块、图片 URL、`<br>`、`**` 标记、frontmatter 全都算成了“读到的字”，
 * 所以 second-person 显示 102 分钟，而实际正文只有约 3.7 万字。
 * 现在先剥掉这些噪声，再按中文 400 字/分、西文 200 词/分分别累计。
 */
function estimateReadingTime(body: string | undefined): number | null {
  if (!body) return null;

  const text = body
    .replace(/```[\s\S]*?```/g, " ") // fenced code block
    .replace(/`[^`\n]*`/g, " ") // inline code
    .replace(/!\[[^\]]*\]\([^)]*\)/g, " ") // image
    .replace(/\[([^\]]*)\]\([^)]*\)/g, "$1") // link keeps its text
    .replace(/<[^>]+>/g, " ") // raw HTML (<br>, <blockquote class=...>)
    .replace(/^\s{0,3}#{1,6}\s+/gm, "") // heading markers
    .replace(/^\s{0,3}>\s?/gm, "") // blockquote markers
    .replace(/^\s{0,3}[-*+]\s+/gm, "") // bullet markers
    .replace(/^\s{0,3}\d+\.\s+/gm, "") // ordered list markers
    .replace(/^\s*[-=*_]{3,}\s*$/gm, " ") // horizontal rules
    .replace(/[*_~]{1,3}/g, "") // emphasis markers
    .replace(/\s+/g, " ");

  const cjk = (text.match(/[\u3040-\u30ff\u3400-\u4dbf\u4e00-\u9fff\uf900-\ufaff]/g) ?? []).length;
  const words = (text.match(/[A-Za-z0-9]+/g) ?? []).length;
  const minutes = cjk / 400 + words / 200;

  return minutes > 0 ? Math.max(1, Math.round(minutes)) : null;
}

const readingTime = estimateReadingTime(entry.body);

const dateFormatter = new Intl.DateTimeFormat("zh-CN", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
const formattedDate = date ? dateFormatter.format(new Date(date)) : null;
---

{
  !isSplash && (
    <div class="page-title-wrapper" data-article-reading={date ? "" : undefined} data-reading-minutes={date ? readingTime : undefined}>
      <h1 id={PAGE_TITLE_ID}>
        {entry.data.title}
      </h1>
      {
        (formattedDate || readingTime || author || (tags && tags.length > 0) ||
          (categories && categories.length > 0)) && (
          <p class="page-meta">
            {formattedDate && <span>记录于：{formattedDate}</span>}
            {author && <span>作者：{author}</span>}
            {readingTime && <span>预计阅读：约 {readingTime} 分钟</span>}
            {
              categories && categories.length > 0 && (
                <span>分类：{categories.join("、")}</span>
              )
            }
            {tags && tags.length > 0 && <span>标签：{tags.map((tag, index) => <>{index > 0 && "、"}<a href={`/tags/${encodeURIComponent(tag)}/`}>{tag}</a></>)}</span>}
          </p>
        )
      }
    </div>
  )
}

<style>
  @layer starlight.core {
    .page-title-wrapper {
      margin-top: 1rem;
      margin-bottom: 2rem;
    }
    h1 {
      font-size: var(--sl-text-h1);
      line-height: var(--sl-line-height-headings);
      font-weight: 600;
      color: var(--sl-color-white);
      width: fit-content;
      max-width: 100%;
      margin: 0;
    }
    .page-meta {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.45rem 0.7rem;
      margin: 0.9rem 0 0;
      font-size: 0.875rem;
      line-height: 1.6;
      color: var(--sl-color-gray-3);
    }
    .page-meta a {
      color: inherit;
      text-decoration: underline;
      text-decoration-color: var(--sl-color-gray-4);
      text-underline-offset: 0.2em;
    }
    .page-meta a:hover {
      color: var(--sl-color-accent);
    }
    .page-meta span + span::before {
      content: "·";
      color: var(--sl-color-accent);
      opacity: 0.6;
      margin-inline-end: 0.7rem;
    }
  }
</style>
