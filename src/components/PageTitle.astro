---
const PAGE_TITLE_ID = "_top";

const { entry } = Astro.locals.starlightRoute;
const isSplash = entry.data.template === "splash";
const { date, tags } = entry.data;
const bodyLength = entry.body ? entry.body.length : 0;
const readingTime = bodyLength > 0 ? Math.max(1, Math.ceil(bodyLength / 400)) : null;

const dateFormatter = new Intl.DateTimeFormat("zh-CN", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
const formattedDate = date ? dateFormatter.format(new Date(date)) : null;
---

{
  !isSplash && (
    <div class="page-title-wrapper">
      <h1 id={PAGE_TITLE_ID}>
        {entry.data.title}
      </h1>
      {
        (formattedDate || readingTime || (tags && tags.length > 0)) && (
          <p class="page-meta">
            <span class="page-meta-ornament" aria-hidden="true">❀</span>
            {formattedDate && <span>记录于：{formattedDate}</span>}
            {readingTime && <span>预计阅读：约 {readingTime} 分钟</span>}
            {tags && tags.length > 0 && <span>标签：{tags.join("、")}</span>}
          </p>
        )
      }
    </div>
  )
}

<style>
  @layer starlight.core {
    .page-title-wrapper {
      margin-top: 1rem;
      margin-bottom: 2rem;
    }
    h1 {
      font-size: var(--sl-text-h1);
      line-height: var(--sl-line-height-headings);
      font-weight: 600;
      color: var(--sl-color-white);
      width: fit-content;
      max-width: 100%;
      margin: 0;
    }
    .page-meta {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.45rem 0.7rem;
      margin: 0.9rem 0 0;
      font-size: 0.875rem;
      line-height: 1.6;
      color: var(--sl-color-gray-3);
    }
    .page-meta-ornament {
      color: var(--sl-color-accent);
      font-size: 0.8rem;
    }
    .page-meta span + span::before {
      content: "·";
      color: var(--sl-color-accent);
      opacity: 0.6;
      margin-inline-end: 0.7rem;
    }
  }
</style>
