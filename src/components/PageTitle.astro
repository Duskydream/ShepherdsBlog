---
import { getTagHref } from "../utils/content";
import Floral from "./Floral.astro";

const PAGE_TITLE_ID = "_top";

const { entry } = Astro.locals.starlightRoute;
const isSplash = entry.data.template === "splash";
const isEssay = entry.id.startsWith("blog/") || entry.id.startsWith("log/");
const { date, tags, author, categories } = entry.data;

const sectionNavMap: Record<string, { label: string; href: string }> = {
  blog: { label: "Essay · 散文随笔", href: "/article/" },
  "coding-notes": { label: "Notes · 月累笔记", href: "/notes/" },
  log: { label: "Log · 日常记录", href: "/log/" },
};
const sectionPrefix = entry.id.split("/")[0];
const sectionNav = sectionNavMap[sectionPrefix];

function hasEditorialFirstParagraph(body: string | undefined): boolean {
  if (!body) return false;
  const blocks = body
    .split(/\r?\n\s*\r?\n/)
    .map((block) => block.trim())
    .filter(Boolean);
  const firstPara = blocks.find(
    (block) => !/^(#{1,6}\s|>|---|===|\*\*\*|```|~~~)/.test(block)
  );
  if (!firstPara) return false;
  if (/^(!\[|\*\*|__|~~|[（(「『【\[《<*—-])/.test(firstPara)) return false;
  if (/^(翻译|声明|注|注意|图源|附)[：:]/.test(firstPara)) return false;
  return firstPara.length >= 24;
}

const allowDropCap = isEssay && hasEditorialFirstParagraph(entry.body);

/**
 * 阅读时长估算：先剥掉代码块、图片、HTML 与 markdown 标记，
 * 再按中文 400 字/分、西文 200 词/分分别累计。
 */
function estimateReadingTime(body: string | undefined): number | null {
  if (!body) return null;

  const text = body
    .replace(/```[\s\S]*?```/g, " ")
    .replace(/`[^`\n]*`/g, " ")
    .replace(/!\[[^\]]*\]\([^)]*\)/g, " ")
    .replace(/\[([^\]]*)\]\([^)]*\)/g, "$1")
    .replace(/<[^>]+>/g, " ")
    .replace(/^\s{0,3}#{1,6}\s+/gm, "")
    .replace(/^\s{0,3}>\s?/gm, "")
    .replace(/^\s{0,3}[-*+]\s+/gm, "")
    .replace(/^\s{0,3}\d+\.\s+/gm, "")
    .replace(/^\s*[-=*_]{3,}\s*$/gm, " ")
    .replace(/[*_~]{1,3}/g, "")
    .replace(/\s+/g, " ");

  const cjk = (text.match(/[\u3040-\u30ff\u3400-\u4dbf\u4e00-\u9fff\uf900-\ufaff]/g) ?? []).length;
  const words = (text.match(/[A-Za-z0-9]+/g) ?? []).length;
  const minutes = cjk / 400 + words / 200;

  return minutes > 0 ? Math.max(1, Math.round(minutes)) : null;
}

const readingTime = estimateReadingTime(entry.body);

const dateFormatter = new Intl.DateTimeFormat("zh-CN", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
const formattedDate = date ? dateFormatter.format(new Date(date)) : null;
---

{
  !isSplash && (
    <div
      class="page-title-wrapper"
      data-essay={isEssay ? "" : undefined}
      data-dropcap={allowDropCap ? "" : undefined}
      data-article-reading={date ? "" : undefined}
      data-reading-minutes={date ? readingTime : undefined}
    >
      {sectionNav && (
        <a href={sectionNav.href} class="page-eyebrow-link">
          <Floral variant="bloom" class="page-eyebrow-floral" />
          <span>{sectionNav.label}</span>
        </a>
      )}
      <h1 id={PAGE_TITLE_ID}>
        {entry.data.title}
      </h1>
      {
        (formattedDate || readingTime || author || (tags && tags.length > 0) ||
          (categories && categories.length > 0)) && (
          <p class="page-meta">
            {formattedDate && <span class="page-meta-item">记录于：{formattedDate}</span>}
            {author && <span class="page-meta-item">作者：{author}</span>}
            {readingTime && <span class="page-meta-item">预计阅读：约 {readingTime} 分钟</span>}
            {
              categories && categories.length > 0 && (
                <span class="page-meta-item">分类：{categories.join("、")}</span>
              )
            }
            {tags && tags.length > 0 && (
              <span class="page-meta-item">
                标签：{tags.map((tag, index) => <>{index > 0 && "、"}<a href={getTagHref(tag)}>{tag}</a></>)}
              </span>
            )}
          </p>
        )
      }
    </div>
  )
}

<style>
  @layer starlight.core {
    .page-title-wrapper {
      width: 100%;
      max-width: 44rem;
      margin: 1rem auto 2rem;
    }
    .page-eyebrow-link {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      margin-bottom: 0.55rem;
      font-size: 0.78rem;
      font-weight: 600;
      letter-spacing: 0.06em;
      color: var(--sl-color-accent);
      text-decoration: none;
      transition: opacity 0.2s ease, transform 0.2s ease;
    }
    .page-eyebrow-link :global(.page-eyebrow-floral) {
      --floral-size: 0.8em;
      color: var(--sl-color-accent);
    }
    .page-eyebrow-link:hover {
      opacity: 0.88;
      transform: translateX(-2px);
    }
    h1 {
      font-family: var(--hananiwa-font-serif);
      font-size: var(--sl-text-h1);
      line-height: var(--sl-line-height-headings);
      font-weight: 600;
      letter-spacing: 0.02em;
      color: var(--sl-color-white);
      width: fit-content;
      max-width: 100%;
      margin: 0;
    }
    .page-meta {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.45rem 1.15rem;
      margin: 0.9rem 0 0;
      font-size: 0.875rem;
      line-height: 1.6;
      color: var(--sl-color-gray-3);
    }
    .page-meta-item {
      display: inline-flex;
      align-items: center;
      flex-wrap: wrap;
    }
    .page-meta a {
      color: inherit;
      text-decoration: underline;
      text-decoration-color: var(--sl-color-gray-4);
      text-underline-offset: 0.2em;
    }
    .page-meta a:hover {
      color: var(--sl-color-accent);
    }
  }
</style>
