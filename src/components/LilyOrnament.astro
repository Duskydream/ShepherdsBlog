---
interface Props {
  id?: string;
}

const { id = "lily" } = Astro.props;
const grad = `${id}-grad`;

const TUBE = [
  "M -7 -30 C -4 -20 -2 -10 0 0",
  "M 7 -30 C 4 -20 2 -10 0 0",
];
const PETALS = [
  "M -6 -30 C -14 -62 -28 -74 -45 -76 C -51 -77 -52 -70 -47 -69 C -34 -52 -20 -38 -6 -30",
  "M -4 -31 C -20 -58 -28 -80 -27 -97 C -29 -103 -22 -105 -20 -100 C -6 -78 0 -54 -1 -32",
  "M -1 -32 C -12 -66 -16 -92 -12 -110 C -13 -116 -6 -118 -5 -112 C 2 -90 6 -62 2 -32",
  "M 3 -31 C 19 -58 27 -80 26 -97 C 28 -103 21 -105 19 -100 C 5 -78 -1 -54 0 -32",
  "M 6 -30 C 14 -62 28 -74 45 -76 C 51 -77 52 -70 47 -69 C 34 -52 20 -38 6 -30",
];
const STAMENS = [
  ["M -2 -32 C -6 -60 -12 -84 -22 -104", "M -22 -104 L -28 -114"],
  ["M 2 -32 C 4 -64 8 -92 14 -112", "M 14 -112 L 18 -124"],
  ["M 4 -30 C 10 -56 18 -78 30 -94", "M 30 -94 L 36 -102"],
];
const SPARK =
  "M 0 -12 C 1.6 -4 4 -1.6 12 0 C 4 1.6 1.6 4 0 12 C -1.6 4 -4 1.6 -12 0 C -4 -1.6 -1.6 -4 0 -12 Z";
---

<svg viewBox="0 0 420 420" fill="none" xmlns="http://www.w3.org/2000/svg" class="lily-ornament" aria-hidden="true">
  <defs>
    <linearGradient id={grad} x1="60" y1="420" x2="360" y2="40" gradientUnits="userSpaceOnUse">
      <stop offset="0" style="stop-color: var(--sl-color-accent)" stop-opacity="0.18" />
      <stop offset="0.55" style="stop-color: var(--sl-color-accent)" stop-opacity="0.85" />
      <stop offset="1" style="stop-color: var(--sl-color-accent-high)" />
    </linearGradient>
  </defs>

  <!-- sweeping arc echo -->
  <path class="draw" style="animation-delay: .1s" d="M 26 152 A 165 165 0 0 1 214 24"
    stroke={`url(#${grad})`} stroke-width="1" stroke-linecap="round" pathLength="1" opacity="0.55" />

  <!-- stem -->
  <path class="draw" d="M 434 438 C 352 382 272 312 212 232 C 194 208 182 186 176 166"
    stroke={`url(#${grad})`} stroke-width="1.6" stroke-linecap="round" pathLength="1" />

  <!-- leaves -->
  <path class="draw" style="animation-delay: .45s" d="M 315 344 C 340 328 366 322 388 324 C 366 340 338 346 315 344 Z"
    stroke={`url(#${grad})`} stroke-width="1.2" stroke-linecap="round" pathLength="1" />
  <path class="draw" style="animation-delay: .6s" d="M 260 290 C 234 278 208 277 186 286 C 210 298 238 299 260 290 Z"
    stroke={`url(#${grad})`} stroke-width="1.2" stroke-linecap="round" pathLength="1" />

  <!-- bud branch -->
  <path class="draw" style="animation-delay: .55s" d="M 287 317 C 300 292 310 272 316 250"
    stroke={`url(#${grad})`} stroke-width="1.2" stroke-linecap="round" pathLength="1" />
  <path class="draw" style="animation-delay: .85s" d="M 316 250 C 310 234 314 219 327 208 C 332 223 328 238 316 250 Z"
    stroke={`url(#${grad})`} stroke-width="1.2" stroke-linecap="round" pathLength="1" fill={`url(#${grad})`} fill-opacity="0.06" />

  <!-- bloom -->
  <g transform="translate(176 166) rotate(-24)">
    {
      TUBE.map((d) => (
        <path class="draw" style="animation-delay: .7s" d={d}
          stroke={`url(#${grad})`} stroke-width="1.4" stroke-linecap="round" pathLength="1" />
      ))
    }
    {
      PETALS.map((d, i) => (
        <path class="draw" style={`animation-delay: ${0.85 + i * 0.12}s`} d={d}
          stroke={`url(#${grad})`} stroke-width="1.3" stroke-linecap="round" pathLength="1" />
      ))
    }
    {
      STAMENS.map(([d, anther], i) => (
        <g>
          <path class="draw" style={`animation-delay: ${1.5 + i * 0.12}s`} d={d}
            stroke={`url(#${grad})`} stroke-width="0.9" stroke-linecap="round" pathLength="1" />
          <path class="fade" style={`animation-delay: ${2 + i * 0.12}s`} d={anther}
            stroke={`url(#${grad})`} stroke-width="2.6" stroke-linecap="round" />
        </g>
      ))
    }
  </g>

  <!-- sparkles -->
  <path class="sparkle" transform="translate(84 72)" d={SPARK} fill={`url(#${grad})`} />
  <path class="sparkle" style="animation-delay: 1.1s" transform="translate(322 96) scale(0.55)" d={SPARK} fill={`url(#${grad})`} />
  <path class="sparkle" style="animation-delay: 2s" transform="translate(52 208) scale(0.45)" d={SPARK} fill={`url(#${grad})`} />
  <path class="sparkle" style="animation-delay: .6s" transform="translate(238 44) scale(0.35)" d={SPARK} fill={`url(#${grad})`} />
</svg>

<style>
  .lily-ornament {
    display: block;
    width: 100%;
    height: auto;
    filter: drop-shadow(0 0 6px rgba(112, 147, 200, 0.22));
  }

  .lily-ornament .draw {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: lily-draw 1.4s cubic-bezier(0.45, 0, 0.2, 1) forwards;
  }

  .lily-ornament .fade {
    opacity: 0;
    animation: lily-fade 0.8s ease forwards;
  }

  .lily-ornament .sparkle {
    animation: lily-twinkle 3.2s ease-in-out infinite alternate;
  }

  @keyframes lily-draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes lily-fade {
    to {
      opacity: 1;
    }
  }

  @keyframes lily-twinkle {
    from {
      opacity: 0.3;
    }
    to {
      opacity: 0.95;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .lily-ornament .draw {
      animation: none;
      stroke-dashoffset: 0;
    }
    .lily-ornament .fade {
      animation: none;
      opacity: 1;
    }
    .lily-ornament .sparkle {
      animation: none;
      opacity: 0.8;
    }
  }
</style>
