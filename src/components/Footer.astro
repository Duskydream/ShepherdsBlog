---
import EditLink from 'virtual:starlight/components/EditLink';
import LastUpdated from 'virtual:starlight/components/LastUpdated';
import Pagination from 'virtual:starlight/components/Pagination';
import config from 'virtual:starlight/user-config';
import { Icon } from '@astrojs/starlight/components';
import SiteFooter from './SiteFooter.astro';
import Floral from './Floral.astro';

const filePath = Astro.locals.starlightRoute.entry.filePath.replaceAll('\\', '/');
const isSplash = Astro.locals.starlightRoute.entry.data.template === 'splash';
const showComments =
	filePath.startsWith('src/content/docs/blog/') ||
	filePath.startsWith('src/content/docs/log/') ||
	filePath.startsWith('src/content/docs/coding-notes/');
---

<footer class="sl-flex">
	{
		!isSplash && (
			<div class="meta sl-flex">
				<EditLink {...Astro.props} />
				<LastUpdated {...Astro.props} />
			</div>
			<Pagination {...Astro.props} />
		)
	}

	{showComments && (
		<section class="comments-card hananiwa-surface" aria-label="文章评论">
			<div class="comments-card-head">
				<Floral variant="bloom" class="comments-title-floral" />
				<span>文章评论 · Comments</span>
			</div>
			<div class="giscus-container" data-giscus-lazy>
				<div class="giscus-placeholder" role="status">Loading comments...</div>
			</div>
		</section>
	)}

	{/* 全局通用 4 栏现代化页脚 (BRAND & SUBSCRIBE · NAVIGATE · CONNECT · STATS) */}
	<SiteFooter />

	{
		config.credits && (
			<a class="kudos sl-flex" href="https://starlight.astro.build">
				<Icon name={'starlight'} /> {Astro.locals.t('builtWithStarlight.label')}
			</a>
		)
	}

	<div class="copyright-notice">
		Copyright &copy; {new Date().getFullYear()} Shepherd Meng.
	</div>
</footer>

<script>
	let giscusObserver: IntersectionObserver | undefined;
	let giscusThemeObserver: MutationObserver | undefined;

	function cleanupGiscus() {
		giscusObserver?.disconnect();
		giscusObserver = undefined;
		giscusThemeObserver?.disconnect();
		giscusThemeObserver = undefined;
	}

	function initGiscus() {
		cleanupGiscus();

		const container = document.querySelector<HTMLElement>('.giscus-container[data-giscus-lazy]');
		if (!container) return;

		let loaded = false;

		function giscusTheme() {
			return document.documentElement.dataset.theme === 'dark' ? 'transparent_dark' : 'light';
		}

		function updateLoadedGiscusTheme() {
			const frame = container?.querySelector<HTMLIFrameElement>('iframe.giscus-frame');
			frame?.contentWindow?.postMessage(
				{ giscus: { setConfig: { theme: giscusTheme() } } },
				'https://giscus.app'
			);
		}

		function loadGiscus() {
			if (loaded || !container) return;
			loaded = true;
			giscusObserver?.disconnect();
			giscusObserver = undefined;
			container.innerHTML = '';

			const script = document.createElement('script');
			script.src = 'https://giscus.app/client.js';
			script.setAttribute('data-repo', 'Duskydream/ShepherdsBlog');
			script.setAttribute('data-repo-id', 'R_kgDOR_rpZg');
			script.setAttribute('data-mapping', 'pathname');
			script.setAttribute('data-strict', '0');
			script.setAttribute('data-reactions-enabled', '1');
			script.setAttribute('data-emit-metadata', '0');
			script.setAttribute('data-input-position', 'bottom');
			script.setAttribute('data-theme', giscusTheme());
			script.setAttribute('data-lang', 'zh-CN');
			script.setAttribute('crossorigin', 'anonymous');
			script.async = true;
			container.appendChild(script);
		}

		giscusThemeObserver = new MutationObserver(() => {
			if (loaded) updateLoadedGiscusTheme();
		});
		giscusThemeObserver.observe(document.documentElement, {
			attributes: true,
			attributeFilter: ['data-theme'],
		});

		if ('IntersectionObserver' in window) {
			giscusObserver = new IntersectionObserver(
				(entries) => {
					if (entries.some((entry) => entry.isIntersecting)) loadGiscus();
				},
				{ rootMargin: '300px 0px' }
			);
			giscusObserver.observe(container);
		} else {
			loadGiscus();
		}
	}

	document.addEventListener('astro:before-swap', cleanupGiscus);
	document.addEventListener('astro:page-load', initGiscus);
</script>

<style>
	@layer starlight.core {
		footer {
			display: flex;
			flex-direction: column;
			gap: 1.5rem;
		}

		.meta,
		.comments-card,
		footer :global(.pagination-links) {
			width: 100%;
			max-width: 44rem;
			margin-inline: auto;
		}

		.meta {
			display: flex;
			flex-direction: row;
			align-items: center;
			gap: 0.75rem 3rem;
			justify-content: space-between;
			flex-wrap: wrap;
			margin-top: 3rem;
			font-size: var(--sl-text-sm);
			color: var(--sl-color-gray-3);
		}

		.meta > :global(p:only-child) {
			margin-inline-start: auto;
		}

		.comments-card {
			margin-top: 2rem;
			overflow: hidden;
		}

		.comments-card-head {
			padding: 0.75rem 1rem;
			display: flex;
			align-items: center;
			gap: 0.5rem;
			border-bottom: 1px solid var(--sl-color-gray-6);
			font-size: 0.85rem;
			font-weight: 600;
			color: var(--sl-color-white);
		}

		.giscus-container {
			padding: 1rem;
			min-height: 150px;
		}

		.kudos {
			align-items: center;
			gap: 0.5em;
			margin: 1.5rem auto 0;
			font-size: var(--sl-text-xs);
			text-decoration: none;
			color: var(--sl-color-gray-3);
		}

		.kudos:hover {
			color: var(--sl-color-white);
		}

		.copyright-notice {
			text-align: center;
			margin: 1.5rem auto;
			font-size: 0.75rem;
			color: var(--sl-color-gray-4);
			font-family: var(--sl-font-mono);
			letter-spacing: 0.05em;
			text-transform: uppercase;
		}

		.giscus-placeholder {
			display: grid;
			min-height: 7rem;
			place-items: center;
			color: var(--sl-color-gray-3);
			font-size: var(--sl-text-sm);
		}

		.giscus-placeholder::before {
			content: "";
			display: block;
			width: 1.6rem;
			height: 1.6rem;
			margin: 0 auto 0.6rem;
			background-color: var(--sl-color-accent);
			-webkit-mask: var(--floral-mask-bloom) center / contain no-repeat;
			mask: var(--floral-mask-bloom) center / contain no-repeat;
			animation: floral-spin 1.8s linear infinite;
		}
	}

	@layer starlight.components {
		.kudos :global(svg) {
			color: var(--sl-color-orange);
		}
	}

	:global(.comments-title-floral) {
		--floral-size: 1rem;
		color: var(--sl-color-accent);
		flex: 0 0 auto;
	}
</style>
