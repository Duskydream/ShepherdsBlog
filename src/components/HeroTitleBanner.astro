<style>
  .hero-title-art {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 56rem;
    margin: -0.3rem auto 0.85rem;
    display: flex;
    justify-content: center;
    align-items: center;
    animation: hero-container-fade 1.1s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .hero-title-svg {
    width: 100%;
    height: auto;
    display: block;
    overflow: visible;
    color: #9bb7e6;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    user-select: none;
    -webkit-user-drag: none;
  }

  /* 统一纯色填充：主题 accent-high 淡蓝（无渐变、无光晕） */
  .hero-title-svg path {
    fill: #9bb7e6;
  }

  /* 文字笔画（假名/汉字/副标题）使用奇偶填充，恢复被填充死的封闭孔留白
     SVGO 已把每个 <g> 拍平为单个带 class 的 <path>，故直接选 path 本身。 */
  .hero-title-svg path.hero-kana,
  .hero-title-svg path.hero-kanji,
  .hero-title-svg path.hero-subtitle {
    fill-rule: evenodd;
  }

  /* 悬停微互动：整体呼吸上浮 */
  .hero-title-art:hover .hero-title-svg {
    transform: scale(1.018) translateY(-2px);
  }

  /* 动画编排：分层入场与常态灵动微动 */

  /* 1. 旋弧渐显入场 */
  .hero-swoosh {
    animation: hero-swoosh-enter 1.2s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .hero-swoosh--wave {
    animation-delay: 0.15s;
  }

  /* 2. 假名与汉字轻盈入场 */
  .hero-kana {
    animation: hero-float-up 1.0s cubic-bezier(0.16, 1, 0.3, 1) 0.1s both;
  }

  .hero-kanji {
    animation: hero-float-up 1.1s cubic-bezier(0.16, 1, 0.3, 1) 0.25s both;
  }

  /* 3. 分割线自中心展开 */
  .hero-divider-line {
    animation: hero-expand-line 1.0s cubic-bezier(0.16, 1, 0.3, 1) 0.4s both;
    transform-origin: 775px 711px;
  }

  /* 4. 副标题雅致渐现 */
  .hero-subtitle {
    animation: hero-sub-fade 1.1s cubic-bezier(0.16, 1, 0.3, 1) 0.5s both;
  }

  /* 5. 星辰仅保留一次柔和入场，取消常态闪烁/脉动循环 */
  .hero-star {
    transform-box: fill-box;
  }

  .hero-star--top {
    animation: hero-star-enter 0.9s cubic-bezier(0.16, 1, 0.3, 1) 0.3s both;
  }
  .hero-star--l1 {
    animation: hero-star-enter 0.9s cubic-bezier(0.16, 1, 0.3, 1) 0.4s both;
  }
  .hero-star--l2 {
    animation: hero-star-enter 0.9s cubic-bezier(0.16, 1, 0.3, 1) 0.6s both;
  }
  .hero-star--r1 {
    animation: hero-star-enter 0.9s cubic-bezier(0.16, 1, 0.3, 1) 0.5s both;
  }
  .hero-star--r2 {
    animation: hero-star-enter 0.9s cubic-bezier(0.16, 1, 0.3, 1) 0.7s both;
  }
  .hero-star--center {
    animation: hero-star-enter 0.9s cubic-bezier(0.16, 1, 0.3, 1) 0.55s both;
  }

  /* 关键帧动画集 */
  @keyframes hero-container-fade {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes hero-swoosh-enter {
    from {
      opacity: 0;
      transform: translateY(6px) scale(0.98);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  @keyframes hero-float-up {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes hero-expand-line {
    from {
      opacity: 0;
      transform: scaleX(0.4);
    }
    to {
      opacity: 1;
      transform: scaleX(1);
    }
  }

  @keyframes hero-sub-fade {
    from {
      opacity: 0;
      transform: translateY(4px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes hero-star-enter {
    from {
      opacity: 0;
      transform: scale(0.3);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-title-art,
    .hero-title-svg,
    .hero-title-svg path,
    .hero-star {
      animation: none !important;
      transition: none !important;
    }
  }
</style>
