---
import Floral from "./Floral.astro";
import { friendLinks } from "../data/friend-links.js";

const links = friendLinks;
---

<div class="friend-links-grid" aria-label="友情链接">
  {links.map((item, index) => {
    const isInvite = !item.github;
    const githubUrl = item.github;
    const username = githubUrl?.replace(/^https?:\/\/github\.com\//, "").replace(/\/$/, "");
    const avatar = username ? `https://github.com/${username}.png?size=160` : "";

    return (
      <a
        class:list={["friend-link-card hananiwa-surface", { "friend-link-card--invite": isInvite }]}
        href={item.link}
        target={item.link.startsWith("http") ? "_blank" : undefined}
        rel={item.link.startsWith("http") ? "noopener noreferrer" : undefined}
        style={`--friend-index:${index}`}
      >
        <span class="friend-link-avatar">
          {isInvite ? (
            <Floral variant="bloom" size="1.45rem" class="friend-link-invite-mark" />
          ) : (
            <img
              src={avatar}
              alt={`${item.label} 头像`}
              width="52"
              height="52"
              loading="lazy"
              decoding="async"
            />
          )}
        </span>
        <span class="friend-link-content">
          <span class="friend-link-name">{item.label}</span>
          <span class="friend-link-description">{item.description}</span>
        </span>
        <span class="friend-link-arrow" aria-hidden="true">↗</span>
      </a>
    );
  })}
</div>

<style>
  .friend-links-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 19rem), 1fr));
    gap: 1.1rem;
    margin: 0;
  }

  .friend-link-card {
    position: relative;
    display: flex;
    align-items: center;
    gap: 1rem;
    min-height: 6.25rem;
    padding: 1.15rem 2.35rem 1.15rem 1.25rem;
    border: 1px solid var(--sl-color-gray-6);
    border-radius: var(--hananiwa-radius-lg, 1.25rem);
    background: var(--sl-color-bg);
    color: var(--sl-color-text) !important;
    text-decoration: none !important;
    box-sizing: border-box;
    animation: friend-link-rise 0.45s cubic-bezier(0.16, 1, 0.3, 1) both;
    animation-delay: calc(var(--friend-index) * 70ms);
    transition: transform 0.22s ease, border-color 0.22s ease, box-shadow 0.22s ease;
  }

  .friend-link-card:hover {
    transform: translateY(-2px);
    border-color: color-mix(in srgb, var(--sl-color-accent) 48%, var(--sl-color-gray-5));
    box-shadow: 0 8px 24px color-mix(in srgb, var(--sl-color-accent) 10%, transparent);
  }

  .friend-link-avatar {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 3.25rem;
    height: 3.25rem;
    min-width: 3.25rem;
    min-height: 3.25rem;
    aspect-ratio: 1 / 1;
    flex-shrink: 0;
    border-radius: 50%;
    overflow: hidden;
    border: 1.5px solid color-mix(in srgb, var(--sl-color-accent) 42%, var(--sl-color-gray-5));
    background: color-mix(in srgb, var(--sl-color-accent) 8%, var(--sl-color-bg));
    box-sizing: border-box;
  }

  :global(.links-page) .friend-link-avatar img,
  .friend-links-grid .friend-link-avatar img {
    width: 100% !important;
    height: 100% !important;
    max-width: none;
    object-fit: cover;
    display: block;
    border-radius: 50%;
  }

  .friend-link-content {
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: 0.28rem;
  }

  .friend-link-name {
    font-family: var(--hananiwa-font-serif, "Songti SC", "Source Han Serif SC", "Noto Serif CJK SC", "STSong", Georgia, serif);
    font-size: 1.06rem;
    font-weight: 600;
    color: var(--sl-color-white);
    letter-spacing: 0.02em;
    line-height: 1.3;
    transition: color 0.2s ease;
  }

  .friend-link-card:hover .friend-link-name {
    color: var(--sl-color-accent-high);
  }

  .friend-link-description {
    color: var(--sl-color-gray-3);
    font-size: 0.85rem;
    line-height: 1.5;
    overflow-wrap: anywhere;
  }

  .friend-link-arrow {
    position: absolute;
    right: 1.05rem;
    top: 1rem;
    color: var(--sl-color-accent-high);
    font-family: var(--sl-font-mono);
    font-size: 0.95rem;
    opacity: 0.72;
    transition: transform 0.22s ease, opacity 0.22s ease;
  }

  .friend-link-card:hover .friend-link-arrow {
    opacity: 1;
    transform: translate(2px, -2px);
  }

  .friend-link-card--invite {
    border-style: dashed;
    background: color-mix(in srgb, var(--sl-color-accent) 4%, var(--sl-color-bg));
  }

  .friend-link-avatar :global(.friend-link-invite-mark) {
    color: var(--sl-color-accent-high);
  }

  @keyframes friend-link-rise {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 34rem) {
    .friend-link-card {
      min-height: 5.75rem;
      padding: 1rem 2.15rem 1rem 1rem;
      border-radius: 1.1rem;
    }
  }
</style>
