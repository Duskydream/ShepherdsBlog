---
import Floral from './Floral.astro';
---

<div class="site-title-wrapper">
  <a href="/" class="site-title-link" title="返回首页 · 祈りの花庭">
    <Floral variant="flower" class="site-title-floral" />
    <div class="site-title-text">
      <span class="site-title-main">祈りの花庭</span>
    </div>
  </a>
</div>

<style>
  .site-title-wrapper {
    display: flex;
    align-items: center;
    min-width: 0;
  }
  .site-title-link {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    color: var(--sl-color-white);
    transition: opacity 0.2s ease;
  }
  .site-title-floral {
    --floral-size: 1.05rem;
    margin-right: 0.5rem;
    color: var(--sl-color-accent);
    transition: transform 0.3s ease;
  }
  .site-title-link:hover .site-title-floral {
    transform: rotate(-12deg) scale(1.08);
  }
  .site-title-link:hover {
    opacity: 0.85;
  }
  .site-title-text {
    display: flex;
    flex-direction: column;
    line-height: 1.15;
  }
  .site-title-main {
    font-family: "Songti SC", "Source Han Serif SC", "FZLanTingHei", "Noto Serif CJK SC", "STSong", "SimSun", serif;
    font-size: 1.12rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    color: var(--sl-color-white);
  }
</style>
