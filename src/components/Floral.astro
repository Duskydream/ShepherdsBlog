---
// 统一花枝/花元素组件。
// 图形本体集中定义在 src/styles/custom.css 的 --floral-mask-* 变量里（用 mask 实现，颜色跟随 currentColor）。
// 用法：<Floral variant="flower" size="1.2em" /> 或 <Floral variant="bloom" class="xxx" rotate={-12} />
interface Props {
  variant?: "bloom" | "bud" | "sprig" | "flower";
  size?: string;
  rotate?: number;
  flip?: boolean;
  class?: string;
}

const {
  variant = "bloom",
  size,
  rotate,
  flip = false,
  class: className = "",
} = Astro.props;

const transforms: string[] = [];
if (flip) transforms.push("scaleX(-1)");
if (typeof rotate === "number") transforms.push(`rotate(${rotate}deg)`);

const style = [
  size ? `width:${size};height:${size}` : "",
  transforms.length ? `transform:${transforms.join(" ")}` : "",
]
  .filter(Boolean)
  .join(";");
---

<span
  class={`floral floral--${variant} ${className}`.trim()}
  style={style || undefined}
  aria-hidden="true"
></span>
