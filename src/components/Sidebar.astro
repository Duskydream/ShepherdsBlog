---
import type { StarlightRouteData } from '@astrojs/starlight/route-data';
type SidebarEntry = StarlightRouteData["sidebar"][number];
type SidebarLinkEntry = Extract<SidebarEntry, { type: 'link' }>;
type SidebarGroupEntry = Extract<SidebarEntry, { type: 'group' }>;
import MobileMenuFooter from 'virtual:starlight/components/MobileMenuFooter';
import { getCollection } from 'astro:content';
import { isContentPost, getPostHref } from '../utils/content';

const { sidebar } = Astro.locals.starlightRoute;
const rawPathname = Astro.url.pathname.replace(/\/+$/, '') || '/';

const docs = await getCollection('docs');
const dateByPath = new Map(
	docs
		.filter((entry) => entry.data.date instanceof Date)
		.map((entry) => [entry.id.toLowerCase(), entry.data.date!.getTime()])
);

function pathKey(href: string) {
	try {
		return decodeURIComponent(href).replace(/^\/+|\/+$/g, '').toLowerCase();
	} catch {
		return href.replace(/^\/+|\/+$/g, '').toLowerCase();
	}
}

function getEntryDate(entry: SidebarEntry) {
	return entry.type === 'link' ? dateByPath.get(pathKey(entry.href)) : undefined;
}

function sortEntries(entries: SidebarEntry[]): SidebarEntry[] {
	return entries
		.map((entry, index) => ({
			index,
			entry: entry.type === 'group' ? { ...entry, entries: sortEntries(entry.entries) } : entry,
		}))
		.sort((left, right) => {
			const leftDate = getEntryDate(left.entry);
			const rightDate = getEntryDate(right.entry);

			if (leftDate !== undefined && rightDate !== undefined && leftDate !== rightDate) {
				return rightDate - leftDate;
			}
			if (leftDate !== undefined && rightDate === undefined) return -1;
			if (leftDate === undefined && rightDate !== undefined) return 1;
			return left.index - right.index;
		})
		.map(({ entry }) => entry);
}

function collectLinks(items: SidebarEntry[]): SidebarLinkEntry[] {
	return sortEntries(items).flatMap((item) => {
		if (item.type === 'link') return [item];
		if (item.type === 'group') return collectLinks(item.entries);
		return [];
	});
}

const sectionHrefMap: Record<string, string> = {
	Essay: '/article',
	Notes: '/notes',
	Log: '/log',
};

const topLinks: SidebarLinkEntry[] = sidebar.filter((item): item is SidebarLinkEntry => item.type === 'link');
// 补充 Tags 索引入口，方便移动端和桌面端直接从目録抽屉进入标签页
const hasTagsLink = topLinks.some((item) => item.href.replace(/\/+$/, '') === '/tags');
const navLinks: SidebarLinkEntry[] = hasTagsLink
	? topLinks
	: [
			...topLinks,
			{
				type: 'link',
				label: 'Tags',
				href: '/tags',
				isCurrent: rawPathname === '/tags' || rawPathname.startsWith('/tags/'),
				badge: undefined,
				attrs: {},
			},
		];

const groupSectionsFromSidebar = sidebar
	.filter((item): item is SidebarGroupEntry => item.type === 'group')
	.map((item) => {
		const links = collectLinks(item.entries);
		const isCurrentGroup = links.some((link) => link.isCurrent);
		return {
			label: item.label,
			href: sectionHrefMap[item.label],
			links,
			isCurrentGroup,
		};
	})
	.filter((section) => section.links.length > 0);

const canonicalSections = [
	{ label: 'Essay', section: 'blog', href: '/article' },
	{ label: 'Notes', section: 'coding-notes', href: '/notes' },
	{ label: 'Log', section: 'log', href: '/log' },
] as const;

function buildFallbackLinks(section: string): SidebarLinkEntry[] {
	const currentKey = pathKey(rawPathname);
	return docs
		.filter((entry) => isContentPost(entry, section))
		.sort((a, b) => {
			const aDate = a.data.date instanceof Date ? a.data.date.getTime() : undefined;
			const bDate = b.data.date instanceof Date ? b.data.date.getTime() : undefined;
			if (aDate !== undefined && bDate !== undefined && aDate !== bDate) return bDate - aDate;
			if (aDate !== undefined && bDate === undefined) return -1;
			if (aDate === undefined && bDate !== undefined) return 1;
			return a.id.localeCompare(b.id);
		})
		.map((entry) => {
			const href = getPostHref(entry);
			return {
				type: 'link' as const,
				label: entry.data.title,
				href,
				isCurrent: pathKey(href) === currentKey,
				badge: undefined,
				attrs: {},
			};
		});
}

const existingByLabel = new Map(groupSectionsFromSidebar.map((s) => [s.label, s]));
const extraGroups = groupSectionsFromSidebar.filter(
	(s) => !canonicalSections.some((c) => c.label === s.label)
);
const groupSections = [
	...canonicalSections
		.map(({ label, section, href }) => {
			const existing = existingByLabel.get(label);
			if (existing) return existing;
			const links = buildFallbackLinks(section);
			if (!links.length) return undefined;
			return {
				label,
				href,
				links,
				isCurrentGroup: links.some((link) => link.isCurrent),
			};
		})
		.filter((section): section is NonNullable<typeof section> => Boolean(section)),
	...extraGroups,
];

const orderedGroupSections = [...groupSections].sort(
	(a, b) => Number(b.isCurrentGroup) - Number(a.isCurrentGroup)
);

const sections = [
	...orderedGroupSections,
	navLinks.length
		? {
				label: 'Navigation',
				href: undefined,
				links: navLinks,
				isCurrentGroup: false,
			}
		: undefined,
].filter(Boolean) as {
	label: string;
	href?: string;
	links: SidebarLinkEntry[];
	isCurrentGroup: boolean;
}[];
---

<div class="catalog-drawer-nav">
	{sections.map((section) => (
		<section class="catalog-drawer-section">
			<div class="catalog-drawer-section-head">
				<h2>
					{section.href ? (
						<a href={section.href} class="catalog-section-link">
							<span>{section.label}</span>
							<span class="catalog-section-all">全部 ↗</span>
						</a>
					) : (
						<span>{section.label}</span>
					)}
				</h2>
			</div>
			<ul data-floral-vine>
				{section.links.map((link, index) => (
					<li style={`--i: ${Math.min(index, 8)}`}>
						<a href={link.href} aria-current={link.isCurrent ? 'page' : undefined}>
							<span>{link.label}</span>
						</a>
					</li>
				))}
			</ul>
		</section>
	))}
</div>

<div class="md:sl-hidden">
	<MobileMenuFooter />
</div>

<style>
.catalog-drawer-nav {
	display: grid;
	gap: 1.25rem;
}

.catalog-drawer-section h2 {
	display: flex;
	align-items: center;
	gap: 0.45rem;
	margin: 0 0 0.45rem;
	color: var(--sl-color-text);
	font-size: 0.85rem;
	font-weight: 600;
	letter-spacing: 0.05em;
}

.catalog-section-link {
	display: inline-flex;
	align-items: center;
	justify-content: space-between;
	flex: 1 1 auto;
	color: inherit;
	text-decoration: none;
	border-radius: 0.4rem;
	padding: 0.1rem 0.25rem 0.1rem 0;
	transition: color 0.2s ease;
}

.catalog-section-link:hover {
	color: var(--sl-color-accent);
}

.catalog-section-all {
	font-size: 0.7rem;
	font-weight: 400;
	color: var(--sl-color-gray-4);
	transition: color 0.2s ease, transform 0.2s ease;
}

.catalog-section-link:hover .catalog-section-all {
	color: var(--sl-color-accent);
	transform: translateX(2px);
}

.catalog-drawer-section ul {
	list-style: none;
	margin: 0;
	padding: 0;
	padding-inline-start: 1.25rem;
	display: grid;
	gap: 0.15rem;
	position: relative;
}

.catalog-drawer-section li {
	transform-origin: left center;
}

:global(body[data-drawer-open]) .catalog-drawer-section li {
	animation: floral-bloom 0.35s cubic-bezier(0.16, 1, 0.3, 1) both;
	animation-delay: calc(min(var(--i, 0), 8) * 30ms + 0.06s);
}

.catalog-drawer-section ul a {
	display: block;
	border-radius: var(--hananiwa-radius-sm, 0.6rem);
	padding: 0.34rem 0.65rem;
	color: var(--sl-color-gray-3);
	font-size: 0.88rem;
	line-height: 1.38;
	text-decoration: none;
	transition: background-color 0.22s ease, color 0.22s ease;
}

.catalog-drawer-section ul a:hover,
.catalog-drawer-section ul a:focus {
	color: var(--sl-color-text-accent);
	background: color-mix(in srgb, var(--sl-color-accent) 10%, transparent);
}

.catalog-drawer-section ul a[aria-current="page"] {
	color: var(--sl-color-accent);
	font-weight: 600;
	background: color-mix(in srgb, var(--sl-color-accent) 14%, transparent);
}

@media (max-width: 49.999rem) {
	.catalog-drawer-nav {
		gap: 1.45rem;
	}

	.catalog-drawer-section h2 {
		margin: 0 0 0.55rem;
		font-size: 0.9rem;
	}

	.catalog-drawer-section ul {
		padding-inline-start: 1.45rem;
	}

	.catalog-drawer-section ul a {
		padding: 0.5rem 0.45rem;
		color: var(--sl-color-text);
		font-size: var(--sl-text-sm);
	}
}
</style>
