---
import type { StarlightRouteData } from '@astrojs/starlight/route-data';
type SidebarEntry = StarlightRouteData["sidebar"][number];
type SidebarLinkEntry = Extract<SidebarEntry, { type: 'link' }>;
type SidebarGroupEntry = Extract<SidebarEntry, { type: 'group' }>;
import SidebarPersister from '@astrojs/starlight/components/SidebarPersister.astro';
import MobileMenuFooter from 'virtual:starlight/components/MobileMenuFooter';
import { getCollection } from 'astro:content';

const { sidebar } = Astro.locals.starlightRoute;

const docs = await getCollection('docs');
const dateByPath = new Map(
	docs
		.filter((entry) => entry.data.date instanceof Date)
		.map((entry) => [entry.id.toLowerCase(), entry.data.date!.getTime()])
);

function pathKey(href: string) {
	try {
		return decodeURIComponent(href).replace(/^\/+|\/+$/g, '').toLowerCase();
	} catch {
		return href.replace(/^\/+|\/+$/g, '').toLowerCase();
	}
}

function getEntryDate(entry: SidebarEntry) {
	return entry.type === 'link' ? dateByPath.get(pathKey(entry.href)) : undefined;
}

function sortEntries(entries: SidebarEntry[]): SidebarEntry[] {
	return entries
		.map((entry, index) => ({
			index,
			entry: entry.type === 'group' ? { ...entry, entries: sortEntries(entry.entries) } : entry,
		}))
		.sort((left, right) => {
			const leftDate = getEntryDate(left.entry);
			const rightDate = getEntryDate(right.entry);

			if (leftDate !== undefined && rightDate !== undefined && leftDate !== rightDate) {
				return rightDate - leftDate;
			}
			if (leftDate !== undefined && rightDate === undefined) return -1;
			if (leftDate === undefined && rightDate !== undefined) return 1;
			return left.index - right.index;
		})
		.map(({ entry }) => entry);
}

function hasCurrent(items: SidebarEntry[]): boolean {
	return items.some(item => item.type === 'link' ? item.isCurrent : hasCurrent(item.entries));
}

function getActiveContext(items: SidebarEntry[]): SidebarEntry[] {
	for (const item of items) {
		if (item.type === 'group' && hasCurrent(item.entries)) {
            if (item.label === 'Links') return []; // 强制隐藏 Links
			return [item];
		}
	}
	return [];
}

const contextSidebar = getActiveContext(sidebar);

// 提取所有链接为扁平结构，移除 details 折叠逻辑
const flattenedLinks: SidebarLinkEntry[] = [];
let currentCategory = "";

function flatten(items: SidebarEntry[], isTop = true) {
    for (const item of items) {
        if (item.type === 'group') {
            if (isTop) currentCategory = item.label;
            flatten(sortEntries(item.entries), false);
        } else if (item.type === 'link') {
            flattenedLinks.push(item);
        }
    }
}
flatten(contextSidebar);

function collectLinks(items: SidebarEntry[]): SidebarLinkEntry[] {
	return sortEntries(items).flatMap((item) => {
		if (item.type === 'link') return [item];
		if (item.type === 'group') return collectLinks(item.entries);
		return [];
	});
}

const mobileTopLinks = sidebar.filter((item): item is SidebarLinkEntry => item.type === 'link');
const mobileSections = [
	mobileTopLinks.length ? { label: 'Navigation', links: mobileTopLinks } : undefined,
	...sidebar
		.filter((item): item is SidebarGroupEntry => item.type === 'group')
		.map((item) => ({ label: item.label, links: collectLinks(item.entries) }))
		.filter((section) => section.links.length > 0),
].filter(Boolean) as { label: string; links: SidebarLinkEntry[] }[];

const hasDesktopContext = flattenedLinks.length > 0;
---

<div class="desktop-sidebar-context">
	{hasDesktopContext ? (
		<SidebarPersister>
			{currentCategory && (
				<div class="sidebar-category-title">{currentCategory}</div>
			)}
			<ul class="flat-sidebar-list" data-floral-vine>
				{flattenedLinks.map((link, index) => (
					<li style={`--i: ${index}`}>
						<a href={link.href} aria-current={link.isCurrent ? 'page' : undefined} class={link.isCurrent ? 'active large' : 'large'}>
							<span>{link.label}</span>
						</a>
					</li>
				))}
			</ul>
		</SidebarPersister>
	) : (
		<div class="desktop-sidebar-fallback">
			{mobileSections.map((section) => (
				<section class="desktop-sidebar-section">
					<h2>{section.label}</h2>
					<ul data-floral-vine>
						{section.links.map((link, index) => (
							<li style={`--i: ${index}`}>
								<a href={link.href} aria-current={link.isCurrent ? 'page' : undefined}>
									<span>{link.label}</span>
								</a>
							</li>
						))}
					</ul>
				</section>
			))}
		</div>
	)}
</div>

<div class="mobile-sidebar-nav">
	{mobileSections.map((section) => (
		<section class="mobile-sidebar-section">
			<h2>{section.label}</h2>
			<ul data-floral-vine>
				{section.links.map((link, index) => (
					<li style={`--i: ${index}`}>
						<a href={link.href} aria-current={link.isCurrent ? 'page' : undefined}>
							<span>{link.label}</span>
						</a>
					</li>
				))}
			</ul>
		</section>
	))}
</div>

<div class="md:sl-hidden">
	<MobileMenuFooter />
</div>

<style>
.mobile-sidebar-nav {
	display: none;
}

.desktop-sidebar-fallback {
	display: grid;
	gap: 1rem;
}

.sidebar-category-title,
.desktop-sidebar-section h2,
.mobile-sidebar-section h2 {
	display: flex;
	align-items: center;
	gap: 0.45rem;
	color: var(--sl-color-text);
	font-weight: 600;
	letter-spacing: 0.05em;
}

.sidebar-category-title::before,
.desktop-sidebar-section h2::before,
.mobile-sidebar-section h2::before {
	content: "✿";
	color: var(--sl-color-accent);
	font-size: 0.85em;
}

.sidebar-category-title {
	margin-bottom: 1rem;
	font-size: 0.92rem;
}

.desktop-sidebar-section h2 {
	margin: 0 0 0.45rem;
	font-size: 0.82rem;
}

.desktop-sidebar-section ul,
.mobile-sidebar-section ul {
	list-style: none;
	margin: 0;
	padding: 0;
	display: grid;
}

.desktop-sidebar-section ul {
	gap: 0.15rem;
	position: relative;
	padding-inline-start: 1.2rem;
}

.desktop-sidebar-section a {
	display: block;
	border-radius: 0.6rem;
	padding: 0.28rem 0.65rem;
	color: var(--sl-color-gray-3);
	font-size: 0.86rem;
	line-height: 1.35;
	text-decoration: none;
	transition: background-color 0.25s ease, color 0.25s ease;
}

.desktop-sidebar-section a:hover,
.desktop-sidebar-section a:focus {
	color: var(--sl-color-text-accent);
	background: color-mix(in srgb, var(--sl-color-accent) 10%, transparent);
}

.desktop-sidebar-section a[aria-current="page"] {
	color: var(--sl-color-accent);
	font-weight: 600;
	background: color-mix(in srgb, var(--sl-color-accent) 14%, transparent);
}

.desktop-sidebar-section a[aria-current="page"] span::before,
.flat-sidebar-list a[aria-current="page"] span::before {
	content: "✦ ";
	color: var(--sl-color-accent-high);
	font-size: 0.75em;
}

.flat-sidebar-list {
	list-style: none;
	padding: 0;
	padding-inline-start: 0.75rem;
	margin: 0;
	display: flex;
	flex-direction: column;
	gap: 0.25rem;
	position: relative;
}

.flat-sidebar-list a {
	display: block;
	border-radius: 0.6rem;
	padding: 0.34rem 0.65rem;
	color: var(--sl-color-gray-3);
	font-size: 0.9rem;
	line-height: 1.4;
	text-decoration: none;
	transition: background-color 0.25s ease, color 0.25s ease;
}

.flat-sidebar-list a:hover,
.flat-sidebar-list a:focus {
	color: var(--sl-color-text-accent);
	background: color-mix(in srgb, var(--sl-color-accent) 10%, transparent);
}

.flat-sidebar-list a[aria-current="page"] {
	color: var(--sl-color-accent);
	font-weight: 600;
	background: color-mix(in srgb, var(--sl-color-accent) 14%, transparent);
}

.flat-sidebar-list li,
.desktop-sidebar-section li {
	transform-origin: left center;
	animation: floral-bloom 0.45s cubic-bezier(0.16, 1, 0.3, 1) both;
	animation-delay: calc(var(--i, 0) * 50ms + 0.1s);
}

@media (max-width: 49.999rem) {
	.desktop-sidebar-context {
		display: none;
	}

	.mobile-sidebar-nav {
		display: grid;
		gap: 1.6rem;
	}

	.mobile-sidebar-section h2 {
		margin: 0 0 0.6rem;
		font-size: 0.9rem;
	}

	/* 藤蔓与花由 floral-vine 元算法生成，这里只留正文留白 */
	.mobile-sidebar-section ul {
		position: relative;
		gap: 0.1rem;
		padding-inline-start: 1.5rem;
	}

	/* 展开时条目错峰绽放，每次开抽屉重播 */
	:global(body[data-drawer-open]) .mobile-sidebar-section li {
		transform-origin: left center;
		animation: floral-bloom 0.45s cubic-bezier(0.16, 1, 0.3, 1) both;
		animation-delay: calc(var(--i, 0) * 50ms + 0.15s);
	}

	.mobile-sidebar-section a {
		display: block;
		border-radius: 0.6rem;
		padding: 0.55rem 0.4rem;
		color: var(--sl-color-text);
		font-size: var(--sl-text-sm);
		line-height: 1.35;
		text-decoration: none;
		transition: color 0.2s ease;
	}

	.mobile-sidebar-section a:hover,
	.mobile-sidebar-section a:focus {
		color: var(--sl-color-accent);
	}

	.mobile-sidebar-section a[aria-current="page"] {
		color: var(--sl-color-accent);
		font-weight: 600;
	}
}
</style>

<script>
	import { bindFloralVines } from "../utils/floral-vine";
	bindFloralVines();
	document.addEventListener("astro:page-load", () => bindFloralVines());
</script>
