---
import {
  formatIsoDate,
  getPostHref,
  getSectionMeta,
  getTagHref,
  type DocsEntry,
} from "../utils/content";
import { excerptOf } from "../utils/excerpt";

interface Props {
  posts: DocsEntry[];
  sectionLabelOverride?: string;
}

const { posts, sectionLabelOverride } = Astro.props;

const timeline = posts
  .map((post) => {
    const meta = getSectionMeta(post);
    const summary = post.data.description?.trim() || excerptOf(post.body, 140);
    return {
      post,
      summary,
      section: sectionLabelOverride || meta.sectionLabel,
      sectionLevel: meta.sectionLevel,
    };
  })
  .sort((left, right) => {
    const leftDate = left.post.data.date ? new Date(left.post.data.date).getTime() : 0;
    const rightDate = right.post.data.date ? new Date(right.post.data.date).getTime() : 0;
    return rightDate - leftDate || right.post.id.localeCompare(left.post.id);
  });
---

<div
  class="timeline"
  data-floral-vine='{"items": ":scope > .timeline-item", "current": "", "vineX": 10, "meander": 2.2}'
>
  {
    timeline.map(({ post, summary, section, sectionLevel }) => (
      <article class="timeline-item" data-level={sectionLevel}>
        <div class="timeline-content">
          <div class="timeline-meta">
            <div class="timeline-meta-left">
              <span class="timeline-section">{section}</span>
              {post.data.tags && post.data.tags.length > 0 && (
                <div class="timeline-tags">
                  {post.data.tags.map((tag: string) => (
                    <a href={getTagHref(tag)}>#{tag}</a>
                  ))}
                </div>
              )}
            </div>
            {post.data.date && (
              <time datetime={formatIsoDate(post.data.date)}>{formatIsoDate(post.data.date)}</time>
            )}
          </div>
          <h2>
            <a href={getPostHref(post)}>{post.data.title}</a>
          </h2>
          {summary && <p class="timeline-desc">{summary}</p>}
        </div>
      </article>
    ))
  }
  {timeline.length === 0 && <p class="timeline-empty">暂无文章记录。</p>}
</div>

<style>
  .timeline {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding-inline-start: 1.8rem;
  }

  .timeline-item {
    position: relative;
    display: block;
    padding: 0.72rem 0.85rem;
    border-radius: var(--hananiwa-radius-sm, 0.6rem);
    border-bottom: 1px solid color-mix(in srgb, var(--sl-color-gray-6) 55%, transparent);
    transition: background-color 0.18s ease, transform 0.18s ease;
  }

  .timeline-item:last-child {
    border-bottom: none;
  }

  .timeline-item:hover {
    background: color-mix(in srgb, var(--sl-color-accent) 6%, transparent);
    transform: translateX(2px);
  }

  .timeline-item[data-level="1"],
  .timeline-item[data-level="2"],
  .timeline-item[data-level="3"],
  .timeline-item[data-level="4"] {
    --timeline-accent: var(--sl-color-accent-high);
  }

  .timeline-content {
    min-width: 0;
  }

  .timeline-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 0.32rem;
  }

  .timeline-meta-left {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.45rem;
    min-width: 0;
  }

  .timeline-meta time {
    flex: 0 0 auto;
    font-family: var(--sl-font-mono);
    color: var(--sl-color-gray-3);
    font-size: 0.74rem;
    letter-spacing: 0.02em;
  }

  .timeline-section {
    display: inline-flex;
    align-items: center;
    min-height: 1.35rem;
    padding: 0.08rem 0.5rem;
    border: 1px solid color-mix(in srgb, var(--sl-color-accent) 30%, transparent);
    border-radius: 999px;
    background: color-mix(in srgb, var(--sl-color-accent) 10%, transparent);
    color: var(--timeline-accent, var(--sl-color-accent-high));
    font-size: 0.68rem;
    font-weight: 600;
    line-height: 1;
    white-space: nowrap;
  }

  .timeline-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.42rem;
  }

  .timeline-tags a {
    position: relative;
    z-index: 2;
    color: var(--sl-color-gray-3);
    font-size: 0.7rem;
    text-decoration: none;
    transition: color 0.16s ease;
  }

  .timeline-item h2 {
    margin: 0;
    font-family: var(--hananiwa-font-serif, "Songti SC", "Source Han Serif SC", "Noto Serif CJK SC", "STSong", Georgia, serif);
    color: var(--sl-color-white);
    font-size: 1.06rem;
    font-weight: 600;
    line-height: 1.42;
    letter-spacing: 0.02em;
  }

  .timeline-item h2 a {
    color: inherit;
    text-decoration: none;
    transition: color 0.18s ease;
  }

  .timeline-item h2 a::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .timeline-item:hover h2 a,
  .timeline-item h2 a:hover {
    color: var(--sl-color-accent-high);
  }

  .timeline-tags a:hover {
    color: var(--sl-color-accent-high);
    text-decoration: underline;
  }

  .timeline-desc {
    display: -webkit-box;
    margin: 0.3rem 0 0 !important;
    overflow: hidden;
    color: var(--sl-color-gray-3);
    font-size: 0.84rem;
    line-height: 1.55;
    text-align: start !important;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .timeline-empty {
    margin: 0 !important;
    padding: 1rem 0.5rem;
    color: var(--sl-color-gray-3);
    font-size: 0.86rem;
    text-align: start !important;
  }

  @media (max-width: 49.999rem) {
    .timeline {
      padding-inline-start: 1.55rem;
    }

    .timeline-item {
      padding: 0.65rem 0.5rem;
    }

    .timeline-item:hover {
      transform: none;
    }

    .timeline-meta {
      align-items: flex-start;
      flex-direction: column;
      gap: 0.35rem;
    }

    .timeline-meta time {
      order: -1;
    }
  }
</style>
