---
import type { CollectionEntry } from "astro:content";

interface Props {
  posts: CollectionEntry<"docs">[];
}

const { posts } = Astro.props;
const sectionLabels = new Map([
  ["blog", "Essay"],
  ["log", "Log"],
  ["coding-notes", "Notes"],
]);
const sectionOrder = ["blog", "log", "coding-notes"];
const timeline = posts
  .map((post) => {
    const sectionSlug = post.id.split("/")[0];
    const sectionIndex = sectionOrder.indexOf(sectionSlug);
    return {
      post,
      section: sectionLabels.get(sectionSlug) || sectionSlug,
      sectionLevel: (sectionIndex < 0 ? 3 : sectionIndex) + 1,
    };
  })
  .sort((left, right) => {
    const leftDate = left.post.data.date ? new Date(left.post.data.date).getTime() : 0;
    const rightDate = right.post.data.date ? new Date(right.post.data.date).getTime() : 0;
    return rightDate - leftDate;
  });
---

<div class="timeline">
  {
    timeline.map(({ post, section, sectionLevel }) => (
      <article class="timeline-item">
        <div class="timeline-marker" data-level={sectionLevel} />
        <div class="timeline-content">
          <div class="timeline-meta">
            <div class="timeline-tags">
              <span class="timeline-section" data-level={sectionLevel}>{section}</span>
              {post.data.tags?.map((tag) => <a href={`/tags/${encodeURIComponent(tag)}`}>#{tag}</a>)}
            </div>
            {post.data.date && <time>{new Date(post.data.date).toISOString().slice(0, 10)}</time>}
          </div>
          <h2><a href={`/${post.id}`}>{post.data.title}</a></h2>
          {post.data.description && <p>{post.data.description}</p>}
        </div>
      </article>
    ))
  }
  {timeline.length === 0 && <p class="empty">No posts found.</p>}
</div>

<style>
  .timeline {
    position: relative;
    display: flex;
    flex-direction: column;
  }

  .timeline::before {
    position: absolute;
    top: 0.4rem;
    bottom: 0.4rem;
    left: 0.36rem;
    width: 1px;
    background: var(--sl-color-gray-6);
    content: "";
  }

  .timeline-item {
    position: relative;
    display: grid;
    grid-template-columns: 1rem minmax(0, 1fr);
    gap: 0.75rem;
    padding: 0.55rem 0.6rem 0.55rem 0;
    border-radius: 0.7rem;
    transition: background 0.15s ease;
  }

  .timeline-item:hover { background: var(--sl-color-gray-7, var(--sl-color-gray-6)); }

  .timeline-marker {
    position: relative;
    z-index: 1;
    width: 0.72rem;
    height: 0.72rem;
    margin-top: 0.42rem;
    border: 2px solid var(--sl-color-bg);
    border-radius: 999px;
    background: var(--timeline-blue, #8fb2da);
    box-shadow: 0 0 0 1px var(--sl-color-gray-6);
  }

  .timeline-content { min-width: 0; }

  .timeline-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 0.25rem;
  }

  .timeline-tags { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem; }

  .timeline-meta time,
  .timeline-tags a {
    position: relative;
    z-index: 1;
    color: var(--sl-color-gray-4);
    font-size: 0.68rem;
  }

  .timeline-section {
    display: inline-flex;
    align-items: center;
    min-height: 1.35rem;
    padding: 0 0.45rem;
    border: 1px solid var(--sl-color-gray-6);
    border-radius: 999px;
    background: var(--sl-color-gray-7, var(--sl-color-gray-6));
    color: var(--timeline-blue, #8fb2da);
    font-size: 0.68rem;
    font-weight: 600;
  }

  h2 { margin: 0; color: var(--sl-color-white); font-size: 0.88rem; line-height: 1.35; }
  h2 a { color: inherit; text-decoration: none; }
  h2 a:hover, .timeline-tags a:hover { color: var(--sl-color-white); text-decoration: underline; }

  p { display: -webkit-box; margin: 0.18rem 0 0; overflow: hidden; color: var(--sl-color-gray-4); font-size: 0.74rem; line-height: 1.45; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
  .empty { padding: 1rem; }

  [data-level="1"] { --timeline-blue: #8fb2da; }
  [data-level="2"] { --timeline-blue: #5f8fc2; }
  [data-level="3"] { --timeline-blue: #356b9d; }
  [data-level="4"] { --timeline-blue: #16436e; }
</style>
