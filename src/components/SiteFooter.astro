      </div>
    </div>
  </div>
</div>

<style>
  .site-global-footer {
    width: 100%;
    margin-top: 3.5rem;
    box-sizing: border-box;
  }

  .site-footer-card {
    background: var(--sl-color-bg);
    border: 1px solid var(--sl-color-gray-6);
    border-radius: 1.25rem;
    padding: 2.25rem 2.5rem;
    box-sizing: border-box;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .site-footer-card:hover {
    border-color: var(--sl-color-gray-5);
  }

  .site-footer-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr 1.15fr;
    gap: 2.5rem;
    align-items: start;
  }

  .site-footer-col {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    min-width: 0;
  }

  .site-footer-brand-title {
    font-family: "Songti SC", "Source Han Serif SC", "STSong", serif;
    font-size: 1.45rem;
    font-weight: 600;
    color: var(--sl-color-text);
    margin: 0;
    letter-spacing: 0.05em;
    line-height: 1.2;
  }

  .site-footer-brand-motto {
    font-family: "Songti SC", "Source Han Serif SC", serif;
    font-size: 0.85rem;
    color: var(--sl-color-gray-3);
    line-height: 1.6;
    margin: 0;
  }

  .site-footer-subscribe-form {
    display: flex;
    align-items: center;
    margin-top: 0.5rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 999px;
    overflow: hidden;
    background: var(--sl-color-gray-7, var(--sl-color-gray-6));
    max-width: 22rem;
    transition: border-color 0.2s ease;
  }

  .site-footer-subscribe-form:focus-within {
    border-color: var(--sl-color-accent);
  }

  .site-footer-subscribe-input {
    flex: 1 1 auto;
    border: none;
    background: transparent;
    padding: 0.55rem 1rem;
    font-size: 0.82rem;
    color: var(--sl-color-text);
    outline: none;
    min-width: 0;
  }

  .site-footer-subscribe-btn {
    padding: 0.55rem 1.1rem;
    background: var(--sl-color-gray-6);
    color: var(--sl-color-text);
    border: none;
    border-inline-start: 1px solid var(--sl-color-gray-5);
    font-size: 0.8rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .site-footer-subscribe-btn:hover {
    background: color-mix(in srgb, var(--sl-color-accent) 20%, transparent);
    color: var(--sl-color-accent);
  }

  .site-footer-heading {
    font-family: var(--sl-font-mono);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    color: var(--sl-color-gray-4);
    margin: 0;
    text-transform: uppercase;
  }

  .site-footer-links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }

  .site-footer-links a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.88rem;
    color: var(--sl-color-gray-2);
    text-decoration: none;
    transition: color 0.2s ease, transform 0.2s ease;
  }

  .site-footer-links a:hover {
    color: var(--sl-color-accent);
    transform: translateX(2px);
  }

  .link-bullet {
    font-size: 0.65rem;
    color: var(--sl-color-accent);
    opacity: 0.85;
  }

  .en-code {
    font-family: var(--sl-font-mono);
    font-size: 0.7rem;
    color: var(--sl-color-gray-4);
    letter-spacing: 0.05em;
  }

  .site-footer-connect svg {
    color: var(--sl-color-gray-3);
    transition: color 0.2s ease;
    flex-shrink: 0;
  }

  .site-footer-connect a:hover svg {
    color: var(--sl-color-accent);
  }

  .site-footer-stats {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .site-footer-stats li {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 0.35rem;
    border-bottom: 1px dashed var(--sl-color-gray-6);
    font-size: 0.86rem;
  }

  .stat-left {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }

  .stat-label {
    color: var(--sl-color-gray-3);
  }

  .stat-value {
    font-family: var(--sl-font-mono);
    font-weight: 600;
    color: var(--sl-color-text);
    font-size: 0.88rem;
  }

  .stat-online {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: #52c41a;
  }

  .online-indicator {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: #52c41a;
    box-shadow: 0 0 6px #52c41a;
  }

  @media (max-width: 980px) {
    .site-footer-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 2rem;
    }
  }

  @media (max-width: 640px) {
    .site-footer-card {
      padding: 1.5rem 1.25rem;
      border-radius: 1rem;
    }
    .site-footer-grid {
      grid-template-columns: 1fr;
      gap: 1.75rem;
    }
  }
</style>
