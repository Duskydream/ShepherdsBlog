---
import { Icon } from '@astrojs/starlight/components';

type TocItem = {
  text: string;
  slug: string;
  children: TocItem[];
};

interface Props {
  items: TocItem[];
  depth?: number;
}

const { items, depth = 0 } = Astro.props;
const shouldNestUnderOverview = depth === 0 && items[0]?.slug === '_top' && items.length > 1;
const renderedItems = shouldNestUnderOverview
  ? [
      {
        ...items[0],
        children: [...items[0].children, ...items.slice(1)],
      },
    ]
  : items;
---

<ul class:list={['mobile-toc-list', { 'is-nested': depth > 0 }]} style={`--depth: ${depth}`}>
  {
    renderedItems.map((heading, index) => {
      const hasChildren = heading.children.length > 0;
      return (
        <li class:list={{ 'has-children': hasChildren }} style={`--i: ${index}`}>
          <div class="mobile-toc-row">
            <a href={`#${heading.slug}`}>
              <span>{heading.text}</span>
            </a>
            {hasChildren && (
              <button
                type="button"
                class="mobile-toc-branch-toggle"
                aria-expanded="true"
                aria-label={`切换 ${heading.text} 子目录`}
              >
                <Icon name="right-caret" class="mobile-toc-branch-caret" size="1rem" />
              </button>
            )}
          </div>
          {
            hasChildren && (
              <div class="mobile-toc-children">
                <Astro.self items={heading.children} depth={depth + 1} />
              </div>
            )
          }
        </li>
      );
    })
  }
</ul>

<style>
  .mobile-toc-list {
    --mobile-tree-indent: 0.95rem;
    --mobile-tree-pad-inline: 0.15rem;
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.18rem;
    contain: content;
  }

  .mobile-toc-list:not(.is-nested) {
    padding-inline-start: 1.15rem;
  }

  .mobile-toc-list.is-nested {
    margin-block: 0.2rem 0.45rem;
    margin-inline-start: var(--mobile-tree-indent);
    padding-inline-start: var(--mobile-tree-indent);
  }

  .mobile-toc-list li {
    min-width: 0;
    overflow-wrap: anywhere;
  }

  /* 枝干弧线：沿嵌套条目延续的竖茎 + 圆角折线伸向行 */
  .mobile-toc-list.is-nested > li {
    position: relative;
  }

  .mobile-toc-list.is-nested > li::before {
    content: "";
    position: absolute;
    left: calc(-1 * var(--mobile-tree-indent));
    top: -0.2rem;
    bottom: -0.2rem;
    border-left: 1px solid var(--sl-color-hairline-shade);
    pointer-events: none;
  }

  .mobile-toc-list.is-nested > li:first-child::before {
    top: -0.35rem;
  }

  .mobile-toc-list.is-nested > li:last-child::before {
    bottom: auto;
    width: var(--mobile-tree-indent);
    height: 1.22rem;
    border-bottom: 1px solid var(--sl-color-hairline-shade);
    border-bottom-left-radius: 0.6rem;
  }

  .mobile-toc-list.is-nested > li:not(:last-child)::after {
    content: "";
    position: absolute;
    left: calc(-1 * var(--mobile-tree-indent) + 1px);
    top: 1.22rem;
    width: calc(var(--mobile-tree-indent) - 0.35rem);
    height: 1px;
    background: var(--sl-color-hairline-shade);
    pointer-events: none;
  }

  .mobile-toc-list .mobile-toc-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.85rem;
  }

  .mobile-toc-list a {
    display: flex;
    flex: 1 1 auto;
    align-items: center;
    gap: 0.5rem;
    min-width: 0;
    min-height: 2.45rem;
    padding: 0.44rem var(--mobile-tree-pad-inline);
    border-radius: 0.6rem;
    color: var(--sl-color-text);
    font-size: var(--sl-text-sm);
    line-height: 1.35;
    text-decoration: none;
    outline-offset: var(--sl-outline-offset-inside);
    transition: color 0.2s ease, background-color 0.2s ease;
  }

  /* 花苞：每个条目前的小花，活动位置绽放 */
  .mobile-toc-list a::before {
    content: "✿";
    flex: 0 0 auto;
    color: var(--sl-color-accent);
    font-size: 0.55rem;
    opacity: 0.4;
    transition: opacity 0.2s ease;
  }

  .mobile-toc-list:not(.is-nested) > li > .mobile-toc-row > a {
    font-size: var(--sl-text-base);
    font-weight: 700;
  }

  .mobile-toc-list a:hover,
  .mobile-toc-list a:focus {
    color: var(--sl-color-accent);
    background: color-mix(in srgb, var(--sl-color-accent) 8%, transparent);
  }

  .mobile-toc-list a:hover::before,
  .mobile-toc-list a:focus::before {
    opacity: 0.8;
  }

  .mobile-toc-list a[aria-current="true"] {
    color: var(--sl-color-accent);
    font-weight: 700;
  }

  .mobile-toc-list a[aria-current="true"]::before {
    font-size: 0.8rem;
    opacity: 1;
  }

  .mobile-toc-branch-toggle {
    flex: 0 0 auto;
    width: 2.45rem;
    min-height: 2.45rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 0;
    border-radius: 0.6rem;
    padding: 0;
    color: var(--sl-color-gray-3);
    background: transparent;
    cursor: pointer;
  }

  .mobile-toc-branch-toggle:hover,
  .mobile-toc-branch-toggle:focus-visible {
    color: var(--sl-color-accent);
  }

  .mobile-toc-branch-caret {
    transition: transform 0.18s ease;
  }

  .mobile-toc-branch-toggle[aria-expanded="true"] .mobile-toc-branch-caret {
    transform: rotate(90deg);
  }

  .mobile-toc-children {
    display: contents;
  }

  .mobile-toc-children[hidden] {
    display: none;
  }

  /* 逐项生长：藤茎画线后按序号错峰绽放，每次展开重播 */
  .mobile-toc-list li {
    transform-origin: left center;
    animation: floral-bloom 0.45s cubic-bezier(0.16, 1, 0.3, 1) both;
    animation-delay: calc(var(--i, 0) * 60ms + 0.15s);
  }
</style>
