---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import ContentTimeline from "./ContentTimeline.astro";
import { getSortedPosts } from "../utils/content";

type Props = {
  title: string;
  section: string;
  eyebrow?: string;
  /** 聚合页自己的描述。不传就会退回站点通用描述，和首页重复。 */
  description?: string;
};

const { title, section, eyebrow = title, description } = Astro.props;
const posts = await getSortedPosts(section);

function labelFromSlug(slug: string) {
  return slug
    .split("-")
    .filter(Boolean)
    .map((part) => part.charAt(0).toUpperCase() + part.slice(1))
    .join(" ");
}

const sectionLabel = title || labelFromSlug(section);
---

<StarlightPage frontmatter={{ title, description, template: 'splash', tableOfContents: false }} hasSidebar={false}>
  <section class="section-index not-content">
    <header class="section-index-head">
      <p>{eyebrow}</p>
      <h1>{title}</h1>
    </header>

    <div class="section-index-card">
      <div class="section-index-card-head">
        <div class="section-index-card-title">
          <span>{sectionLabel} Timeline</span>
        </div>
        <span class="section-index-count">{posts.length} posts</span>
      </div>

      <div class="section-index-card-body">
        <ContentTimeline posts={posts} sectionLabelOverride={sectionLabel} />
      </div>
    </div>
  </section>

  <style>
    .section-index {
      max-width: 64rem;
      margin: 0 auto;
      padding: 1.5rem 1rem 3rem;
    }

    .section-index-head {
      margin-bottom: 1.25rem;
      border-bottom: 1px solid var(--sl-color-hairline-shade);
      padding-bottom: 1rem;
    }

    .section-index-head p {
      margin: 0 0 0.35rem;
      color: var(--sl-color-accent);
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Courier New", monospace;
      font-size: 0.78rem;
      font-weight: 700;
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }

    .section-index-head h1 {
      margin: 0;
      color: var(--sl-color-white);
      font-size: clamp(2rem, 7vw, 3.75rem);
      line-height: 1;
      letter-spacing: 0;
    }

    .section-index-card {
      margin: 0;
      border: 1px solid var(--sl-color-gray-6);
      border-radius: 1rem;
      background: var(--sl-color-bg);
      overflow: hidden;
      transition:
        border-color 0.2s ease,
        box-shadow 0.2s ease;
    }

    .section-index-card:hover {
      border-color: var(--sl-color-gray-5);
    }

    .section-index-card-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      border-bottom: 1px solid var(--sl-color-gray-6);
      padding: 0.75rem 1rem;
    }

    .section-index-card-title {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      color: var(--sl-color-white);
      font-size: 0.85rem;
      font-weight: 650;
    }

    .section-index-count {
      color: var(--sl-color-gray-4);
      font-size: 0.72rem;
      white-space: nowrap;
    }

    .section-index-card-body {
      padding: 0.75rem 1rem;
    }

    @media (max-width: 49.999rem) {
      .section-index {
        padding-inline: 1.25rem;
      }

      .section-index-card-head {
        align-items: flex-start;
        flex-direction: column;
        gap: 0.35rem;
      }

      .section-index-card-body {
        padding-inline: 0.85rem;
      }
    }
  </style>
</StarlightPage>
