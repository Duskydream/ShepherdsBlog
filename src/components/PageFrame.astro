---
import MobileTableOfContents from "virtual:starlight/components/MobileTableOfContents";
import Sidebar from "./Sidebar.astro";
import LilyOrnament from "./LilyOrnament.astro";
---

<div class="page sl-flex">
  <div class="reading-progress" aria-hidden="true"></div>
  <header class="header" transition:name="site-header" transition:animate="none">
    <slot name="header" />
  </header>
  <MobileTableOfContents />
  <nav
    class="sidebar print:hidden"
    aria-label={Astro.locals.t("sidebarNav.accessibleLabel")}
  >
    <div class="drawer-scrim" aria-hidden="true"></div>
    <div id="starlight__sidebar" class="sidebar-pane drawer-pane" role="dialog" aria-modal="true" aria-labelledby="drawer-title" aria-hidden="true" inert tabindex="-1">
      <div class="drawer-decor" aria-hidden="true">
        <LilyOrnament id="drawer-lily" />
      </div>
      <div class="drawer-header">
        <span id="drawer-title" class="drawer-title">✦ 祈りの花庭 · 目録</span>
        <button type="button" class="drawer-close-btn" aria-label="关闭目录">✕</button>
      </div>
      <div class="sidebar-content sl-flex">
        <Sidebar />
      </div>
    </div>
  </nav>
  <div class="main-frame"><slot /></div>
</div>

<style>
  @layer starlight.core {
    .page {
      flex-direction: column;
      min-height: 100vh;
    }

    .header {
      z-index: var(--sl-z-index-navbar);
      position: fixed;
      inset-inline-start: 0;
      inset-block-start: 0;
      width: 100%;
      height: var(--sl-nav-height);
      border-bottom: 1px solid var(--sl-color-hairline-shade);
      padding: var(--sl-nav-pad-y) var(--sl-nav-pad-x);
      background-color: var(--sl-color-bg-nav);
      backdrop-filter: blur(16px);
    }

    .main-frame {
      padding-top: var(--sl-nav-height);
      padding-inline-start: 0 !important;
      width: 100%;
      max-width: 100%;
      display: flex;
      justify-content: center;
    }

    :global(:root[data-has-toc]) .main-frame {
      padding-top: calc(var(--sl-nav-height) + var(--sl-mobile-toc-height));
    }

    @media (min-width: 72rem) {
      .main-frame,
      :global(:root[data-has-toc]) .main-frame {
        padding-top: var(--sl-nav-height);
      }
    }

    :global(.main-pane) {
      width: 100%;
      min-width: 0;
      display: flex;
      justify-content: center;
    }

    :global(.content-panel) {
      width: 100%;
      max-width: min(52rem, 100%);
      padding: 1.5rem 1.25rem 3.5rem;
      box-sizing: border-box;
    }

    :global(.content-panel:has(.not-content)) {
      max-width: min(88rem, 100%);
      padding-inline: 0.5rem;
    }

    @media (max-width: 50rem) {
      :global(.content-panel) {
        padding: 0.85rem 0.85rem 3rem !important;
      }
      :global(.content-panel:has(.not-content)) {
        padding: 0.85rem 0.85rem 3rem !important;
      }
    }

    /* Floating Floral Drawer：透明点击层 + 不透明主题色面板 */
    .drawer-scrim {
      position: fixed;
      inset: 0;
      z-index: 1200;
      background: transparent;
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
      transition: opacity 0.25s ease, visibility 0.25s ease;
    }

    .drawer-pane {
      position: fixed;
      inset-block: 0.75rem;
      inset-inline-start: 0.75rem;
      z-index: 1210;
      width: min(22rem, calc(100vw - 2.5rem));
      background: var(--sl-color-bg);
      border: 1px solid color-mix(in srgb, var(--sl-color-accent) 25%, transparent);
      border-radius: 1rem;
      box-shadow: 0 8px 32px color-mix(in srgb, var(--sl-color-accent) 14%, transparent);
      transform: translateX(calc(-100% - 1rem));
      visibility: hidden;
      transition: transform 0.28s cubic-bezier(0.16, 1, 0.3, 1);
      overflow-y: auto;
      /* 右下角百合装饰以负偏移定位，overflow-y:auto 会让 overflow-x 也变成
         auto，从而多出一条横向滚动条；clip 只裁剪不产生滚动 */
      overflow-x: clip;
      display: flex;
      flex-direction: column;
    }

    /* 抽屉右下角百合线稿装饰 */
    .drawer-decor {
      position: absolute;
      right: -0.5rem;
      bottom: -0.5rem;
      width: 12.5rem;
      height: 12.5rem;
      pointer-events: none;
      opacity: 0.42;
      z-index: 0;
    }

    .drawer-decor :global(.lily-ornament) {
      width: 100%;
      height: 100%;
    }

    .drawer-header {
      position: relative;
      z-index: 1;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 1.25rem 1.25rem 0.75rem;
      border-bottom: 0;
      background: linear-gradient(to right, color-mix(in srgb, var(--sl-color-accent) 45%, transparent), transparent 85%) left bottom / 100% 1px no-repeat;
    }

    .drawer-title {
      font-family: "Songti SC", "Source Han Serif SC", serif;
      font-size: 0.95rem;
      font-weight: 600;
      color: var(--sl-color-accent);
      letter-spacing: 0.05em;
    }

    .drawer-close-btn {
      background: transparent;
      border: 1px solid var(--sl-color-gray-5);
      border-radius: 50%;
      width: 1.75rem;
      height: 1.75rem;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      color: var(--sl-color-gray-3);
      cursor: pointer;
      font-size: 0.75rem;
      transition: color 0.2s ease, background-color 0.2s ease, border-color 0.2s ease;
    }

    .drawer-close-btn:hover {
      color: var(--sl-color-white);
      border-color: var(--sl-color-accent);
    }

    .sidebar-content {
      position: relative;
      z-index: 1;
      flex: 1 1 auto;
      padding: 1rem 1.25rem 2rem;
      flex-direction: column;
      gap: 1rem;
    }

    /* Open state */
    :global(body[data-drawer-open]) .drawer-scrim {
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
    }

    :global(body[data-drawer-open]) .drawer-pane {
      transform: translateX(0);
      visibility: visible;
    }

    :global(body[data-drawer-open]) {
      overflow: hidden;
    }

    /* 阅读进度：顶部随滚动生长的藤蔓 */
    .reading-progress {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 2px;
      z-index: 1100;
      transform: scaleX(0);
      transform-origin: 0 50%;
      background: linear-gradient(90deg, transparent, var(--sl-color-accent));
      pointer-events: none;
    }

    @media (prefers-reduced-motion: reduce) {
      .reading-progress {
        transition: none;
      }
    }
  }
</style>

<script>
  import { initDrawer } from "../utils/drawer";
  import { initArticleReading } from "../utils/article-reading";

  function initPageInteractions() {
    initDrawer();
    initArticleReading();
  }
  initPageInteractions();
  document.addEventListener("astro:page-load", initPageInteractions);
</script>
