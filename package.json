{
  "name": "starlight",
  "type": "module",
  "version": "0.0.1",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "check": "astro check",
    "clean:astro": "node ./scripts/clean-astro.mjs",
    "refresh:bangumi": "node ./scripts/fetch-bangumi.mjs",
    "refresh:images": "node ./scripts/build-images.mjs",
    "sync:commits": "node ./scripts/sync-commits.mjs",
    "build": "node ./scripts/clean-astro.mjs && pnpm run sync:commits && pnpm run refresh:bangumi && pnpm run refresh:images && astro build",
    "build:fast": "astro build",
    "build:functions": "tsc -p tsconfig.functions.json",
    "deploy": "pnpm run check && node ./scripts/deploy.mjs",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/markdown-remark": "^7.2.0",
    "@astrojs/mdx": "^5.0.6",
    "@astrojs/rss": "^4.0.18",
    "@astrojs/sitemap": "^3.7.3",
    "@astrojs/starlight": "^0.38.3",
    "astro": "^6.1.5",
    "sharp": "^0.34.2",
    "starlight-theme-rapide": "^0.5.2"
  },
  "devDependencies": {
    "github-slugger": "^2.0.0",
    "katex": "^0.16.22",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "typescript": "^5.9.2"
  }
}
