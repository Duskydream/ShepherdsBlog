# build output
dist/
# generated types
.astro/

# tsc 产物（functions/**/*.ts 是源文件，用 `pnpm run build:functions` 重新生成）
functions/**/*.js
functions/**/*.d.ts

# editor settings
.vscode/

# pi coding agent local state
.pi/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# environment variables
.env
.env.production

# macOS-specific files
.DS_Store

# 图片优化脚本下载的原始图缓存（可由 refresh:images 随时重建）
.image-cache/

# 构建/部署产物与临时目录（历史上曾被误提交）
.vercel/
.tmp-screens/
image-backup/

# Obsidian 本地工作区状态（含窗口布局、打开的文件，每台设备都不同）
src/content/docs/.obsidian/workspace.json
src/content/docs/.obsidian/workspace-mobile.json
